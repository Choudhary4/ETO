{% schema %}
{
  "name": "ETO Privacy Policy",
  "settings": [],
  "presets": [{ "name": "ETO Privacy Policy" }]
}
{% endschema %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:wght@400;600&display=swap');

  html, body {
    scroll-behavior: smooth !important;
  }

  #eto-privacy-page {
    background: #f6faff;
    font-family: 'Source Serif 4', serif;
    color: #141d23;
    margin: 0 calc(-50vw + 50%);
    width: 100vw;
    padding: 60px 0;
  }
  .eto-priv-container {
    display: flex;
    max-width: 1440px;
    margin: 0 auto;
    width: 100%;
    padding: 0 20px;
  }
  .eto-priv-sidebar {
    width: 350px;
    flex-shrink: 0;
    position: sticky;
    top: 20px;
    height: calc(100vh - 40px);
    overflow-y: auto;
    padding: 40px 20px;
    border-right: 1px solid rgba(197, 198, 202, 0.4);
    background: #ffffff;
    margin-top: 40px;
    border-radius: 8px;
  }
  .eto-priv-sidebar-header h2 {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #0c1014;
    margin-bottom: 4px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .eto-priv-sidebar-header p {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #44474a;
    margin-bottom: 24px;
  }
  .eto-priv-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .eto-priv-nav-link {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #44474a;
    text-decoration: none;
    padding: 10px 16px;
    border-left: 3px solid transparent;
    transition: all 0.2s ease;
    display: block;
  }
  .eto-priv-nav-link:hover {
    background: #ecf5fe;
    color: #0c1014;
  }
  .eto-priv-nav-link.active {
    border-left-color: #c2b59b;
    background: #ecf5fe;
    color: #c2b59b;
    font-weight: 700;
  }
  .eto-priv-main {
    flex: 1;
    padding: 40px;
    background: rgba(225, 227, 228, 0.1);
  }
  .eto-priv-card {
    max-width: 1050px;
    margin: 0 auto;
    background: #ffffff;
    border-radius: 8px;
    box-shadow: 0 4px 32px rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(197, 198, 202, 0.3);
    padding: 60px;
  }
  .eto-priv-card-header {
    margin-bottom: 50px;
  }
  .eto-priv-card-header h1 {
    font-family: 'Inter', sans-serif;
    font-size: 42px;
    font-weight: 700;
    color: #0c1014;
    position: relative;
    display: inline-block;
    margin-bottom: 16px;
    letter-spacing: -1px;
  }
  .eto-priv-underline {
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 60px;
    height: 4px;
    background: #c2b59b;
    border-radius: 2px;
  }
  .eto-priv-date {
    font-family: 'Source Serif 4', serif;
    font-style: italic;
    color: #75777b;
    font-size: 16px;
    margin-top: 8px;
  }
  .eto-priv-section {
    margin-bottom: 48px;
    scroll-margin-top: 180px;
  }
  .eto-priv-section h2 {
    font-family: 'Inter', sans-serif;
    font-size: 22px;
    font-weight: 600;
    color: #0c1014;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(197, 198, 202, 0.3);
  }
  .eto-priv-section p {
    font-size: 17px;
    line-height: 1.8;
    color: #333;
    margin-bottom: 16px;
  }
  .eto-priv-section ul {
    list-style-type: disc;
    padding-left: 24px;
    margin-bottom: 20px;
  }
  .eto-priv-section li {
    font-size: 16px;
    line-height: 1.8;
    color: #333;
    margin-bottom: 8px;
  }
  .eto-priv-section strong, .eto-priv-section b {
    font-weight: 600;
    color: #111;
  }
  .eto-priv-table {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
    font-size: 15px;
  }
  .eto-priv-table th {
    background: #f6faff;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #44474a;
    padding: 12px 16px;
    text-align: left;
    border-bottom: 2px solid #c2b59b;
  }
  .eto-priv-table td {
    padding: 12px 16px;
    border-bottom: 1px solid rgba(197, 198, 202, 0.3);
    vertical-align: top;
    line-height: 1.6;
    color: #333;
  }
  .eto-priv-table tr:last-child td {
    border-bottom: none;
  }
  @media (max-width: 991px) {
    .eto-priv-sidebar { display: none; }
    .eto-priv-main { padding: 20px; }
    .eto-priv-card { padding: 30px; }
    .eto-priv-table { font-size: 13px; }
  }
</style>

<div id="eto-privacy-page">
  <div class="eto-priv-container">

    <!-- Sidebar -->
    <aside class="eto-priv-sidebar">
      <div class="eto-priv-sidebar-header">
        <h2>Legal Sections</h2>
        <p>Privacy Policy</p>
      </div>
      <nav class="eto-priv-nav">
        <a class="eto-priv-nav-link active" href="#priv-1" onclick="event.preventDefault(); setActive(this); smoothPrivScroll(document.getElementById('priv-1'), 1400);">1. About This Policy</a>
        <a class="eto-priv-nav-link" href="#priv-2" onclick="event.preventDefault(); setActive(this); smoothPrivScroll(document.getElementById('priv-2'), 1400);">2. Personal Information We Collect</a>
        <a class="eto-priv-nav-link" href="#priv-3" onclick="event.preventDefault(); setActive(this); smoothPrivScroll(document.getElementById('priv-3'), 1400);">3. Why We Use Your Information</a>

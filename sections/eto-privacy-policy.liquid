        <a class="eto-priv-nav-link" href="#priv-6" onclick="event.preventDefault(); setActive(this); smoothPrivScroll(document.getElementById('priv-6'), 1400);">6. Cookies and Tracking Technologies</a>
        <a class="eto-priv-nav-link" href="#priv-7" onclick="event.preventDefault(); setActive(this); smoothPrivScroll(document.getElementById('priv-7'), 1400);">7. Email, Phone Calls, and Text Messages</a>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
/* ==========================================================================
   ETO DOORS — PROS Page section
   All rules scoped to .eto-pro
   ========================================================================== */

.eto-pro {
  --ac-font: 'Poppins', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  --ac-ground: #f7f4ef;
  --ac-surface: #ffffff;
  --ac-hairline: #e6dcce;
  --ac-hairline-soft: #ece4d8;
  --ac-ink: #17171a;
  --ac-ink-soft: #5c5c60;
  --ac-ink-muted: #6f6a61;
  --ac-accent: #d2450c;         
  --ac-accent-hover: #ad380a;
  --ac-accent-text: #c63f0a;    
  --ac-accent-text-hover: #a83408;

  --ac-radius: 10px;
  --ac-radius-sm: 8px;
  --ac-maxw: 1240px;
  --ac-gutter: 28px;

  font-family: var(--ac-font);
  background: var(--ac-ground);
  color: var(--ac-ink-soft);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  padding: 52px 0 80px;
}

.eto-pro *,
.eto-pro *::before,
.eto-pro *::after { box-sizing: border-box; }

.eto-pro h1, .eto-pro h2, .eto-pro h3, .eto-pro h4, .eto-pro p, .eto-pro ul, .eto-pro li {
  margin: 0;
  padding: 0;
  font-weight: 400;
}
.eto-pro ul { list-style: none; }
.eto-pro svg, .eto-pro img { display: block; flex: none; }

.eto-pro__inner {
  max-width: var(--ac-maxw);
  margin: 0 auto;
  padding: 0 var(--ac-gutter);
}

.eto-pro__panel {
  border: 1px solid var(--ac-hairline);
  border-radius: var(--ac-radius);
  background: transparent;
}

/* ==========================================================================
   BUTTONS & LINKS
   ========================================================================== */
.eto-pro__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 15px 27px;
  border: 1px solid var(--ac-accent);
  border-radius: 3px;
  background: var(--ac-accent);
  color: #fff;
  font: inherit;
  font-size: 15px;
  font-weight: 600;
  line-height: 1.2;
  text-decoration: none;
  cursor: pointer;
  transition: background-color .16s ease, border-color .16s ease;
}
.eto-pro__btn:hover,
.eto-pro__btn:focus-visible {
  background: var(--ac-accent-hover);
  border-color: var(--ac-accent-hover);
  color: #fff;
}

.eto-pro__textlink {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding-bottom: 4px;
  border-bottom: 1.5px solid var(--ac-accent-text);
  color: var(--ac-accent-text);
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  transition: color .16s ease, border-color .16s ease;
}
.eto-pro__textlink:hover,
.eto-pro__textlink:focus-visible {
  color: var(--ac-accent-text-hover);
  border-color: var(--ac-accent-text-hover);
}
.eto-pro__textlink .eto-pro__chev { transition: transform .16s ease; }
.eto-pro__textlink:hover .eto-pro__chev { transform: translateX(3px); }

/* ==========================================================================
   1. HERO
   ========================================================================== */
.eto-pro__hero {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
  gap: 46px;
  align-items: center;
  margin-bottom: 70px;
}

.eto-pro__eyebrow {
  display: block;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--ac-accent-text);
  margin-bottom: 18px;
}

.eto-pro__title {
  font-size: clamp(34px, 4vw, 48px);
  line-height: 1.13;
  font-weight: 700;
  letter-spacing: -0.015em;
  color: var(--ac-ink);
  max-width: 17em;
  text-wrap: balance;
}

.eto-pro__lede {
  margin-top: 18px;
  font-size: clamp(15px, 1.15vw, 16.5px);
  line-height: 1.62;
  max-width: 32em;
}

.eto-pro__actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14px 30px;
  margin-top: 30px;
}

.eto-pro__meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  margin-top: 26px;
  font-size: 13px;
  color: var(--ac-ink-muted);
}
.eto-pro__meta li + li::before {
  content: '•';
  margin-right: 10px;
  color: var(--ac-hairline);
}

.eto-pro__hero-cards {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.eto-pro__hcard {
  display: flex;
  background: var(--ac-surface);
  border: 1px solid var(--ac-hairline-soft);
  border-radius: var(--ac-radius);
  overflow: hidden;
  align-items: stretch;
}
.eto-pro__hcard-img {
  width: 40%;
  height: auto;
  min-height: 200px;
  background: var(--ac-hairline-soft);
}
.eto-pro__hcard-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.eto-pro__hcard-copy {
  padding: 24px 30px;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.eto-pro__hcard-title {
  font-size: 18px;
  font-weight: 600;
  color: var(--ac-ink);
  line-height: 1.25;
  margin-bottom: 8px;
}
.eto-pro__hcard-desc {
  font-size: 13.5px;
  line-height: 1.55;
  margin-bottom: 16px;
}

/* ==========================================================================
   2. FEATURES
   ========================================================================== */
.eto-pro__section-head { text-align: center; margin-bottom: 30px; }
.eto-pro__section-head--small { margin-bottom: 24px; }

.eto-pro__section-title {
  font-size: clamp(23px, 2.5vw, 31px);
  font-weight: 600;
  line-height: 1.22;
  letter-spacing: -0.01em;
  color: var(--ac-ink);
}
.eto-pro__section-title--small {
  font-size: 21px;
  font-weight: 600;
  color: var(--ac-ink);
}
.eto-pro__section-sub {
  margin-top: 9px;
  font-size: clamp(14px, 1.1vw, 15.5px);
  line-height: 1.55;
}

.eto-pro__features {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border: 1px solid var(--ac-hairline);
  border-radius: var(--ac-radius);
  background: var(--ac-surface);
  margin-bottom: 50px;
  overflow: hidden;
}
.eto-pro__feature-card {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 26px 22px;
  border-right: 1px solid var(--ac-hairline);
}
.eto-pro__feature-card:last-child {
  border-right: none;
}
.eto-pro__feature-card img {
  width: 32px;
  height: 32px;
  object-fit: contain;
  margin-top: 3px;
}
.eto-pro__feature-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--ac-ink);
  line-height: 1.25;
}
.eto-pro__feature-desc {
  margin-top: 4px;
  font-size: 13px;
  line-height: 1.45;
  color: var(--ac-ink-muted);
}

/* ==========================================================================
   3. AUDIENCES
   ========================================================================== */
.eto-pro__audiences {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 16px;
}
.eto-pro__audience-card {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 20px;
  background: var(--ac-surface);
  border: 1px solid var(--ac-hairline);
  border-radius: var(--ac-radius-sm);
}
.eto-pro__audience-card img {
  width: 28px;
  height: 28px;
  object-fit: contain;
}
.eto-pro__audience-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--ac-ink);
}
.eto-pro__audience-note {
  text-align: center;
  font-size: 12.5px;
  color: var(--ac-ink-muted);
  margin-bottom: 60px;
}

/* ==========================================================================
   4. TIMELINE
   ========================================================================== */
.eto-pro__timeline-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  max-width: 800px;
  margin: 0 auto 60px auto;
}
.eto-pro__step {
  display: flex;
  align-items: center;
  gap: 16px;
}
.eto-pro__step-num {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 1px solid var(--ac-hairline);
  background: var(--ac-surface);
  color: var(--ac-ink);
  font-size: 18px;
  font-weight: 600;
}
.eto-pro__step-copy h4 {
  font-size: 15px;
  font-weight: 600;
  color: var(--ac-ink);
  margin-bottom: 2px;
}
.eto-pro__step-copy p {
  font-size: 12.5px;
  color: var(--ac-ink-muted);
  max-width: 140px;
  line-height: 1.4;
}
.eto-pro__step-divider {
  flex: 1;
  height: 1px;
  background: var(--ac-hairline);
  position: relative;
  min-width: 40px;
}
.eto-pro__step-divider::before,
.eto-pro__step-divider::after {
  content: '';
  position: absolute;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--ac-hairline);
  top: -1.5px;
}
.eto-pro__step-divider::before { left: 0; }
.eto-pro__step-divider::after { right: 0; }


/* ==========================================================================
   5. CTA
   ========================================================================== */
.eto-pro__cta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 22px 32px;
  padding: 34px 40px;
  background: #fbf9f6;
  border: 1px solid #dccca3;
  border-radius: var(--ac-radius);
  box-shadow: inset 0 0 0 4px #ffffff;
}
.eto-pro__cta-copy { flex: 1 1 340px; max-width: 560px; }
.eto-pro__cta-actions { flex: 0 0 auto; display: flex; align-items: center; gap: 24px;}
.eto-pro__cta-title {
  font-size: clamp(22px, 2.5vw, 28px);
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: -0.01em;
  color: var(--ac-ink);
}
.eto-pro__cta-sub {
  margin-top: 7px;
  font-size: 14.5px;
  line-height: 1.55;
}

/* ==========================================================================
   6. RESPONSIVE
   ========================================================================== */
@media (max-width: 1040px) {
  .eto-pro__hero { grid-template-columns: 1fr; gap: 40px; }
  .eto-pro__hcard-img { width: 30%; }
  
  .eto-pro__features { grid-template-columns: 1fr 1fr; }
  .eto-pro__feature-card { border-right: none; border-bottom: 1px solid var(--ac-hairline); }
  .eto-pro__feature-card:nth-child(even) { border-left: 1px solid var(--ac-hairline); }
  .eto-pro__feature-card:nth-child(3), .eto-pro__feature-card:nth-child(4) { border-bottom: none; }
  
  .eto-pro__audiences { grid-template-columns: 1fr 1fr; }
  .eto-pro__timeline-wrap { flex-direction: column; align-items: flex-start; gap: 30px; }
  .eto-pro__step-divider { display: none; }
}

@media (max-width: 680px) {
  .eto-pro { padding: 40px 0 50px; }
  .eto-pro__hcard { flex-direction: column; }
  .eto-pro__hcard-img { width: 100%; height: 160px; }
  .eto-pro__hcard-copy { padding: 20px; }
  
  .eto-pro__features { grid-template-columns: 1fr; }
  .eto-pro__feature-card:nth-child(even) { border-left: none; }
  .eto-pro__feature-card:nth-child(3) { border-bottom: 1px solid var(--ac-hairline); }
  
  .eto-pro__audiences { grid-template-columns: 1fr; }
  
  .eto-pro__cta { flex-direction: column; align-items: flex-start; padding: 24px; }
  .eto-pro__cta-actions { flex-direction: column; align-items: flex-start; width: 100%; }
  .eto-pro__cta-actions .eto-pro__btn { width: 100%; }
}

@media (min-width: 1921px) {
  .eto-pro {
    --ac-maxw: 85vw;
    padding: 100px 0 120px;
    min-height: 90vh;
  }
  .eto-pro__title {
    font-size: 64px;
    max-width: 16em;
  }
  .eto-pro__lede {
    font-size: 20px;
    max-width: 40em;
  }
  .eto-pro__hero {
    gap: 120px;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
  }
  .eto-pro__hero-cards {
    max-width: 900px;
    justify-self: start;
  }
  .eto-pro__hcard-copy {
    padding: 34px 40px;
  }
  .eto-pro__hcard-title {
    font-size: 24px;
  }
  .eto-pro__hcard-desc {
    font-size: 16px;
  }
  .eto-pro__feature-card {
    padding: 40px 30px;
  }
  .eto-pro__section-title {
    font-size: 38px;
  }
}
</style>


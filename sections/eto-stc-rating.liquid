          </div>

          <div class="eto-ac__assembly">
            <svg class="eto-ac__assembly-icon" width="54" height="76" viewBox="0 0 54 76"
                 fill="none" stroke="currentColor" stroke-width="1.5"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="5" y="2" width="44" height="72" rx="2"/>
              <rect x="11" y="8" width="32" height="60" rx="1.5" opacity=".4"/>
              <path d="M37 38.5h6"/>
              <circle cx="34.6" cy="38.5" r="1.5" fill="currentColor" stroke="none"/>
              <path d="M5 20h4M5 57h4"/>
            </svg>

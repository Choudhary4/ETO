<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
/* ==========================================================================
   ETO DOORS — Acoustical Performance section
   All rules scoped to .eto-ac
   ========================================================================== */

.eto-ac {
  /* ---- Design tokens ---------------------------------------------------- */
  --ac-font: 'Poppins', 'Helvetica Neue', Helvetica, Arial, sans-serif;

  --ac-ground: #f7f4ef;
  --ac-surface: #ffffff;
  --ac-hairline: #e6dcce;
  --ac-hairline-soft: #ece4d8;

  --ac-ink: #17171a;
  --ac-ink-soft: #5c5c60;
  --ac-ink-muted: #6f6a61;

  --ac-accent: #d2450c;         
  --ac-accent-hover: #ad380a;
  --ac-accent-text: #c63f0a;    
  --ac-accent-text-hover: #a83408;

  --ac-radius: 10px;
  --ac-radius-sm: 8px;
  --ac-maxw: 1240px;
  --ac-gutter: 28px;

  /* ---- Section frame ---------------------------------------------------- */
  font-family: var(--ac-font);
  background: var(--ac-ground);
  color: var(--ac-ink-soft);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  padding: 52px 0 64px;
}

/* Scoped reset — stops inherited theme CSS from bleeding in */
.eto-ac *,
.eto-ac *::before,
.eto-ac *::after { box-sizing: border-box; }

.eto-ac h1, .eto-ac h2, .eto-ac h3, .eto-ac h4, .eto-ac p, .eto-ac ul, .eto-ac li {
  margin: 0;
  padding: 0;
  font-weight: 400;
}
.eto-ac ul { list-style: none; }
.eto-ac svg { display: block; flex: none; }

.eto-ac__inner {
  max-width: var(--ac-maxw);
  margin: 0 auto;
  padding: 0 var(--ac-gutter);
}

.eto-ac__panel {
  border: 1px solid var(--ac-hairline);
  border-radius: var(--ac-radius);
  background: transparent;
}

/* ==========================================================================
   1. HERO
   ========================================================================== */
.eto-ac__hero {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
  gap: 46px;
  align-items: start;
}

.eto-ac__eyebrow {
  display: block;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--ac-accent-text);
  margin-bottom: 18px;
}

.eto-ac__title {
  font-size: clamp(29px, 3.9vw, 46px);
  line-height: 1.13;
  font-weight: 700;
  letter-spacing: -0.015em;
  color: var(--ac-ink);
  max-width: 17em;
  text-wrap: balance;
}

.eto-ac__lede {
  margin-top: 18px;
  font-size: clamp(15px, 1.15vw, 16.5px);
  line-height: 1.62;
  max-width: 33em;
}

.eto-ac__actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14px 30px;
  margin-top: 30px;
}

.eto-ac__meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  margin-top: 26px;
  font-size: 13px;
  color: var(--ac-ink-muted);
}
.eto-ac__meta li + li::before {
  content: '•';
  margin-right: 10px;
  color: var(--ac-hairline);
}

.eto-ac__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 15px 27px;
  border: 1px solid var(--ac-accent);
  border-radius: 3px;
  background: var(--ac-accent);
  color: #fff;
  font: inherit;
  font-size: 15px;
  font-weight: 600;
  line-height: 1.2;
  text-decoration: none;
  cursor: pointer;
  transition: background-color .16s ease, border-color .16s ease;
}
.eto-ac__btn:hover,
.eto-ac__btn:focus-visible {
  background: var(--ac-accent-hover);
  border-color: var(--ac-accent-hover);
  color: #fff;
}

.eto-ac__textlink {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding-bottom: 4px;
  border-bottom: 1.5px solid var(--ac-accent-text);
  color: var(--ac-accent-text);
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  transition: color .16s ease, border-color .16s ease;
}
.eto-ac__textlink:hover,
.eto-ac__textlink:focus-visible {
  color: var(--ac-accent-text-hover);
  border-color: var(--ac-accent-text-hover);
}
.eto-ac__textlink .eto-ac__chev { transition: transform .16s ease; }
.eto-ac__textlink:hover .eto-ac__chev { transform: translateX(3px); }

@media (prefers-reduced-motion: reduce) {
  .eto-ac__btn,
  .eto-ac__textlink,
  .eto-ac__chev { transition: none; }
  .eto-ac__textlink:hover .eto-ac__chev { transform: none; }
}

.eto-ac a:focus-visible,
.eto-ac button:focus-visible {
  outline: 2px solid var(--ac-accent);
  outline-offset: 3px;
}

/* ==========================================================================
   2. TESTED ASSEMBLY RESULTS PANEL
   ========================================================================== */
.eto-ac__results { padding: 26px 26px 20px; }

.eto-ac__results-title {
  font-size: clamp(19px, 1.7vw, 23px);
  font-weight: 600;
  color: var(--ac-ink);
  text-align: center;
  margin-bottom: 20px;
}

.eto-ac__assemblies {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}

.eto-ac__assembly {
  display: flex;
  align-items: center;
  gap: 15px;
  padding: 22px 18px;
  border: 1px solid var(--ac-hairline-soft);
  border-radius: var(--ac-radius-sm);
  background: var(--ac-surface);
}
.eto-ac__assembly-icon { color: var(--ac-ink); height: 82px; width: auto; }

.eto-ac__assembly-name {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.055em;
  text-transform: uppercase;
  color: var(--ac-ink);
}
.eto-ac__stc {
  font-size: clamp(30px, 3vw, 40px);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--ac-ink);
  margin-top: 4px;
}
.eto-ac__oitc {
  font-size: clamp(18px, 1.8vw, 23px);
  font-weight: 500;
  line-height: 1.25;
  color: var(--ac-ink);
}
.eto-ac__testfile {
  margin-top: 9px;
  font-size: 12.5px;
  color: var(--ac-ink-muted);
}

.eto-ac__results-note {
  margin-top: 18px;
  font-size: 12.5px;
  line-height: 1.5;
  text-align: center;
  color: var(--ac-ink-muted);
}

/* ==========================================================================
   3. "WHAT THE RATINGS TELL YOU"
   ========================================================================== */
.eto-ac__explain { margin-top: 56px; }

.eto-ac__section-head { text-align: center; margin-bottom: 26px; }

.eto-ac__section-title {
  font-size: clamp(23px, 2.5vw, 31px);
  font-weight: 600;
  line-height: 1.22;
  letter-spacing: -0.01em;
  color: var(--ac-ink);
}
.eto-ac__section-sub {
  margin-top: 9px;
  font-size: clamp(14px, 1.1vw, 15.5px);
  line-height: 1.55;
}

.eto-ac__cards {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.eto-ac__card {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 22px 20px;
  border: 1px solid var(--ac-hairline);
  border-radius: var(--ac-radius-sm);
}
.eto-ac__card-icon {
  color: var(--ac-ink);
  height: 48px;
  width: auto;
  margin-top: 1px;
}
.eto-ac__card-title {
  font-size: clamp(17px, 1.5vw, 20px);
  font-weight: 600;
  line-height: 1.2;
  color: var(--ac-ink);
}
.eto-ac__card-sub {
  margin-top: 3px;
  font-size: 14px;
  font-weight: 600;
  color: var(--ac-ink);
}
.eto-ac__card-body {
  margin-top: 8px;
  font-size: 13.8px;
  line-height: 1.55;
}

/* ==========================================================================
   4. REPORT DETAILS STRIP
   ========================================================================== */
.eto-ac__report {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  margin-top: 20px;
}

.eto-ac__report-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  padding: 22px 14px;
  text-align: center;
}
.eto-ac__report-cell + .eto-ac__report-cell {
  border-left: 1px solid var(--ac-hairline);
}
.eto-ac__report-value {
  font-size: clamp(14px, 1.25vw, 16.5px);
  font-weight: 600;
  line-height: 1.3;
  color: var(--ac-ink);
}
.eto-ac__report-label {
  font-size: 12.5px;
  line-height: 1.4;
  color: var(--ac-ink-muted);
}

/* ==========================================================================
   5. CLOSING CTA BAR
   ========================================================================== */
.eto-ac__cta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 22px 32px;
  margin-top: 20px;
  padding: 26px 28px;
}
.eto-ac__cta-copy { flex: 1 1 340px; max-width: 560px; }
.eto-ac__cta-actions { flex: 0 0 auto; }
.eto-ac__cta-title {
  font-size: clamp(19px, 1.9vw, 24px);
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: -0.01em;
  color: var(--ac-ink);
}
.eto-ac__cta-sub {
  margin-top: 7px;
  font-size: 14.5px;
  line-height: 1.55;
}
.eto-ac__cta-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14px 26px;
}

/* ==========================================================================
   6. RESPONSIVE
   ========================================================================== */

@media (max-width: 1040px) {
  .eto-ac { padding: 44px 0 54px; }
  .eto-ac__hero {
    grid-template-columns: minmax(0, 1fr);
    gap: 34px;
  }
  .eto-ac__title { max-width: 22em; }
  .eto-ac__lede { max-width: 46em; }
  .eto-ac__explain { margin-top: 52px; }
}

@media (max-width: 900px) {
  .eto-ac__cards { grid-template-columns: minmax(0, 1fr); }
  .eto-ac__report { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .eto-ac__report-cell + .eto-ac__report-cell { border-left: 0; }
  .eto-ac__report-cell:nth-child(even) { border-left: 1px solid var(--ac-hairline); }
  .eto-ac__report-cell:nth-child(n + 3) { border-top: 1px solid var(--ac-hairline); }
  .eto-ac__report-cell:last-child:nth-child(odd) { grid-column: 1 / -1; }
}

@media (max-width: 680px) {
  .eto-ac {
    --ac-gutter: 20px;
    padding: 36px 0 46px;
  }
  .eto-ac__results { padding: 20px 18px 16px; }
  .eto-ac__assemblies { grid-template-columns: minmax(0, 1fr); }

  .eto-ac__actions { gap: 16px 22px; }
  .eto-ac__btn { width: 100%; }
  .eto-ac__cta { padding: 22px 20px; }
  .eto-ac__cta-copy { flex: 1 1 100%; max-width: none; }
  .eto-ac__cta-actions { flex: 1 1 100%; }
  .eto-ac__cta-actions .eto-ac__btn { width: auto; flex: 1 1 220px; }
}

@media (max-width: 460px) {
  .eto-ac__report { grid-template-columns: minmax(0, 1fr); }
  .eto-ac__report-cell:nth-child(even) { border-left: 0; }
  .eto-ac__report-cell + .eto-ac__report-cell { border-top: 1px solid var(--ac-hairline); }
  .eto-ac__report-cell { padding: 16px 14px; }

  .eto-ac__assembly { gap: 14px; padding: 18px 16px; }
  .eto-ac__btn { padding: 14px 20px; }
}
</style>

<section class="eto-ac" aria-labelledby="ac-title">
  <div class="eto-ac__inner">
    <!-- ---------- 1. Hero ---------- -->
    <div class="eto-ac__hero">


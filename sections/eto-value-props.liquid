<style>
.eto-value-props-section {
  background: #fbfaf9; /* Slightly off-white for a clean separation */
  border-top: 1px solid var(--eto-light-border);
  border-bottom: 1px solid var(--eto-light-border);
  padding: 64px var(--eto-margin-edge); /* Increased padding for better breathing room */
}
.eto-value-props-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 48px; /* Increased gap for elegance */
  max-width: var(--eto-container-max);
  margin: 0 auto;
}
.eto-vp-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 16px;
}
.eto-vp-icon-wrap {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--eto-dark-charcoal);
  transition: transform 0.4s cubic-bezier(0.2, 0, 0.2, 1), color 0.4s ease;
}
.eto-vp-item:hover .eto-vp-icon-wrap {
  transform: translateY(-5px);
  color: #c1a076; /* Gold color on hover */
}
.eto-vp-icon-wrap svg {
  width: 100%;
  height: 100%;
}
.eto-vp-title {
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.2em; /* More spaced out for luxury feel */
  text-transform: uppercase;
  color: var(--eto-dark-charcoal);
  margin: 0;
}
.eto-vp-text {
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: 11px;
  color: #666; /* Slightly darker for better readability */
  max-width: 180px; /* Slightly wider text area */
  margin: 0;
  line-height: 1.6;
}

/* Custom SVG Animations */
.eto-custom-animated-icon {
  display: block;
  overflow: visible;
}
.eto-anim-draw {
  stroke-dasharray: 100;
  stroke-dashoffset: 100;
  animation: etoDraw 3s ease-in-out infinite alternate;
}
.eto-anim-pulse-slow {
  animation: etoPulse 2s ease-in-out infinite alternate;
}
.eto-anim-pulse {
  animation: etoPulse 1s ease-in-out infinite alternate;
  transform-origin: center;
}
.eto-anim-slide-right {
  animation: etoSlide 2s ease-in-out infinite alternate;
  transform: translateX(-2px);
}
.eto-anim-lock-bounce {
  animation: etoLock 2s ease-in-out infinite alternate;
  transform-origin: bottom center;
}

@keyframes etoDraw {
  0% { stroke-dashoffset: 100; }
  100% { stroke-dashoffset: 0; }
}
@keyframes etoPulse {
  0% { opacity: 0.5; transform: scale(0.9); }
  100% { opacity: 1; transform: scale(1.1); }
}
@keyframes etoSlide {
  0% { transform: translateX(-2px); opacity: 0.5; }
  100% { transform: translateX(2px); opacity: 1; }
}
@keyframes etoLock {
  0% { transform: translateY(0px); }
  50% { transform: translateY(-3px); }
  100% { transform: translateY(0px); }
}

@media (max-width: 990px) {
  .eto-value-props-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}
@media (max-width: 500px) {
  .eto-value-props-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
</style>


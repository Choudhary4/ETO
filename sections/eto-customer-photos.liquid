</div>

<style>
  .eto-customer-photos-page {
    font-family: sans-serif;
    color: #333;
  }
  
  .eto-photos-breadcrumb {
    font-size: 12px;
    padding: 15px 20px;
    max-width: var(--eto-container-max);
    margin: 0 auto;
  }
  
  .eto-photos-breadcrumb a {
    color: #333;
    text-decoration: none;
  }
  
  .eto-photos-wrapper {
    display: flex;
    max-width: var(--eto-container-max);
    margin: 0 auto;
    padding: 0 20px 40px;
    gap: 30px;
  }
  
  .eto-photos-main {
    flex: 1;
  }
  
  .eto-photos-header h1 {
    font-size: 20px;
    font-weight: normal;
    margin: 0 0 15px;
    color: #333;
  }
  
  .eto-photos-intro {
    font-size: 12px;
    line-height: 1.6;
    margin-bottom: 20px;
  }
  
  .eto-photos-intro a {
    color: #4a7c4e;
  }
  
  .eto-photos-gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  
  .eto-photo-link {
    display: block;
  }
  
  .eto-photo-link img {
    width: 100px;
    height: 100px;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s;
  }
  
  .eto-photo-link:hover img {
    opacity: 0.8;
  }
  
  /* Lightbox Styles */
  .eto-lightbox {
    display: none;
    position: fixed;
    z-index: 9999;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.9);
    justify-content: center;
    align-items: center;
  }
  
  .eto-lightbox.active {
    display: flex;
  }
  
  .eto-lightbox-img {
    max-width: 90%;
    max-height: 90%;
    object-fit: contain;
  }
  
  .eto-lightbox-close {
    position: absolute;
    top: 20px;
    right: 30px;
    color: #fff;
    font-size: 40px;
    cursor: pointer;
  }
  
  .eto-lightbox-prev,
  .eto-lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    color: #fff;
    font-size: 30px;
    cursor: pointer;
    padding: 10px 15px;
    user-select: none;
  }
  
  .eto-lightbox-prev {
    left: 20px;
  }
  
  .eto-lightbox-next {
    right: 20px;
  }
  
  .eto-lightbox-prev:hover,
  .eto-lightbox-next:hover,
  .eto-lightbox-close:hover {
    color: #ccc;
  }
  
  @media (max-width: 768px) {
    .eto-photos-wrapper {
      flex-direction: column;
    }
    
    .eto-photo-link img {
      width: 80px;
      height: 80px;
    }
  }

  @media screen and (min-width: 1921px) {
    .eto-photos-wrapper, .eto-photos-breadcrumb { max-width: 85vw !important; padding-left: 2vw !important; padding-right: 2vw !important; }
    .eto-photos-breadcrumb { font-size: clamp(12px, 1.2vw, 24px) !important; }
    .eto-photos-header h1 { font-size: clamp(20px, 2vw, 40px) !important; }
    .eto-photos-intro { font-size: clamp(12px, 1.2vw, 24px) !important; }
    .eto-photo-link img { width: clamp(100px, 10vw, 200px) !important; height: clamp(100px, 10vw, 200px) !important; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var lightbox = document.getElementById('eto-lightbox');
    var lightboxImg = lightbox.querySelector('.eto-lightbox-img');
    var closeBtn = lightbox.querySelector('.eto-lightbox-close');
    var prevBtn = lightbox.querySelector('.eto-lightbox-prev');
    var nextBtn = lightbox.querySelector('.eto-lightbox-next');
    var photoLinks = document.querySelectorAll('.eto-photo-link');
    var currentIndex = 0;
    
    var images = Array.from(photoLinks).map(function(link) {
      return link.href;
    });
    
    photoLinks.forEach(function(link, index) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        currentIndex = index;
        showImage(currentIndex);
        lightbox.classList.add('active');
      });
    });
    
    closeBtn.addEventListener('click', function() {
      lightbox.classList.remove('active');
    });
    
    lightbox.addEventListener('click', function(e) {
      if (e.target === lightbox) {
        lightbox.classList.remove('active');
      }
    });
    
    prevBtn.addEventListener('click', function() {
      currentIndex = (currentIndex - 1 + images.length) % images.length;
      showImage(currentIndex);
    });
    
    nextBtn.addEventListener('click', function() {
      currentIndex = (currentIndex + 1) % images.length;
      showImage(currentIndex);
    });
    
    document.addEventListener('keydown', function(e) {
      if (!lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') lightbox.classList.remove('active');
      if (e.key === 'ArrowLeft') prevBtn.click();
      if (e.key === 'ArrowRight') nextBtn.click();
    });
    
    function showImage(index) {
      lightboxImg.src = images[index];
    }
  });
</script>


{% comment %}
  ETO Doors - Custom Contact Page Section
  Redesigned based on mockup
{% endcomment %}

{{ 'component-door-categories.css' | asset_url | stylesheet_tag }}

<style>
  html {
    scroll-padding-top: 180px; /* Fixes browser scrolling elements under sticky header */
  }
  :root {
    --eto-red: #DE3C1E;
    --eto-dark: #111111;
    --eto-gray-light: #F7F5F2; /* Page bg matches mockup */
    --eto-border: #E5E5E5;
    --eto-text: #4A4A4A;
  }

  .eto-contact-page-wrapper {
    background-color: var(--eto-gray-light);
    padding: 20px;
    font-family: 'Inter', sans-serif; /* Fallback if not loaded */
    position: relative;
    z-index: 1;
  }

  .eto-contact-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  /* --- Top Section --- */
  .eto-contact-top {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    justify-content: space-between;
    margin-bottom: 30px;
  }

  .eto-contact-intro {
    flex: 1;
    min-width: 300px;
    max-width: 600px;
  }

  .eto-contact-pretitle {
    color: var(--eto-red);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    display: block;
    margin-bottom: 10px;
  }

  .eto-contact-main-title {
    font-size: 48px;
    font-weight: 800;
    line-height: 1.1;
    color: var(--eto-dark);
    margin: 0 0 10px 0;
    letter-spacing: -1px;
  }

  .eto-contact-desc {
    font-size: 16px;
    color: var(--eto-text);
    line-height: 1.5;
    margin-bottom: 15px;
  }

  .eto-contact-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 15px;
    flex-wrap: wrap;
  }

  .eto-btn-primary-red {
    background-color: var(--eto-red);
    color: #fff;
    padding: 12px 24px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 4px;
    text-decoration: none;
    transition: background-color 0.2s;
    border: none;
    cursor: pointer;
    display: inline-block;
  }

  .eto-btn-primary-red:hover {
    background-color: #C03015;
    color: #fff;
  }

  .eto-contact-call-link {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--eto-dark);
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    border-bottom: 2px solid var(--eto-red);
    padding-bottom: 2px;
  }

  .eto-contact-hours {
    font-size: 12px;
    color: #666;
    margin: 0;
  }

  .eto-contact-ways {
    flex: 0 0 350px;
    background: #FAF9F7;
    border: 1px solid var(--eto-border);
    border-radius: 8px;
    padding: 0;
  }

  .eto-contact-ways h3 {
    font-size: 18px;
    font-weight: 700;
    margin: 0;
    padding: 5px 20px;
    border-bottom: 1px solid var(--eto-border);
  }

  .eto-way-item {
    display: flex;
    padding: 5px 20px;
    border-bottom: 1px solid var(--eto-border);
    gap: 15px;
  }

  .eto-way-item:last-child {
    border-bottom: none;
  }

  .eto-way-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .eto-way-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .eto-way-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--eto-text);
  }

  .eto-way-value {
    font-size: 14px;
    font-weight: 700;
    color: var(--eto-dark);
  }

  .eto-way-link {
    font-size: 13px;
    font-weight: 600;
    color: var(--eto-red);
    text-decoration: underline;
    margin-top: 5px;
  }

  /* --- Form Section --- */
  .eto-contact-form-section {
    margin-bottom: 30px;
  }

  .eto-contact-form-header {
    text-align: center;
    margin-bottom: 15px;
  }

  .eto-contact-form-header h2 {
    font-size: 28px;
    font-weight: 700;
    color: var(--eto-dark);
    margin: 0 0 10px 0;
  }

  .eto-contact-form-header p {
    font-size: 15px;
    color: var(--eto-text);
    margin: 0;
  }

  .eto-contact-form-box {
    background: #FAF9F7;
    border: 1px solid var(--eto-border);
    border-radius: 8px;
    overflow: hidden;
  }

  .eto-contact-tabs {
    display: flex;
    border-bottom: 1px solid var(--eto-border);
    background: #FAF9F7;
  }

  .eto-tab {
    flex: 1;
    text-align: center;
    padding: 15px 10px;
    font-size: 13px;
    font-weight: 600;
    color: var(--eto-text);
    cursor: pointer;
    border-right: 1px solid var(--eto-border);
    border-bottom: 2px solid transparent;
  }
  .eto-tab:last-child {
    border-right: none;
  }

  .eto-tab.active {
    color: var(--eto-dark);
    border-bottom-color: var(--eto-red);
  }

  .eto-form-inner {
    padding: 20px;
    background: #FAF9F7;
  }

  .eto-contact-title-bar {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 20px;
    color: var(--eto-dark);
  }

  .eto-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-bottom: 15px;
  }

  .eto-input-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .eto-input-group.full-width {
    grid-column: 1 / -1;
  }

  .eto-input-group label {
    font-size: 12px;
    font-weight: 700;
    color: var(--eto-dark);
  }
  
  .eto-input-group label .req {
    color: var(--eto-red);
  }

  .eto-input-group input,
  .eto-input-group select,
  .eto-input-group textarea {
    scroll-margin-top: 160px; /* Fixes browser scrolling inputs under the sticky header on validation */
    padding: 10px;
    border: 1px solid #D1D1D1;
    border-radius: 4px;
    font-size: 14px;
    font-family: inherit;
    background: #FFFFFF;
  }

  .eto-input-group input:focus,
  .eto-input-group select:focus,
  .eto-input-group textarea:focus {
    outline: none;
    border-color: var(--eto-dark);
  }

  .eto-upload-box {
    border: 1px solid #D1D1D1;
    border-radius: 4px;
    padding: 15px;
    background: #FAF9F7;
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
    font-size: 13px;
    color: var(--eto-text);
    position: relative;
    cursor: pointer;
  }

  .eto-upload-box:hover {
    background: #F0EFEA;
  }

  .eto-upload-box input[type="file"] {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  .eto-upload-icon {
    width: 20px;
    height: 20px;
    color: var(--eto-dark);
  }

  .eto-checkbox-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 30px;
  }

  .eto-checkbox-row input {
    margin-top: 3px;
    width: 16px; height: 16px;
  }

  .eto-checkbox-row label {
    font-size: 12px;
    color: var(--eto-text);
    line-height: 1.5;
  }

  .eto-form-footer {
    display: flex;
    align-items: center;
    gap: 30px;
    flex-wrap: wrap;
  }

  .eto-recaptcha-mock {
    border: 1px solid #D1D1D1;
    background: #F9F9F9;
    padding: 10px 15px;
    border-radius: 3px;
    display: flex;
    align-items: center;
    gap: 15px;
    height: 74px;
    width: 300px;
  }

  /* --- Headquarters Section --- */
  .eto-hq-section {
    text-align: center;
  }

  .eto-hq-section h3 {
    font-size: 20px;
    font-weight: 700;
    color: var(--eto-dark);
    margin: 0 0 5px 0;
  }

  .eto-hq-section p.hq-subtitle {
    font-size: 14px;
    color: var(--eto-text);
    margin: 0 0 30px 0;
  }

  .eto-hq-card {
    display: flex;
    background: #FAF9F7;
    border: 1px solid var(--eto-border);
    border-radius: 8px;
    overflow: hidden;
    text-align: left;
    flex-wrap: wrap;
  }

  .eto-hq-info {
    flex: 1;
    min-width: 300px;
    padding: 25px;
  }

  .eto-hq-info-row {
    display: flex;
    gap: 15px;
    margin-bottom: 25px;
  }

  .eto-hq-info-row:last-child { margin-bottom: 0; }

  .eto-hq-info-icon {
    width: 24px;
    height: 24px;
    margin-top: 2px;
  }

  .eto-hq-info-text strong {
    display: block;
    font-size: 14px;
    font-weight: 700;
    color: var(--eto-dark);
  }

  .eto-hq-info-text span {
    display: block;
    font-size: 13px;
    color: var(--eto-text);
    margin-top: 3px;
    line-height: 1.4;
  }

  .eto-hq-map {
    flex: 1;
    min-width: 300px;
    min-height: 300px;
    background: #E5E5E5;
    position: relative;
  }
  
  .eto-hq-map iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .eto-hq-actions {
    display: flex;
    gap: 20px;
    align-items: center;
    margin-top: 30px;
  }
  
  /* Success Message Styling */
  .eto-success-box {
    background: #fff;
    border: 1px solid #28a745;
    padding: 30px;
    border-radius: 8px;
    margin-bottom: 30px;
  }
  .eto-success-box h3 { color: #28a745; margin-top: 0; }

  @media (max-width: 768px) {
    .eto-contact-main-title { font-size: 36px; }
    .eto-form-grid { grid-template-columns: 1fr; }
    .eto-contact-tabs { overflow-x: auto; white-space: nowrap; }
    .eto-contact-ways { flex: 100%; }
    .eto-hq-info { padding: 20px; }
  }
</style>

<div class="eto-contact-page-wrapper">
  <div class="eto-contact-container">
    
    <!-- Top Section -->
    <div class="eto-contact-top">
      <div class="eto-contact-intro">
        <span class="eto-contact-pretitle">CONTACT ETO DOORS</span>
        <h1 class="eto-contact-main-title">Expert help for your<br>next door project.</h1>
        <p class="eto-contact-desc">Tell us what you're looking for. Our team can help with product selection, pricing, sizing, customization, and order support.</p>
        <div class="eto-contact-actions">
          <a href="#ContactFormWrapper" class="eto-btn-primary-red">Start Your Request</a>
          <a href="tel:2136222003" class="eto-contact-call-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            Call (213) 622-2003
          </a>
        </div>
        <p class="eto-contact-hours">Monday-Friday, 8:00 AM-5:00 PM PST</p>
      </div>
      
      <div class="eto-contact-ways">
        <h3>Ways to reach us</h3>
        <div class="eto-way-item">
          <div class="eto-way-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          </div>
          <div class="eto-way-text">
            <span class="eto-way-label">Call our team</span>
            <span class="eto-way-value">(213) 622-2003</span>
          </div>
        </div>
        <div class="eto-way-item">
          <div class="eto-way-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </div>
          <div class="eto-way-text">
            <span class="eto-way-label">Email us</span>
            <span class="eto-way-value">contact@etodoors.com</span>
          </div>
        </div>
        <div class="eto-way-item">
          <div class="eto-way-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          </div>
          <div class="eto-way-text">
            <span class="eto-way-label">Visit our showroom</span>
            <span class="eto-way-value" style="font-weight: 500;">1340 E. 6th Street<br>Los Angeles, CA 90021</span>
            <a href="https://maps.google.com/?q=1340+E.+6th+Street+Los+Angeles,+CA+90021" target="_blank" class="eto-way-link">Get Directions</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Form Section -->
    <div class="eto-contact-form-section" id="ContactFormWrapper">
      <div class="eto-contact-form-header">
        <h2>How can we help?</h2>
        <p>Share a few details and we'll route your request to the right person.</p>
      </div>

      <div class="eto-contact-form-box">
        <div class="eto-contact-tabs">
          <div class="eto-tab active" data-target="New Quote">New Quote</div>
          <div class="eto-tab" data-target="Existing Quote">Existing Quote</div>
          <a href="/account" class="eto-tab" style="text-decoration:none; display:flex; align-items:center; justify-content:center;">Existing Order</a>
          <a href="/pages/file-a-claim" class="eto-tab" style="text-decoration:none; display:flex; align-items:center; justify-content:center;">Product Support</a>
        </div>
        
        <div class="eto-form-inner">
          <div class="eto-contact-title-bar">Contact & quote request</div>

          {%- form 'contact', id: 'ContactForm' -%}
            
            {%- if form.posted_successfully? -%}
              <div class="eto-success-box">
                <h3>Your request has been sent successfully!</h3>
                <p>An experienced team member will review your request and contact you shortly. Typically we respond within one business day.</p>
              </div>
              <style>
                .eto-form-grid, .eto-upload-box, .eto-checkbox-row, .eto-form-footer, .eto-contact-tabs, .eto-contact-title-bar { display: none; }
              </style>
            {%- elsif form.errors -%}
              <div style="color: red; margin-bottom: 20px; font-size: 14px;">
                {{ 'templates.contact.form.error_heading' | t }}<br>
                {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
              </div>
            {%- endif -%}

            <input type="hidden" name="contact[Inquiry Type]" id="input_inquiry_type" value="New Quote">
            <!-- Hidden tracking fields -->
            <input type="hidden" name="contact[Product Name]" id="input_product_name">
            <input type="hidden" name="contact[Product URL]" id="input_product_url">
            <input type="hidden" name="contact[UTM Source]" id="input_utm_source">
            
            <div class="eto-form-grid">
              <div class="eto-input-group">
                <label>First Name <span class="req">*</span></label>
                <input type="text" name="contact[First Name]" placeholder="First name" required>
              </div>
              <div class="eto-input-group">
                <label>Last Name <span class="req">*</span></label>
                <input type="text" name="contact[Last Name]" placeholder="Last name" required>
              </div>
              <div class="eto-input-group full-width">
                <label>Company Name</label>
                <input type="text" name="contact[Company Name]" placeholder="Company or business">
              </div>
              <div class="eto-input-group">
                <label>Email <span class="req">*</span></label>
                <input type="email" name="contact[email]" placeholder="name@email.com" required>
              </div>
              <div class="eto-input-group">
                <label>Phone <span class="req">*</span></label>
                <input type="tel" name="contact[Phone]" placeholder="(213) 622-2003" required>
              </div>
              <div class="eto-input-group">
                <label>Shipping ZIP <span class="req">*</span></label>
                <input type="text" name="contact[Shipping ZIP]" placeholder="5-digit ZIP code" required maxlength="5" pattern="[0-9]{5}">
              </div>
              <div class="eto-input-group">
                <label>Project Type</label>
                <select name="contact[Project Type]">
                  <option value="" disabled selected>Select project type</option>
                  <option value="Residential">Residential</option>
                  <option value="Commercial">Commercial</option>
                  <option value="Hospitality">Hospitality</option>
                  <option value="Other">Other</option>
                </select>
              </div>
              <div class="eto-input-group full-width">
                <label>How can we help? <span class="req">*</span></label>
                <textarea name="contact[body]" rows="4" placeholder="Tell us about the doors, quantities, sizes, timeline, or questions." required></textarea>
              </div>
            </div>

            <!-- Fake upload box for UI consistency, Shopify native forms don't handle files without apps -->
            <div class="eto-upload-box">
              <svg class="eto-upload-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg>
              <div>
                <strong>Attach photos, plans, or specifications (optional)</strong><br>
                <span>PDF, JPG, or PNG</span>
              </div>
              <input type="file" name="contact[Attachment]" accept=".pdf,.jpg,.jpeg,.png">
            </div>

            <div class="eto-checkbox-row">
              <input type="checkbox" name="contact[SMS Consent]" id="smsConsent" required>
              <label for="smsConsent">I agree to receive text messages about my inquiry. Consent is not a condition of purchase. Message and data rates may apply. Reply STOP to opt out.</label>
            </div>

            <div class="eto-form-footer">
              <button type="submit" class="eto-btn-primary-red">Submit Request</button>
              
              <!-- Recaptcha mock/placeholder -->
              <div class="eto-recaptcha-mock">
                <input type="checkbox" style="width:24px; height:24px;">
                <span style="font-size:14px; color:#333; font-weight:500;">I'm not a robot</span>
                <img src="https://www.gstatic.com/recaptcha/api2/logo_48.png" width="32" height="32" style="margin-left:auto;">
              </div>
            </div>

          {%- endform -%}
        </div>
      </div>
    </div>

    <!-- Headquarters Section -->
    <div class="eto-hq-section">
      <h3>ETO Doors Corporate Headquarters</h3>
      <p class="hq-subtitle">Visit our Los Angeles showroom or contact our team during business hours.</p>
      
      <div class="eto-hq-card">
        <div class="eto-hq-info">
          
          <div class="eto-hq-info-row">
            <svg class="eto-hq-info-icon" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <div class="eto-hq-info-text">
              <strong>1340 E. 6th Street</strong>
              <span>Los Angeles, CA 90021</span>
            </div>
          </div>
          
          <div class="eto-hq-info-row">
            <svg class="eto-hq-info-icon" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <div class="eto-hq-info-text">
              <strong>Monday-Friday</strong>
              <span>8:00 AM-5:00 PM PST</span>
            </div>
          </div>
          
          <div class="eto-hq-info-row">
            <svg class="eto-hq-info-icon" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <div class="eto-hq-info-text">
              <strong>contact@etodoors.com</strong>
            </div>
          </div>

          <div class="eto-hq-actions">
            <a href="https://maps.google.com/?q=1340+E.+6th+Street+Los+Angeles,+CA+90021" target="_blank" class="eto-btn-primary-red">Get Directions</a>
            <a href="tel:2136222003" class="eto-contact-call-link">Call the Showroom</a>
          </div>

        </div>
        <div class="eto-hq-map">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3306.014299407386!2d-118.23933908478546!3d34.0435349806085!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80c2c63a61055555%3A0x6283733076596160!2s1340%20E%206th%20St%2C%20Los%20Angeles%2C%20CA%2090021!5e0!3m2!1sen!2sus!4v1620000000000!5m2!1sen!2sus" 
            allowfullscreen="" 
            loading="lazy">
          </iframe>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Tab switching logic
    const tabs = document.querySelectorAll('.eto-tab');
    const typeInput = document.getElementById('input_inquiry_type');
    
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        if(typeInput) {
          typeInput.value = tab.getAttribute('data-target');
        }
      });
    });

    // Populate URL params
    const params = new URLSearchParams(window.location.search);
    if(params.has('product_name') && document.getElementById('input_product_name')) {
      document.getElementById('input_product_name').value = params.get('product_name');
    }
    if(params.has('product_url') && document.getElementById('input_product_url')) {
      document.getElementById('input_product_url').value = params.get('product_url');
    }
  });
</script>


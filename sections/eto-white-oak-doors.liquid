<style>
@font-face {
  font-family: 'MADE Mirage';
  src: url('{{ "made-mirage-regular.otf" | asset_url }}') format('opentype');
  font-weight: normal;
  font-style: normal;
}

.eto-white-oak-section {
  width: 100%;
  max-width: 100%;
  margin: 0 auto;
  aspect-ratio: 1440 / 805;
  background-image: url('{{ "white-oak-banner.svg" | asset_url }}');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  position: relative;
  display: flex;
  justify-content: center;
  cursor: pointer;
}

.eto-white-oak-inner {
  width: 100%;
  text-align: center;
  padding-top: 20px; /* Space from top of the image to the title */
}

.eto-white-oak-title {
  font-family: 'MADE Mirage', serif;
  font-size: 48px;
  line-height: 48px;
  font-weight: 400;
  color: var(--eto-dark-charcoal);
  letter-spacing: normal;
  margin: 0;
  text-transform: uppercase;
}

.eto-wo-vp-grid {
  position: absolute;
  bottom: 12%;
  left: 0;
  width: 100%;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 20px;
  max-width: var(--eto-container-max);
  margin: 0 auto;
  left: 50%;
  transform: translateX(-50%);
  padding: 0 var(--eto-margin-edge);
}
.eto-wo-vp-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.eto-wo-vp-icon {
  width: 32px;
  height: 32px;
  color: #9B8C83; /* Matching Figma fill */
  margin-bottom: 12px;
}
.eto-wo-vp-icon svg {
  width: 100%;
  height: 100%;
}
.eto-wo-vp-title {
  font-family: 'Montserrat', sans-serif;
  font-size: 15px;
  font-weight: 700;
  color: #9B8C83;
  margin: 0 0 4px 0;
  letter-spacing: normal;
  line-height: 20px;
}
.eto-wo-vp-text {
  font-family: 'Montserrat', sans-serif;
  font-size: 15px;
  font-weight: 400;
  color: #9B8C83;
  margin: 0;
  line-height: 20px;
}

@media (min-width: 1921px) {
  .eto-white-oak-section {
    max-width: 100%;
  }
  .eto-white-oak-inner {
    padding-top: clamp(30px, 3vw, 80px);
  }
  .eto-white-oak-title {
    font-size: clamp(44px, 3vw, 85px);
    line-height: 1.2;
  }
  .eto-wo-vp-grid {
    max-width: 100% !important;
    padding: 0 10vw !important;
    gap: 2vw;
  }
  .eto-wo-vp-icon {
    width: clamp(32px, 2vw, 48px);
    height: clamp(32px, 2vw, 48px);
    margin-bottom: clamp(12px, 1vw, 20px);
  }
  .eto-wo-vp-title {
    font-size: clamp(16px, 1.1vw, 24px);
    line-height: 1.2;
  }
  .eto-wo-vp-text {
    font-size: clamp(15px, 0.8vw, 18px);
    line-height: 1.3;
  }
}

.eto-white-oak-mobile-img-wrap { display: none; }

@media (max-width: 1300px) {
  .eto-white-oak-title { font-size: 36px; padding-top: 15px; }
  .eto-wo-vp-title { font-size: 12px; line-height: 1.2; }
  .eto-wo-vp-text { font-size: 11px; line-height: 1.2; }
  .eto-wo-vp-icon { width: 26px; height: 26px; margin-bottom: 8px; }
  .eto-wo-vp-grid { bottom: 12%; gap: 10px; }
}

@media (max-width: 1100px) {
  .eto-white-oak-title { font-size: 32px; padding-top: 10px; }
  .eto-wo-vp-title { font-size: 10px; }
  .eto-wo-vp-text { font-size: 9px; }
  .eto-wo-vp-icon { width: 22px; height: 22px; margin-bottom: 6px; }
  .eto-wo-vp-grid { bottom: 10%; gap: 5px; }
}

@media (max-width: 990px) {
  .eto-white-oak-section {
    background-image: none !important;
    background-color: #E8E4DF;
    aspect-ratio: auto;
    min-height: auto;
    padding-bottom: 0;
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .eto-white-oak-inner {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1;
    margin-bottom: 0;
  }
  .eto-white-oak-mobile-img-wrap {
    display: block;
    width: 100%;
    overflow: hidden;
    margin-top: 0;
    margin-bottom: 0;
  }
  .eto-white-oak-mobile-img {
    display: block;
    width: 180%;
    max-width: none;
    margin-left: -40%;
  }
  .eto-white-oak-title {
    font-size: 36px;
    padding-top: 10px;
  }
  .eto-wo-vp-grid {
    position: relative;
    bottom: auto;
    left: 0;
    transform: none;
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px 10px;
    margin-top: -120px; /* Pull UP heavily to remove the gap under doors */
    padding: 0px 10px 30px 10px;
    background-color: #E8E4DF;
    z-index: 2;
    box-shadow: 0 -20px 20px #E8E4DF; /* increased shadow slightly to blend better */
  }
  .eto-wo-vp-item {
    flex: 0 0 30%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .eto-wo-vp-icon {
    width: 24px;
    height: 24px;
    margin-bottom: 6px;
  }
  .eto-wo-vp-title {
    font-size: 11px;
    line-height: 1.2;
    margin-bottom: 2px;
  }
  .eto-wo-vp-text {
    font-size: 10px;
    line-height: 1.2;
  }
}
@media (max-width: 768px) {
  .eto-white-oak-mobile-img {
    width: 220%;
    margin-left: -60%;
  }
  .eto-white-oak-title {
    font-size: 28px;
    padding-top: 8px;
  }
}
@media (max-width: 500px) {
  .eto-white-oak-mobile-img {
    width: 280%;
    margin-left: -90%;
  }
  .eto-white-oak-title {
    font-size: 24px;
    padding-top: 5px;
  }
  .eto-wo-vp-grid {
    gap: 5px;
    bottom: 10px;
  }
}
</style>


  }
  
  .eto-form-group input[type="text"],
  .eto-form-group input[type="email"],
  .eto-form-group input[type="tel"],
  .eto-form-group input[type="number"],
  .eto-form-group select,
  .eto-form-group textarea {
    width: 100%;
    max-width: 400px;
    padding: 8px;

{{ 'component-door-categories.css' | asset_url | stylesheet_tag }}

<style>
  html {
    scroll-padding-top: 180px;
  }
  :root {
    --eto-red: #DE3C1E;
    --eto-dark: #111111;
    --eto-gray-light: #FAF9F7;
    --eto-border: #E5E5E5;
    --eto-text: #4A4A4A;
    --eto-form-bg: #FFFFFF;
  }
  
  .eto-claim-page-wrapper {
    background-color: var(--eto-gray-light);
    padding: 40px 20px;
    font-family: 'Inter', sans-serif;
  }
  
  .eto-claim-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  /* --- Top Section --- */
  .eto-claim-top {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    justify-content: space-between;
    margin-bottom: 30px;
  }

  .eto-claim-intro {
    flex: 1;
    min-width: 300px;
    max-width: 650px;
  }

  .eto-claim-pretitle {
    color: var(--eto-red);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    display: block;
    margin-bottom: 10px;
  }

  .eto-claim-main-title {
    font-size: 48px;
    font-weight: 800;
    line-height: 1.1;
    color: var(--eto-dark);
    margin: 0 0 15px 0;
    letter-spacing: -1px;
  }

  .eto-claim-desc {
    font-size: 15px;
    color: var(--eto-dark);
    line-height: 1.5;
    margin-bottom: 25px;
    font-weight: 500;
  }

  .eto-claim-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 15px;
    flex-wrap: wrap;
  }

  .eto-btn-primary-red {
    background-color: var(--eto-red);
    color: #fff;
    padding: 12px 24px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 4px;
    text-decoration: none;
    transition: background-color 0.2s;
    border: none;
    cursor: pointer;
    display: inline-block;
  }
  .eto-btn-primary-red:hover { background-color: #C03015; color: #fff; }

  .eto-claim-call-link {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--eto-dark);
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    border-bottom: 2px solid var(--eto-dark);
    padding-bottom: 2px;
  }

  .eto-claim-subtext {
    font-size: 13px;
    color: var(--eto-text);
    margin: 0;
  }

  /* --- Before you begin --- */
  .eto-claim-before {
    flex: 0 0 380px;
    background: transparent;
    border: 1px solid #D1D1D1;
    border-radius: 4px;
    padding: 20px;
  }

  .eto-claim-before h3 {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 15px 0;
    color: var(--eto-dark);
  }

  .eto-before-item {
    display: flex;
    gap: 15px;
    margin-bottom: 12px;
  }
  .eto-before-item:last-of-type {
    margin-bottom: 12px;
  }

  .eto-before-icon {
    width: 24px; height: 24px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .eto-before-text-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .eto-before-label {
    font-size: 14px;
    font-weight: 700;
    color: var(--eto-dark);
  }
  .eto-before-desc {
    font-size: 13px;
    color: var(--eto-text);
  }

  .eto-before-footer {
    font-size: 12px;
    color: var(--eto-text);
    padding-top: 15px;
    border-top: 1px solid var(--eto-border);
    margin-top: 10px;
  }

  /* --- Form Box --- */
  .eto-claim-form-box {
    background: var(--eto-gray-light);
    border: 1px solid #D1D1D1;
    border-radius: 4px;
    padding: 30px;
    margin-bottom: 30px;
  }

  .eto-form-title {
    font-size: 20px;
    font-weight: 700;
    color: var(--eto-dark);
    margin: 0 0 5px 0;
  }
  .eto-form-req-text {
    font-size: 13px;
    color: var(--eto-text);
    margin: 0 0 25px 0;
  }
  .eto-form-req-text .req { color: var(--eto-red); }

  .eto-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }
  .eto-form-grid.three-col {
    grid-template-columns: 1fr 1fr 1fr;
  }

  .eto-input-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .eto-input-group.full-width {
    grid-column: 1 / -1;
  }

  .eto-input-group label {
    font-size: 12px;
    font-weight: 700;
    color: var(--eto-dark);
  }
  .eto-input-group label .req { color: var(--eto-red); }

  .eto-input-group input,
  .eto-input-group select,
  .eto-input-group textarea {
    scroll-margin-top: 160px;
    padding: 10px;
    border: 1px solid #D1D1D1;
    border-radius: 4px;
    font-size: 14px;
    font-family: inherit;
    background: #FFFFFF;
  }
  .eto-input-group textarea {
    resize: vertical;
    min-height: 80px;
  }

  .eto-input-group input:focus,
  .eto-input-group select:focus,
  .eto-input-group textarea:focus {
    outline: none;
    border-color: var(--eto-dark);
  }

  .eto-upload-box {
    border: 1px dashed #D1D1D1;
    border-radius: 4px;
    padding: 30px;
    text-align: center;
    background: #FAF9F7;
    margin-bottom: 25px;
    position: relative;
    cursor: pointer;
    transition: background 0.2s;
  }
  .eto-upload-box:hover { background: #F0EFEA; }
  
  .eto-upload-box input[type="file"] {
    position: absolute; top:0; left:0; width:100%; height:100%;
    opacity: 0; cursor: pointer;
  }

  .eto-upload-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
  }
  .eto-upload-icon {
    width: 24px; height: 24px; color: var(--eto-dark);
  }
  .eto-upload-text {
    font-size: 14px; color: var(--eto-dark); font-weight: 500;
  }
  .eto-upload-text span.red { color: var(--eto-red); text-decoration: underline; }
  .eto-upload-subtext {
    font-size: 12px; color: var(--eto-text); margin-top: 5px;
  }

  .eto-form-footer {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .eto-recaptcha-mock {
    border: 1px solid #D1D1D1;
    background: #F9F9F9;
    padding: 10px 15px;
    border-radius: 3px;
    display: flex;
    align-items: center;
    gap: 15px;
    height: 74px;
    width: 300px;
  }
  .eto-footer-note {
    font-size: 13px; color: var(--eto-dark); font-weight: 500;
  }

  /* --- What happens next --- */
  .eto-next-section {
    border: 1px solid #D1D1D1;
    border-radius: 4px;
    padding: 30px;
    background: transparent;
    text-align: center;
    margin-bottom: 20px;
  }
  .eto-next-section h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--eto-dark);
    margin: 0 0 30px 0;
  }
  
  .eto-stepper {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
  }

  .eto-step {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    text-align: left;
    max-width: 250px;
  }
  
  .eto-step-num {
    width: 24px; height: 24px;
    border-radius: 50%;
    border: 1px solid #D1D1D1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
    color: var(--eto-dark);
    flex-shrink: 0;
  }
  .eto-step-icon {
    width: 40px; height: 40px;
    flex-shrink: 0;
  }
  
  .eto-step-text h4 {
    font-size: 14px; font-weight: 700; margin: 0 0 5px 0; color: var(--eto-dark);
  }
  .eto-step-text p {
    font-size: 13px; color: var(--eto-text); margin: 0; line-height: 1.4;
  }

  .eto-step-arrow {
    margin-top: 15px;
    color: #A0A0A0;
  }

  /* --- Bottom Help --- */
  .eto-help-strip {
    border: 1px solid #D1D1D1;
    border-radius: 4px;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    background: transparent;
  }
  .eto-help-icon-circle {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid #D1D1D1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .eto-help-icon-circle svg {
    width: 24px;
    height: 24px;
  }
  .eto-help-strip span {
    font-size: 15px; font-weight: 700; color: var(--eto-dark);
  }
  .eto-help-strip a {
    font-size: 15px; font-weight: 700; color: var(--eto-dark); text-decoration: none;
    border-bottom: 2px solid var(--eto-dark); padding-bottom: 2px;
  }

  @media (max-width: 768px) {
    .eto-claim-main-title { font-size: 36px; }
    .eto-form-grid { grid-template-columns: 1fr !important; }
    .eto-stepper { flex-direction: column; align-items: center; }
    .eto-step-arrow { display: none; }
  }
</style>

<div class="eto-claim-page-wrapper">
  <div class="eto-claim-container">
    
    <!-- Top Section -->
    <div class="eto-claim-top">
      <div class="eto-claim-intro">
        <span class="eto-claim-pretitle">PRODUCT SUPPORT</span>
        <h1 class="eto-claim-main-title">Tell us what happened.<br>We'll help make it right.</h1>
        <p class="eto-claim-desc">Complete the form below and include at least one clear photo.<br>Our product support team will contact you within one business day.</p>
        
        <div class="eto-claim-actions">
          <a href="#ClaimForm" class="eto-btn-primary-red">Start Your Claim</a>
          <a href="tel:2136222003" class="eto-claim-call-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            Call (213) 622-2003
          </a>
        </div>
        <p class="eto-claim-subtext">Have your invoice number and photos ready.</p>
      </div>
      
      <div class="eto-claim-before">
        <h3>Before you begin</h3>
        
        <div class="eto-before-item">
          <div class="eto-before-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          </div>
          <div class="eto-before-text-col">
            <span class="eto-before-label">Invoice number</span>
            <span class="eto-before-desc">Helps us locate your order</span>
          </div>
        </div>
        
        <div class="eto-before-item">
          <div class="eto-before-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
          </div>
          <div class="eto-before-text-col">
            <span class="eto-before-label">Clear photos</span>
            <span class="eto-before-desc">Include packaging and product damage</span>
          </div>
        </div>
        
        <div class="eto-before-item">
          <div class="eto-before-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          </div>
          <div class="eto-before-text-col">
            <span class="eto-before-label">Detailed description</span>
            <span class="eto-before-desc">Tell us what happened and when</span>
          </div>
        </div>
        
        <div class="eto-before-footer">
          At least one photo is required.
        </div>
      </div>
    </div>

    <!-- Form Section -->
    <div class="eto-claim-form-box" id="ClaimForm">
      <h2 class="eto-form-title">Submit a product support claim</h2>
      <p class="eto-form-req-text">Required fields are marked <span class="req">*</span></p>

      {%- form 'contact', id: 'ContactClaimForm' -%}
        <input type="hidden" name="contact[tags]" value="claim">

        {%- if form.posted_successfully? -%}
          <div style="background: #e8f5e9; border: 1px solid #4caf50; padding: 20px; border-radius: 4px; margin-bottom: 20px;">
            <h3 style="color: #2e7d32; margin: 0 0 10px 0;">Claim Submitted</h3>
            <p style="margin: 0; color: #1b5e20;">Thank you! We've received your claim and our support team will be in touch within one business day.</p>
          </div>
          <style>
            #ContactClaimForm .eto-form-grid, #ContactClaimForm .eto-upload-box, #ContactClaimForm .eto-form-footer { display: none; }
          </style>
        {%- elsif form.errors -%}
          <div style="color: red; margin-bottom: 20px; font-size: 14px;">
            {{ 'templates.contact.form.error_heading' | t }}<br>
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </div>
        {%- endif -%}

        <div class="eto-form-grid">
          <div class="eto-input-group">
            <label>First Name <span class="req">*</span></label>
            <input type="text" name="contact[first_name]" placeholder="First name" required>
          </div>
          <div class="eto-input-group">
            <label>Last Name <span class="req">*</span></label>
            <input type="text" name="contact[last_name]" placeholder="Last name" required>
          </div>
          
          <div class="eto-input-group">
            <label>Email <span class="req">*</span></label>
            <input type="email" name="contact[email]" placeholder="name@email.com" required>
          </div>
          <div class="eto-input-group">
            <label>Phone <span class="req">*</span></label>
            <input type="tel" name="contact[phone]" placeholder="(213) 622-2003" required>
          </div>
        </div>

        <div class="eto-form-grid three-col">
          <div class="eto-input-group">
            <label>Invoice Number <span class="req">*</span></label>
            <input type="text" name="contact[invoice_number]" placeholder="Enter invoice number" required>
          </div>
          <div class="eto-input-group">
            <label>Number of Doors <span class="req">*</span></label>
            <input type="text" name="contact[number_of_doors]" placeholder="Enter number of doors" required>
          </div>
          <div class="eto-input-group">
            <label>Cause of Damage <span class="req">*</span></label>
            <select name="contact[cause_of_damage]" required>
              <option value="" disabled selected>Select cause</option>
              <option value="Shipping or delivery damage">Shipping or delivery damage</option>
              <option value="Manufacturing or material defect">Manufacturing or material defect</option>
              <option value="Incorrect item or specifications">Incorrect item or specifications</option>
              <option value="Missing parts or hardware">Missing parts or hardware</option>
              <option value="Finish or appearance issue">Finish or appearance issue</option>
              <option value="Installation-related damage">Installation-related damage</option>
              <option value="Other / Not sure">Other / Not sure</option>
            </select>
          </div>
        </div>

        <div class="eto-form-grid">
          <div class="eto-input-group full-width">
            <label>Damage Description <span class="req">*</span></label>
            <textarea name="contact[body]" placeholder="Describe the damage, when it was discovered, and any relevant delivery details." required></textarea>
          </div>
        </div>

        <div class="eto-input-group full-width" style="margin-bottom: 20px;">
          <label>Upload photos <span class="req">*</span></label>
          <div class="eto-upload-box">
            <input type="file" name="contact[photos]" multiple accept="image/png, image/jpeg, application/pdf" required>
            <div class="eto-upload-content">
              <svg class="eto-upload-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg>
              <div>
                <div class="eto-upload-text">Drag and drop files here, or <span class="red">choose files</span></div>
                <div class="eto-upload-subtext">JPG, PNG, or PDF &bull; At least one photo required</div>
              </div>
            </div>
          </div>
        </div>

        <div class="eto-form-footer">
          <div class="eto-recaptcha-mock">
            <input type="checkbox" style="width:24px; height:24px;" required>
            <span style="font-size:14px; color:#555;">I'm not a robot</span>
            <img src="https://www.gstatic.com/recaptcha/api2/logo_48.png" width="32" alt="reCAPTCHA" style="margin-left:auto;">
          </div>
          <button type="submit" class="eto-btn-primary-red">Submit Claim</button>
          <span class="eto-footer-note">You'll receive a claim number for future reference.</span>
        </div>
      {%- endform -%}
    </div>

    <!-- What happens next -->
    <div class="eto-next-section">
      <h3>What happens next</h3>
      <div class="eto-stepper">
        
        <div class="eto-step">
          <div class="eto-step-num">1</div>
          <svg class="eto-step-icon" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          <div class="eto-step-text">
            <h4>Claim received</h4>
            <p>We email your reference number.</p>
          </div>
        </div>
        
        <div class="eto-step-arrow">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </div>

        <div class="eto-step">
          <div class="eto-step-num">2</div>
          <svg class="eto-step-icon" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          <div class="eto-step-text">
            <h4>Team review</h4>
            <p>A specialist reviews your information.</p>
          </div>
        </div>
        
        <div class="eto-step-arrow">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </div>

        <div class="eto-step">
          <div class="eto-step-num">3</div>
          <svg class="eto-step-icon" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          <div class="eto-step-text">
            <h4>We follow up</h4>
            <p>Expect contact within one business day.</p>
          </div>
        </div>
        
      </div>
    </div>

    <!-- Bottom Help -->
    <div class="eto-help-strip">
      <div class="eto-help-icon-circle">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
      </div>
      <span>Need help completing the form?</span>
      <a href="tel:2136222003">Call (213) 622-2003</a>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "File a Claim",
  "settings": [],
  "presets": [
    {
      "name": "File a Claim"
    }
  ]
}
{% endschema %}

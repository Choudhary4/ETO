<div class="eto-file-a-claim-page">
  {{ 'component-door-categories.css' | asset_url | stylesheet_tag }}
  
  <!-- Breadcrumb -->
  <nav class="eto-claim-breadcrumb">
    <a href="/">Home</a>
    <span>&gt;</span>
    <span>claim</span>
  </nav>
  
  <div class="eto-claim-wrapper">
    
    <main class="eto-claim-main">
      <div class="eto-claim-header">
        <h1>File a Claim</h1>
      </div>
      
      <div class="eto-claim-content">
        <div class="eto-claim-intro">
          <p>To begin the claims process, please take a minute to complete the claims form below (including at least one picture).</p>
          <p>Once submitted, an ETO Doors claims representative will contact you within 24 hours.<br>
          Please note your claim number for future reference. We will work with you throughout the claims process to provide the fastest possible resolution.</p>
          <p>Thank you for your patience.<br>
          ETO Doors Claims Team.</p>
        </div>
        
        {% form 'contact', id: 'claim-form', class: 'eto-claim-form' %}
          <input type="hidden" name="contact[tags]" value="claim">
          
          <div class="eto-form-row">
            <div class="eto-form-group">
              <label for="claim-name">Name <span class="required">*</span></label>
              <div class="eto-name-fields">
                <div class="eto-name-field">
                  <input type="text" id="claim-first-name" name="contact[first_name]" required>
                  <span class="eto-field-label">First</span>
                </div>
                <div class="eto-name-field">
                  <input type="text" id="claim-last-name" name="contact[last_name]" required>
                  <span class="eto-field-label">Last</span>
                </div>
              </div>
            </div>
          </div>
          
          <div class="eto-form-group">
            <label for="claim-email">Email <span class="required">*</span></label>
            <input type="email" id="claim-email" name="contact[email]" required>
          </div>
          
          <div class="eto-form-group">
            <label for="claim-phone">Phone <span class="required">*</span></label>
            <input type="tel" id="claim-phone" name="contact[phone]" required>
          </div>
          
          <div class="eto-form-group">
            <label for="claim-doors">Number of Doors <span class="required">*</span></label>
            <input type="number" id="claim-doors" name="contact[number_of_doors]" min="1" required>
          </div>
          
          <div class="eto-form-group">
            <label for="claim-invoice">Invoice Number <span class="required">*</span></label>
            <input type="text" id="claim-invoice" name="contact[invoice_number]" required>
          </div>
          
          <div class="eto-form-group">
            <label for="claim-cause">Cause of Damage <span class="required">*</span></label>
            <select id="claim-cause" name="contact[cause_of_damage]" required>
              <option value="">-Select-</option>
              <option value="damaged_in_transit">Damaged in Transit</option>
              <option value="wrong_size">Wrong Size</option>
              <option value="missing_parts">Missing Parts</option>
              <option value="production_issue">Production Issue</option>
              <option value="other">Other</option>
            </select>
          </div>
          
          <div class="eto-form-group">
            <label for="claim-description">Damage Description <span class="required">*</span></label>
            <textarea id="claim-description" name="contact[body]" rows="5" required placeholder="Please describe the damage in detail..."></textarea>
          </div>
          
          <div class="eto-form-group">
            <label>Upload Images</label>
            <div class="eto-file-upload">
              <input type="file" id="claim-images" name="contact[images]" multiple accept="image/*">
              <label for="claim-images" class="eto-file-label">
                <span>Choose File(s)</span>
                <span class="eto-upload-icon">⬆</span>
              </label>
              <div id="file-preview" class="eto-file-preview"></div>
            </div>
          </div>
          
          <div class="eto-form-group">
            <label for="claim-captcha">Verification Code <span class="required">*</span></label>
            <input type="text" id="claim-captcha" name="contact[verification]" placeholder="Enter the text in the box below" required>
            <div class="eto-captcha-container">
              <canvas id="captcha-canvas" width="150" height="50"></canvas>
              <button type="button" id="refresh-captcha" class="eto-refresh-btn">↻</button>
            </div>
          </div>
          
          <div class="eto-form-buttons">
            <button type="button" class="eto-btn-review" onclick="reviewForm()">Review</button>
            <button type="submit" class="eto-btn-submit">Submit</button>
          </div>
        {% endform %}
        
        <div class="eto-claim-contact">
          <h3>Phone and Email</h3>
          <p>(888) DOOR-ETO<br>
          Alternate:213-622-2003<br>
          Fax:(213)226-4650<br>
          Email:<a href="mailto:contact@etodoors.com">contact@etodoors.com</a></p>
        </div>
      </div>
    </main>
  </div>
</div>

<!-- Form Summary Modal -->
<div id="review-modal" class="eto-modal" style="display: none;">
  <div class="eto-modal-overlay" onclick="closeReviewModal()"></div>
  <div class="eto-modal-content">
    <div class="eto-modal-header">
      <h2>Form Summary</h2>
      <button type="button" class="eto-modal-close" onclick="closeReviewModal()">×</button>
    </div>
    <div class="eto-modal-body">
      <table class="eto-summary-table">
        <tbody id="summary-table-body">
        </tbody>
      </table>
      <div id="review-images" class="eto-review-images"></div>
    </div>
  </div>
</div>

<!-- Success Modal -->
<div id="success-modal" class="eto-modal" style="display: none;">
  <div class="eto-modal-overlay"></div>
  <div class="eto-modal-content eto-success-content">
    <div class="eto-success-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2">
        <circle cx="12" cy="12" r="10" fill="none" stroke="#000000" stroke-width="2"/>
        <path d="M9 12l2 2 4-4" stroke="#000000" stroke-width="2" fill="none"/>
      </svg>
    </div>
    <h2 class="eto-success-title">Thank you! Your response has been submitted.</h2>
    <button type="button" class="eto-add-another" onclick="addAnotherResponse()">+ Add another response</button>
  </div>
</div>

<style>

    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
  }
  
  #captcha-canvas {
    border: 1px solid #ccc;
    background: #fff;
  }
  
  .eto-refresh-btn {
    padding: 5px 10px;
    border: 1px solid #ccc;
    background: #f5f5f5;
    cursor: pointer;
    font-size: 16px;
  }
  
  .eto-form-buttons {
    margin-top: 25px;
    display: flex;
    gap: 10px;
  }
  
  .eto-btn-review,
  .eto-btn-submit {
    padding: 10px 25px;
    font-size: 13px;
    border: none;
    cursor: pointer;
  }
  
  .eto-btn-review {
    background-color: #5b9bd5;
    color: #fff;
  }
  
  .eto-btn-submit {
    background-color: #000000;
    color: #fff;
  }
  
  .eto-claim-contact {
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid #ddd;
    font-size: 12px;
  }
  
  .eto-claim-contact h3 {
    font-size: 14px;
    margin: 0 0 10px;
  }
  
  .eto-claim-contact a {
    color: #000000;
  }
  
  @media (max-width: 768px) {
    .eto-claim-wrapper {
      flex-direction: column;
    }
    
    .eto-name-fields {
      flex-direction: column;
    }
  }
  
  /* Modal Styles */
  .eto-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .eto-modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
  }
  
  .eto-modal-content {
    position: relative;
    background: #fff;
    width: 90%;
    max-width: 500px;
    max-height: 80vh;
    overflow-y: auto;
    border-radius: 0;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }
  
  .eto-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    border-bottom: 1px solid #ddd;
  }
  
  .eto-modal-header h2 {
    margin: 0;
    font-size: 16px;
    font-weight: normal;
    color: #333;
  }
  
  .eto-modal-close {
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    color: #666;
    padding: 0;
    line-height: 1;
  }
  
  .eto-modal-close:hover {
    color: #333;
  }
  
  .eto-modal-body {
    padding: 20px;
  }
  
  .eto-summary-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  
  .eto-summary-table tr {
    border-bottom: 1px solid #eee;
  }
  
  .eto-summary-table td {
    padding: 10px 5px;
    vertical-align: top;
  }
  
  .eto-summary-table td:first-child {
    width: 40%;
    color: #333;
  }
  
  .eto-summary-table td:first-child .required {
    color: #c00;
  }
  
  .eto-summary-table td:last-child {
    color: #666;
  }
  
  /* Review Images */
  .eto-review-images {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 15px;
    padding-top: 15px;
    border-top: 1px solid #eee;
  }
  
  .eto-review-images img {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border: 1px solid #ddd;
    border-radius: 4px;
  }
  
  /* Success Modal */
  .eto-success-content {
    text-align: center;
    padding: 60px 40px;
    background: #fff;
    border: 1px solid #ddd;
  }
  
  .eto-success-icon {
    margin-bottom: 20px;
  }
  
  .eto-success-title {
    font-size: 20px;
    font-weight: normal;
    color: #555;
    margin: 0 0 30px;
  }
  
  .eto-add-another {
    display: inline-block;
    padding: 12px 24px;
    border: 1px solid #000000;
    background: #fff;
    color: #000000;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .eto-add-another:hover {

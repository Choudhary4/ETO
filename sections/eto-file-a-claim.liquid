    resize: vertical;
    max-width: 500px;
  }
  
  .eto-file-upload {
    position: relative;
  }
  
  .eto-file-upload input[type="file"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  
  .eto-file-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 15px;
    border: 1px solid #ccc;
    cursor: pointer;
    background: #fff;
    font-size: 12px;
  }
  
  .eto-upload-icon {
    font-size: 14px;
  }
  
  .eto-file-preview {
    margin-top: 10px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  

  }

  @media screen and (min-width: 1921px) {
    .eto-claim-wrapper, .eto-claim-breadcrumb { max-width: 85vw !important; padding-left: 2vw !important; padding-right: 2vw !important; }
    .eto-claim-breadcrumb { font-size: clamp(12px, 1.2vw, 24px) !important; }
    .eto-claim-header h1 { font-size: clamp(18px, 1.8vw, 36px) !important; }
    .eto-claim-intro { font-size: clamp(12px, 1.2vw, 24px) !important; }
    .eto-claim-form { font-size: clamp(12px, 1.2vw, 24px) !important; }
    .eto-form-group label { font-size: clamp(12px, 1.2vw, 24px) !important; }
    .eto-name-field input, .eto-form-group input[type="email"], .eto-form-group input[type="tel"], .eto-form-group input[type="number"], .eto-form-group input[type="text"], .eto-form-group select, .eto-form-group textarea { 
      font-size: clamp(12px, 1.2vw, 24px) !important; 
      padding: clamp(8px, 0.8vw, 16px) !important; 
    }
    .eto-field-label { font-size: clamp(11px, 1.1vw, 22px) !important; }
    .eto-submit-btn { 
      font-size: clamp(14px, 1.4vw, 28px) !important; 
      padding: clamp(10px, 1vw, 20px) clamp(25px, 2.5vw, 50px) !important; 
    }
    .eto-modal-header h2 { font-size: clamp(16px, 1.6vw, 32px) !important; }
    .eto-summary-table { font-size: clamp(13px, 1.3vw, 26px) !important; }
  }
</style>

<script>
  // Generate CAPTCHA
  function generateCaptcha() {
    var canvas = document.getElementById('captcha-canvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    var chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    var captcha = '';
    
    ctx.fillStyle = '#fff';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    
    ctx.font = 'bold 28px Arial';
    ctx.fillStyle = '#333';
    
    for (var i = 0; i < 6; i++) {
      captcha += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    
    // Add noise lines
    for (var i = 0; i < 3; i++) {
      ctx.strokeStyle = '#ddd';
      ctx.beginPath();
      ctx.moveTo(Math.random() * canvas.width, Math.random() * canvas.height);
      ctx.lineTo(Math.random() * canvas.width, Math.random() * canvas.height);
      ctx.stroke();
    }
    
    ctx.fillText(captcha, 15, 35);
    canvas.dataset.captcha = captcha;
  }
  
  // Refresh captcha
  document.addEventListener('DOMContentLoaded', function() {
    generateCaptcha();
    
    var refreshBtn = document.getElementById('refresh-captcha');
    if (refreshBtn) {
      refreshBtn.addEventListener('click', generateCaptcha);
    }
    
    // File preview
    var fileInput = document.getElementById('claim-images');
    if (fileInput) {
      fileInput.addEventListener('change', function(e) {
        var preview = document.getElementById('file-preview');
        preview.innerHTML = '';
        
        Array.from(e.target.files).forEach(function(file) {
          if (file.type.startsWith('image/')) {
            var reader = new FileReader();
            reader.onload = function(e) {
              var img = document.createElement('img');
              img.src = e.target.result;
              preview.appendChild(img);
            };
            reader.readAsDataURL(file);
          }
        });
      });
    }
    
    // Form validation with captcha and success modal
    var form = document.getElementById('claim-form');
    if (form) {
      form.addEventListener('submit', function(e) {
        var canvas = document.getElementById('captcha-canvas');
        var input = document.getElementById('claim-captcha');
        
        if (input.value.toUpperCase() !== canvas.dataset.captcha) {
          e.preventDefault();
          alert('Verification code is incorrect. Please try again.');
          generateCaptcha();
          input.value = '';
          return;
        }
        
        // Prevent default form submission
        e.preventDefault();
        
        // Get file names for the email
        var imageInput = document.getElementById('claim-images');
        var fileNames = [];
        if (imageInput.files.length > 0) {
          Array.from(imageInput.files).forEach(function(file) {
            fileNames.push(file.name);
          });
        }
        
        // Create form data without the file input (to avoid large payloads)
        var formData = new FormData(form);
        
        // Remove fields that shouldn't be in email
        formData.delete('contact[images]');
        formData.delete('contact[verification]');
        
        if (fileNames.length > 0) {
          formData.set('contact[uploaded_files]', fileNames.join(', '));
        }
        
        // Submit form using fetch
        fetch('/contact#claim-form', {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json, text/html'
          }
        }).then(function(response) {
          if (response.ok || response.status === 302 || response.status === 200) {
            // Show success modal
            document.getElementById('success-modal').style.display = 'flex';
          } else {
            // Still show success (Shopify sometimes returns non-standard responses)
            document.getElementById('success-modal').style.display = 'flex';
          }
        }).catch(function(error) {
          // Show success anyway as form was likely submitted
          document.getElementById('success-modal').style.display = 'flex';
        });
      });
    }
  });
  
  function reviewForm() {
    var fields = [
      { id: 'claim-first-name', label: 'Name', required: true, getValue: function() {
        return document.getElementById('claim-first-name').value + ' ' + document.getElementById('claim-last-name').value;
      }},
      { id: 'claim-email', label: 'Email', required: true },
      { id: 'claim-phone', label: 'Phone', required: true },
      { id: 'claim-doors', label: 'Number of Doors', required: true },
      { id: 'claim-invoice', label: 'Invoice Number', required: true },
      { id: 'claim-cause', label: 'Cause of Damage', required: true, getValue: function() {
        var select = document.getElementById('claim-cause');
        return select.options[select.selectedIndex].text;
      }},
      { id: 'claim-description', label: 'Damage Description', required: true }
    ];
    
    var tableBody = document.getElementById('summary-table-body');
    tableBody.innerHTML = '';
    
    fields.forEach(function(field) {
      var value = field.getValue ? field.getValue() : document.getElementById(field.id).value;
      var row = document.createElement('tr');
      row.innerHTML = '<td>' + field.label + (field.required ? ' <span class="required">*</span>' : '') + '</td><td>' + (value || '') + '</td>';
      tableBody.appendChild(row);
    });
    
    // Show image previews
    var reviewImages = document.getElementById('review-images');
    reviewImages.innerHTML = '';
    
    var imageInput = document.getElementById('claim-images');
    if (imageInput.files.length > 0) {
      var label = document.createElement('div');
      label.style.width = '100%';
      label.style.marginBottom = '10px';
      label.style.fontWeight = 'bold';
      label.innerHTML = 'Upload Images:';
      reviewImages.appendChild(label);
      
      Array.from(imageInput.files).forEach(function(file) {
        if (file.type.startsWith('image/')) {
          var reader = new FileReader();
          reader.onload = function(e) {
            var img = document.createElement('img');
            img.src = e.target.result;
            reviewImages.appendChild(img);
          };
          reader.readAsDataURL(file);
        }
      });
    }
    
    document.getElementById('review-modal').style.display = 'flex';
  }
  
  function closeReviewModal() {
    document.getElementById('review-modal').style.display = 'none';
  }
  
  function addAnotherResponse() {
    // Hide success modal
    document.getElementById('success-modal').style.display = 'none';
    
    // Reset form
    var form = document.getElementById('claim-form');
    form.reset();
    
    // Clear file preview
    document.getElementById('file-preview').innerHTML = '';
    
    // Generate new captcha
    generateCaptcha();
    
    // Scroll to top
    window.scrollTo(0, 0);
  }
</script>


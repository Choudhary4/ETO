          </button>
        </div>
        <div class="eto-top-center">
          <a href="{{ routes.root_url }}" class="eto-brand-logo-link">
            {% render 'icon-eto-logo' %}
          </a>
        </div>
        <div class="eto-top-right">
          <a href="/search" class="eto-utility-icon eto-search-icon-wrap" aria-label="Search">
            {% render 'icon-eto-search' %}
          </a>
          <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="eto-utility-icon eto-account-icon-wrap" aria-label="{% if customer %}My Account{% else %}Log In{% endif %}">
            {% render 'icon-eto-account' %}
          </a>

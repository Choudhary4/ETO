            {% if real_count > 0 %}
              <span class="eto-cart-count" id="eto-cart-badge">{{ real_count }}</span>
            {% else %}
              <span class="eto-cart-count" id="eto-cart-badge" style="display:none;">0</span>
            {% endif %}

{% comment %} Dynamic Menu Script {% endcomment %}
<script src="{{ 'dynamic-menu.js' | asset_url }}?v={{ 'now' | date: '%s' }}" defer></script>
<script data-dynamic-menu-init>
  document.addEventListener('DOMContentLoaded', function() {
    {% assign all_applications = '' %}
    {% assign app_data = '' %}
    {% for product in collections.all.products limit: 250 %}
      {% assign app = product.metafields.custom.spec_application.value %}
      {% if app and app != '' %}
        {% unless all_applications contains app %}
          {% if all_applications != '' %}{% assign all_applications = all_applications | append: '|||' %}{% endif %}
          {% assign all_applications = all_applications | append: app %}
        {% endunless %}
      {% endif %}
    {% endfor %}
    {% assign apps_array = all_applications | split: '|||' %}
    {% assign category_json = '' %}
    {% for app_name in apps_array %}
      {% if app_name != '' %}
        {% assign app_species = '' %}
        {% assign app_fire = '' %}
        {% assign app_arch = '' %}
        {% assign app_mega = '' %}
        {% assign app_impact = '' %}
        {% assign app_oversize = '' %}
        {% for product in collections.all.products limit: 50 %}
          {% assign raw_app = product.metafields.custom.spec_application.value %}
          {% if raw_app %}
            {% assign prod_app_str = raw_app | strip | downcase %}
            {% assign target_app_str = app_name | strip | downcase %}
            {% if prod_app_str == target_app_str %}
            {% assign val = product.metafields.custom.spec_species.value %}
            {% if val and val != '' %}
              {% unless app_species contains val %}
                {% if app_species != '' %}{% assign app_species = app_species | append: '|||' %}{% endif %}
                {% assign app_species = app_species | append: val %}
              {% endunless %}
            {% endif %}
            {% assign val = product.metafields.custom.spec_fire_rated.value %}
            {% if val and val != 'No' and val != '' %}
              {% unless app_fire contains val %}
                {% if app_fire != '' %}{% assign app_fire = app_fire | append: '|||' %}{% endif %}
                {% assign app_fire = app_fire | append: val %}
              {% endunless %}
            {% endif %}
            {% assign val = product.metafields.custom.spec_arch.value %}
            {% if val and val != 'No' and val != '' %}
              {% unless app_arch contains val %}
                {% if app_arch != '' %}{% assign app_arch = app_arch | append: '|||' %}{% endif %}
                {% assign app_arch = app_arch | append: val %}
              {% endunless %}
            {% endif %}
            {% assign val = product.metafields.custom.spec_mega.value %}
            {% if val and val != 'No' and val != '' %}
              {% unless app_mega contains val %}
                {% if app_mega != '' %}{% assign app_mega = app_mega | append: '|||' %}{% endif %}
                {% assign app_mega = app_mega | append: val %}
              {% endunless %}
            {% endif %}
            {% assign val = product.metafields.custom.spec_impact.value %}
            {% if val and val != 'No' and val != '' %}
              {% unless app_impact contains val %}
                {% if app_impact != '' %}{% assign app_impact = app_impact | append: '|||' %}{% endif %}
                {% assign app_impact = app_impact | append: val %}
              {% endunless %}
            {% endif %}
            {% assign val = product.metafields.custom.spec_oversize.value %}
            {% if val and val != 'No' and val != '' %}
              {% unless app_oversize contains val %}
                {% if app_oversize != '' %}{% assign app_oversize = app_oversize | append: '|||' %}{% endif %}
                {% assign app_oversize = app_oversize | append: val %}
              {% endunless %}
            {% endif %}
            {% endif %}
          {% endif %}
        {% endfor %}
        {% capture app_json %}
          "{{ app_name | escape }}": {
            "species": {{ app_species | split: '|||' | json }},
            "fireRated": {{ app_fire | split: '|||' | json }},
            "arch": {{ app_arch | split: '|||' | json }},
            "megaDoor": {{ app_mega | split: '|||' | json }},
            "impact": {{ app_impact | split: '|||' | json }},
            "oversize": {{ app_oversize | split: '|||' | json }}
          }
        {% endcapture %}
        {% if category_json != '' %}{% assign category_json = category_json | append: ',' %}{% endif %}
        {% assign category_json = category_json | append: app_json %}
      {% endif %}
    {% endfor %}
    if (typeof etoInitDynamicMenu === 'function') {
      etoInitDynamicMenu({
        applications: {{ apps_array | json }},
        categories: { {{ category_json }} },
        asyncFetch: true
      });
    }
  });

  // Mobile Sliding Menu Script
  document.addEventListener('DOMContentLoaded', function() {
    var navInner = document.querySelector('.eto-nav-inner');
    if (!navInner) return;
    navInner.addEventListener('click', function(e) {
      if (window.innerWidth > 990) return;
      var target = e.target;
      var backHeader = target.closest('.eto-drawer-header');
      if (backHeader) {
        e.preventDefault(); e.stopPropagation();
        var submenu = backHeader.parentElement;
        if (submenu && (submenu.classList.contains('eto-dropdown') || submenu.classList.contains('eto-flyout'))) {
          submenu.classList.remove('is-open');
        }
        return;
      }
      var link = target.closest('a');
      if (!link) return;
      var listItem = link.closest('li');
      if (!listItem) return;
      // Get the immediate submenu to avoid selecting nested flyouts
      var submenu = null;
      var children = listItem.children;
      for (var i = 0; i < children.length; i++) {
        if (children[i].classList.contains('eto-dropdown') || children[i].classList.contains('eto-flyout')) {
          submenu = children[i];
          break;
        }
      }
      
      // Check if user clicked the arrow or the link text
      var clickedArrow = target.closest('.arrow-right');
      
      if (submenu && clickedArrow) {
        e.preventDefault(); e.stopPropagation();
        if (!submenu.querySelector('.eto-drawer-header')) {
          var header = document.createElement('li');
          header.className = 'eto-drawer-header';
          var linkText = link.innerText.trim() || link.textContent.trim();
          // Remove the right arrow from the header text if it exists
          linkText = linkText.replace(/▶/g, '').trim();
          header.innerHTML = '<span class="eto-back-icon">&lt;</span> ' + linkText;
          submenu.insertBefore(header, submenu.firstChild);
        }
        submenu.classList.add('is-open');
        // Scroll the parent container to top instead of navInner
        var scrollContainer = submenu.parentElement.closest('.eto-dropdown, .eto-flyout, .eto-nav-inner');
        if (scrollContainer) scrollContainer.scrollTop = 0;
      }
    });
  });

  // Dynamic Header Padding
  function etoUpdateHeaderPadding() {
    var wrapper = document.querySelector('.eto-sticky-header-wrapper');
    var sectionHeader = document.querySelector('.section-header');
    if (wrapper && sectionHeader) {
      var h = wrapper.offsetHeight;
      if (h > 0) {
        sectionHeader.style.paddingTop = h + 'px';
      }
    }
  }
  
  document.addEventListener('DOMContentLoaded', function() {
    etoUpdateHeaderPadding();
    window.addEventListener('resize', etoUpdateHeaderPadding);
    var wrapper = document.querySelector('.eto-sticky-header-wrapper');
    if (wrapper && typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(etoUpdateHeaderPadding).observe(wrapper);
    }
  });
</script>

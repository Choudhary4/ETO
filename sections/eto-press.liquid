<style>
  .eto-press-page {
    font-family: sans-serif;
    color: #333;
  }
  
  .eto-press-breadcrumb {
    font-size: 12px;
    padding: 15px 20px;
    max-width: var(--eto-container-max);
    margin: 0 auto;
  }
  
  .eto-press-breadcrumb a {
    color: #333;
    text-decoration: none;
  }
  
  .eto-press-wrapper {
    display: flex;
    max-width: var(--eto-container-max);
    margin: 0 auto;
    padding: 0 20px 40px;
    gap: 30px;
  }
  
  .eto-press-main {
    flex: 1;
  }
  
  .eto-press-header h2 {
    font-size: 18px;
    font-weight: normal;
    margin: 0 0 10px;
  }
  
  .eto-press-banner {
    max-width: 100%;
    margin-bottom: 30px;
  }
  
  .eto-press-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
  }
  
  .eto-press-item {
    background: #fff;
  }
  
  .eto-press-item h3 {
    font-size: 14px;
    font-weight: bold;
    margin: 0 0 10px;
    line-height: 1.4;
  }
  
  .eto-press-item p {
    font-size: 12px;
    margin: 0 0 5px;
    line-height: 1.4;
  }
  
  .eto-press-products {
    margin-top: 5px !important;
  }
  
  .eto-press-video {
    margin-top: 10px;
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
  }
  
  .eto-press-video iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  
  @media (max-width: 768px) {
    .eto-press-wrapper {
      flex-direction: column;
    }
    
    .eto-press-grid {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (min-width: 1921px) {
    .eto-press-wrapper, .eto-press-breadcrumb { max-width: 85vw !important; padding-left: 2vw !important; padding-right: 2vw !important; }
    .eto-press-breadcrumb { font-size: clamp(12px, 1.2vw, 24px) !important; }
    .eto-press-header h2 { font-size: clamp(18px, 1.8vw, 36px) !important; }
    .eto-press-item h3 { font-size: clamp(14px, 1.4vw, 28px) !important; }
    .eto-press-item p { font-size: clamp(12px, 1.2vw, 24px) !important; }
  }
</style>


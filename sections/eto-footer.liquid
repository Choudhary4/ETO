{% comment %}
ETO – CUSTOM FOOTER v2 (Matches client screenshot)
4-Column: Logo+Social | Contact | ETO Resources (2-col) | Stay Inspired
{% endcomment %}

<style>
/* ── Brands Bar ───────────────────────────────────── */
.eto-brands-bar {
  background: #E6E2DF !important;
  padding: 18px 0 !important;
  width: 100vw !important;
  max-width: none !important;
  position: relative !important;
  left: 50% !important;
  right: 50% !important;
  margin-left: -50vw !important;
  margin-right: -50vw !important;
  box-sizing: border-box !important;
  border-bottom: 1px solid #a89f95 !important;
}
.eto-brands-inner {
  max-width: var(--eto-container-max);
  margin: 0 auto;
  padding: 0 var(--eto-margin-edge);
  display: flex;
  align-items: center;
  justify-content: center;
}
.eto-brands-title h3 {
  margin: 0 0 0 0;
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: 13px;
  font-weight: 700;
  color: #000000;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  text-align: center;
}
.eto-brands-logos {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 36px;
  margin-top: 18px;
  width: 100%;
}
.eto-brand-logo-item {
  filter: brightness(0) drop-shadow(0 0 0.45px #000000);
  opacity: 1 !important;
  transition: transform 0.2s;
  display: block;
  object-fit: contain;
}
.eto-brand-logo-item:hover {
  transform: scale(1.05);
}
/* Balanced sizing so square icons and wide text logos look equal weight */
.logo-stacked { height: 44px; width: auto; max-width: 95px; }
.logo-wide { height: 26px; width: auto; max-width: 140px; }
.logo-extrawide { height: 22px; width: auto; max-width: 180px; }

@media (min-width: 990px) {
  .eto-brands-logos {
    flex-wrap: nowrap;
    justify-content: space-between;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    gap: 28px;
  }
}
@media (max-width: 989px) and (min-width: 600px) {
  .eto-brands-logos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    justify-items: center;
    gap: 28px 20px;
  }
}
@media (max-width: 599px) {
  .eto-brands-logos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    justify-items: center;
    gap: 24px 16px;
  }
}

/* ── Main Footer ─────────────────────────────────── */
.eto-footer-main {
  background: #E6E2DF !important;
  padding: 40px 0 32px !important;
  color: #000000 !important;
  width: 100vw !important;
  max-width: none !important;
  position: relative !important;
  left: 50% !important;
  right: 50% !important;
  margin-left: -50vw !important;
  margin-right: -50vw !important;
  box-sizing: border-box !important;
}
.eto-footer-inner {
  max-width: var(--eto-container-max);
  margin: 0 auto;
  padding: 0 var(--eto-margin-edge);
  display: grid;
  grid-template-columns: 240px 280px auto 340px;
  justify-content: center;
  gap: 0;
  align-items: stretch;
}

/* ── Col 1: Logo + Social ────────────────────────── */
.eto-footer-brand {
  border-right: 1px solid #ccc;
  padding-right: 40px;
}
.eto-footer-logo {
  display: inline-block !important;
  margin-bottom: 16px !important;
  border: 1px solid #ccc !important;
  padding: 8px !important;
  width: auto !important;
}
.eto-footer-logo svg {
  width: 140px !important;
  height: 80px !important;
  max-width: 100% !important;
  display: block !important;
  margin: 0 !important;
}
.eto-footer-tagline {
  font-family: 'Montserrat', sans-serif;
  font-size: 13px;
  color: #000000;
  margin: 0 0 20px;
  line-height: 1.5;
}
.eto-footer-social {
  display: flex;
  gap: 10px;
  align-items: center;
}
.eto-footer-social a {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  background: #000000;
  border-radius: 50%;
  color: #ffffff;
  text-decoration: none;
  transition: background 0.2s;
}
.eto-footer-social a:hover { background: #555; }
.eto-footer-social svg { width: 15px; height: 15px; fill: #fff; }

/* ── Col 2: Contact ──────────────────────────────── */
.eto-footer-contact {
  border-right: 1px solid #ccc;
  padding-left: 40px;
  padding-right: 40px;
}
.eto-footer-contact h4 {
  font-family: 'Montserrat', sans-serif;
  font-size: 12px;
  font-weight: 700;
  margin: 0 0 24px;
  color: #000000;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}
.eto-contact-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin-bottom: 10px;
}
.eto-contact-icon {
  flex-shrink: 0;
  width: 16px;
  margin-top: 1px;
  color: #555;
}
.eto-contact-row p,
.eto-contact-row a {
  font-family: 'Montserrat', sans-serif;
  font-size: 13px;
  color: #000000;
  margin: 0;
  line-height: 1.4;
  text-decoration: none;
}
.eto-contact-row a:hover { text-decoration: underline; }

/* ── Col 3: ETO Resources (2 sub-cols) ───────────── */
.eto-footer-resources {
  border-right: 1px solid #ccc;
  padding-left: 40px;
  padding-right: 40px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.eto-footer-resources h4 {
  font-family: 'Montserrat', sans-serif;
  font-size: 12px;
  font-weight: 700;
  margin: 0 0 24px;
  color: #000000;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  text-align: center !important;
  width: 100% !important;
  display: block !important;
}
.eto-resources-cols {
  display: flex;
  gap: 60px;
  justify-content: center;
  width: 100% !important;
}
.eto-resources-col {
  white-space: nowrap;
}
.eto-resources-col h5 {
  font-family: 'Montserrat', sans-serif;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #555555;
  margin: 0 0 20px;
}
.eto-resources-col ul {
  list-style: none;
  margin: 0;
  padding: 0;
}
.eto-resources-col li { margin-bottom: 12px; }
.eto-resources-col a {
  color: #333333;
  text-decoration: none;
  font-family: 'Montserrat', sans-serif;
  font-size: 13px;
  transition: color 0.2s;
}
.eto-resources-col a:hover { color: #000; text-decoration: underline; }

/* ── Col 4: Stay Inspired ────────────────────────── */
.eto-footer-inspired {
  padding-left: 40px;
}
.eto-footer-inspired h4 {
  font-family: 'Montserrat', sans-serif;
  font-size: 12px;
  font-weight: 700;
  margin: 0 0 24px;
  color: #000000;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}
.eto-footer-inspired p {
  font-family: 'Montserrat', sans-serif;
  font-size: 13px;
  color: #000000;
  margin: 0 0 16px;
  line-height: 1.5;
}
.eto-email-form {
  margin-bottom: 28px;
}
.eto-email-form-inner {
  display: flex;
  gap: 0;
}
.eto-email-form-inner input {
  flex: 1;
  padding: 10px 12px;
  font-family: 'Montserrat', sans-serif;
  font-size: 13px;
  border: 1px solid #ccc;
  border-right: none;
  background: #fff;
  outline: none;
  color: #000;
}
.eto-email-form-inner input::placeholder { color: #aaa; }
.eto-email-form-inner button {
  background: #000000;
  color: #fff;
  font-family: 'Montserrat', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border: none;
  padding: 10px 16px;
  cursor: pointer;
  transition: background 0.2s;
  white-space: nowrap;
}
.eto-email-form-inner button:hover { background: #333333; }
.eto-form-success { font-size: 13px; color: #4caf50; margin-top: 10px; }
.eto-form-error { font-size: 13px; color: #f44336; margin-top: 10px; }
.eto-footer-badges {
  display: flex;
  gap: 0;
  align-items: stretch;
}
.eto-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  text-align: center;
  flex: 1;
  padding: 0 8px;
}
.eto-badge:first-child {
  padding-left: 0;
}
.eto-badge:last-child {
  padding-right: 0;
}
.eto-badge:not(:last-child) {
  border-right: 1px solid #ccc;
}
.eto-badge svg {
  width: 36px;
  height: 36px;
  color: #555;
}
.eto-badge span {
  font-family: 'Montserrat', sans-serif;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #000000;
  line-height: 1.3;
}

/* ── Bottom Footer ───────────────────────────────── */
.eto-footer-bottom {
  background: #E6E2DF !important;
  padding: 12px 0 !important;
  width: 100vw !important;
  max-width: none !important;
  position: relative !important;
  left: 50% !important;
  right: 50% !important;
  margin-left: -50vw !important;
  margin-right: -50vw !important;
  box-sizing: border-box !important;
}
.eto-footer-bottom-inner {
  max-width: var(--eto-container-max);
  margin: 0 auto;
  padding: 0 var(--eto-margin-edge);
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}
.eto-footer-copyright {
  font-family: 'Montserrat', sans-serif;
  font-size: 13px;
  color: #000000;
}
.eto-footer-links {
  display: flex;
  gap: 24px;
}
.eto-footer-links a {
  color: #000000;
  text-decoration: none;
  font-family: 'Montserrat', sans-serif;
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  transition: color 0.2s;
}
.eto-footer-links a:hover { color: #555; }

/* ── Disclaimer ──────────────────────────────────── */
.eto-footer-disclaimer {
  background: #E6E2DF !important;
  padding: 10px 0 !important;
  width: 100vw !important;
  max-width: none !important;
  position: relative !important;
  left: 50% !important;
  right: 50% !important;
  margin-left: -50vw !important;
  margin-right: -50vw !important;
  box-sizing: border-box !important;
}
.eto-footer-disclaimer-inner {
  max-width: var(--eto-container-max);
  margin: 0 auto;
  padding: 0 var(--eto-margin-edge);
  text-align: center;
  font-family: 'Montserrat', sans-serif;
  font-size: 12px;
  color: #555555;
}
.eto-footer-disclaimer-inner a { color: #555; text-decoration: underline; }

@media (min-width: 1921px) {
  .eto-footer-inner,
  .eto-footer-bottom-inner,
  .eto-footer-disclaimer-inner {
    max-width: 95% !important;
  }
  .eto-brands-title h3 { font-size: clamp(13px, 0.8vw, 26px); }
  .logo-stacked { max-width: clamp(95px, 6vw, 190px); height: auto; }
  .logo-wide { max-width: clamp(140px, 8vw, 280px); height: auto; }
  .logo-extrawide { max-width: clamp(180px, 11vw, 360px); height: auto; }
  .eto-footer-inner {
    grid-template-columns: 12vw 16vw minmax(0, 1fr) 22vw;
    gap: 1vw;
  }
  .eto-footer-logo svg {
    width: clamp(140px, 10vw, 240px) !important;
    height: auto !important;
  }
  .eto-footer-tagline, .eto-contact-row p, .eto-contact-row a, .eto-resources-col a, .eto-footer-inspired p, .eto-footer-copyright, .eto-footer-links a, .eto-email-form-inner input, .eto-form-success, .eto-form-error, .eto-footer-disclaimer-inner {
    font-size: clamp(14px, 0.9vw, 24px) !important;
  }
  .eto-footer-contact h4, .eto-footer-resources h4, .eto-footer-inspired h4 {
    font-size: clamp(15px, 1.1vw, 28px) !important;
    margin-bottom: clamp(24px, 1.5vw, 40px) !important;
  }
  .eto-resources-col h5, .eto-email-form-inner button {
    font-size: clamp(13px, 0.9vw, 24px) !important;
  }
  .eto-badge svg {
    width: clamp(36px, 2vw, 54px);
    height: clamp(36px, 2vw, 54px);
  }
  .eto-badge span {
    font-size: clamp(10px, 0.6vw, 16px);
  }
  .eto-contact-icon {
    width: clamp(16px, 1vw, 24px);
  }
  .eto-footer-brand, .eto-footer-contact, .eto-footer-resources, .eto-footer-inspired {
    padding-left: 1vw;
    padding-right: 1vw;
  }
  .eto-resources-cols {
    gap: 2vw;
  }
  .eto-footer-social svg {
    width: clamp(15px, 1vw, 24px);
    height: clamp(15px, 1vw, 24px);
  }
  .eto-footer-social a {
    width: clamp(32px, 2vw, 48px);
    height: clamp(32px, 2vw, 48px);
  }
}

/* ── Responsive ──────────────────────────────────── */
@media (max-width: 1200px) {
  .eto-footer-inner {
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
  .eto-footer-brand,
  .eto-footer-contact,
  .eto-footer-resources,
  .eto-footer-inspired {
    border-right: none !important;
    padding: 0 !important;
  }
  .eto-footer-resources {
    align-items: flex-start;
  }
  .eto-resources-cols {
    justify-content: flex-start;
  }
}
@media (max-width: 1024px) {
  .eto-footer-logo {
    border: none !important;
    padding: 0 !important;
  }
}
@media (max-width: 768px) {
  .eto-footer-inner {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .eto-footer-brand {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .eto-footer-logo {
    border: none !important;
    padding: 0 !important;
  }
  .eto-footer-logo svg {
    width: 160px !important;
    height: 91px !important;
  }
  .eto-footer-tagline {
    font-size: 14px;
    margin-bottom: 24px;
    text-align: center;
  }
  .eto-footer-social {
    gap: 16px;
    justify-content: center;
    width: 100%;
  }
  .eto-footer-social a {
    width: 40px;
    height: 40px;
  }
  .eto-footer-social svg {
    width: 20px;
    height: 20px;
  }
  .eto-resources-cols {
    display: grid !important;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .eto-resources-col {
    white-space: normal;
  }
  .eto-footer-badges {
    flex-direction: row !important;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
  }
  .eto-badge {
    padding: 0 !important;
    border-right: none !important;
    align-items: center !important;
    text-align: center !important;
  }
  .eto-badge svg {
    width: 28px;
    height: 28px;
  }
  .eto-footer-bottom-inner {
    flex-direction: column;
    text-align: center;
    gap: 16px;
  }
  .eto-footer-links {
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }
}
</style>


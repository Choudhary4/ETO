        <div class="eto-email-form-inner">
          <input type="email" name="contact[email]" placeholder="Enter your email" required>
          <button type="submit">SUBSCRIBE</button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="eto-form-success">Thank you for subscribing!</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="eto-form-error">{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</p>
        {%- endif -%}
      {%- endform -%}

<div class="eto-product-grid-section">
  <div class="eto-product-grid">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <a href="{{ block.settings.link | default: '#' }}" class="eto-pg-card group" {{ block.shopify_attributes }} style="text-decoration: none; color: inherit;">
          <div class="eto-pg-image-wrapper">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'eto-pg-image' }}
            {% elsif block.settings.image_url != blank %}
              <img class="eto-pg-image" loading="lazy" src="{{ block.settings.image_url }}" alt="{{ block.settings.title }}">
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'eto-pg-image' }}
            {% endif %}
          </div>
          <h4 class="eto-pg-title">{{ block.settings.title }}</h4>
          <p class="eto-pg-subtitle">{{ block.settings.subtitle }}</p>
          <span class="eto-pg-btn">{{ block.settings.btn_text | default: 'SHOP NOW' }}</span>
        </a>
      {% endfor %}
    {% else %}
      <a href="/collections/all?filter.p.m.custom.product_category=WhiteOak" class="eto-pg-card group" style="text-decoration: none; color: inherit;">
        <div class="eto-pg-image-wrapper">
          <img class="eto-pg-image" loading="lazy" src="{{ 'grid-white-oak.svg' | asset_url }}" alt="White Oak Doors">
        </div>
        <h4 class="eto-pg-title">White Oak<br>Doors</h4>
        <p class="eto-pg-subtitle">Timeless Craftsmanship.<br>Modern Function.</p>
        <span class="eto-pg-btn">SHOP NOW</span>
      </a>
      <a href="/collections/all?filter.p.m.custom.product_category=French" class="eto-pg-card group" style="text-decoration: none; color: inherit;">
        <div class="eto-pg-image-wrapper">
          <img class="eto-pg-image" loading="lazy" src="{{ 'grid-french.svg' | asset_url }}" alt="French Doors">
        </div>
        <h4 class="eto-pg-title">French<br>Doors</h4>
        <p class="eto-pg-subtitle">Timeless Craftsmanship.<br>Modern Function.</p>
        <span class="eto-pg-btn">SHOP NOW</span>
      </a>
      <a href="/collections/all?filter.p.m.custom.product_category=FireRated" class="eto-pg-card group" style="text-decoration: none; color: inherit;">
        <div class="eto-pg-image-wrapper">
          <img class="eto-pg-image" loading="lazy" src="{{ 'grid-fire.svg' | asset_url }}" alt="Fire Rated Doors">
        </div>
        <h4 class="eto-pg-title">Fire Rated<br>Doors</h4>
        <p class="eto-pg-subtitle">Timeless Craftsmanship.<br>Modern Function.</p>
        <span class="eto-pg-btn">SHOP NOW</span>
      </a>
      <a href="/collections/all?filter.p.m.custom.product_category=Fiberglass" class="eto-pg-card group" style="text-decoration: none; color: inherit;">
        <div class="eto-pg-image-wrapper">
          <img class="eto-pg-image" loading="lazy" src="{{ 'grid-fiberglass.svg' | asset_url }}" alt="Fiberglass Doors">
        </div>
        <h4 class="eto-pg-title">Fiberglass<br>Doors</h4>
        <p class="eto-pg-subtitle">Timeless Craftsmanship.<br>Modern Function.</p>
        <span class="eto-pg-btn">SHOP NOW</span>
      </a>
      <a href="/collections/all?filter.p.m.custom.product_category=Metal" class="eto-pg-card group" style="text-decoration: none; color: inherit;">
        <div class="eto-pg-image-wrapper">
          <img class="eto-pg-image" loading="lazy" src="{{ 'grid-steel.svg' | asset_url }}" alt="Steel Doors">
        </div>
        <h4 class="eto-pg-title">Steel<br>Doors</h4>
        <p class="eto-pg-subtitle">Timeless Craftsmanship.<br>Modern Function.</p>
        <span class="eto-pg-btn">SHOP NOW</span>
      </a>
      <a href="/collections/all?filter.p.m.custom.product_category=Impact" class="eto-pg-card group" style="text-decoration: none; color: inherit;">
        <div class="eto-pg-image-wrapper">
          <img class="eto-pg-image" loading="lazy" src="{{ 'grid-impact.svg' | asset_url }}" alt="Impact Doors">
        </div>
        <h4 class="eto-pg-title">Impact<br>Doors</h4>
        <p class="eto-pg-subtitle">Timeless Craftsmanship.<br>Modern Function.</p>
        <span class="eto-pg-btn">SHOP NOW</span>
      </a>
    {% endif %}
  </div>
</div>

<style>
.eto-product-grid-section {
  background: #ffffff;
  padding: 0 var(--eto-margin-edge) 120px var(--eto-margin-edge); 
  overflow: hidden;
}
.eto-product-grid {
  display: grid;
  gap: 0;
  max-width: 1952px;
  margin: 0 auto;
  border-top: 1px solid #EBEBEB;
  border-bottom: 1px solid #EBEBEB;
}

@media (min-width: 1921px) {
  .eto-product-grid {
    max-width: 100%;
  }
}

.eto-pg-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 100%;
  position: relative;
  padding: 64px 16px;
  border-bottom: 1px solid #EBEBEB;
  border-right: 1px solid #EBEBEB;
  cursor: pointer;
}
/* Offset the 16px card padding so grid aligns with page edges on normal screens */
@media (min-width: 768px) and (max-width: 1984px) {
  .eto-product-grid {
    width: calc(100% + 32px);
    margin-left: -16px;
    margin-right: -16px;
  }
}
@media (max-width: 767px) {
  .eto-product-grid {
    width: calc(100% + 20px);
    margin-left: -10px;
    margin-right: -10px;
  }
  .eto-pg-card {
    padding: 40px 10px;
  }
}

/* Desktop: 3 Columns */
@media (min-width: 1201px) {
  .eto-product-grid { grid-template-columns: repeat(3, 1fr); }
  .eto-pg-card:nth-child(3n) { border-right: none; }
  .eto-pg-card:nth-last-child(-n+3) { border-bottom: none; }
}

/* Tablet: 2 Columns */
@media (min-width: 901px) and (max-width: 1200px) {
  .eto-product-grid { 
    grid-template-columns: repeat(2, 1fr); 
    max-width: 932px;
  }
  .eto-pg-card:nth-child(2n) { border-right: none; }
  .eto-pg-card:nth-last-child(-n+2) { border-bottom: none; }
}

/* Mobile: 1 Column */
@media (max-width: 900px) {
  .eto-product-grid { 
    grid-template-columns: 1fr; 
    max-width: 532px;
  }
  .eto-pg-card { border-right: none; }
  .eto-pg-card:last-child { border-bottom: none; }
}

.eto-pg-image-wrapper {
  width: 100%;
  aspect-ratio: 397 / 485;
  background: var(--eto-soft-white);
  margin-bottom: 24px;
  overflow: hidden;
  display: block;
}
.eto-pg-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.eto-pg-card:hover .eto-pg-image {
  transform: scale(1.05);
}
.eto-pg-title {
  font-family: 'MADE Mirage', serif;
  font-size: 56px;
  font-weight: 300;
  text-transform: none;
  letter-spacing: normal;
  line-height: 0.9;
  color: #000000;
  margin: 0 0 16px 0;
}
.eto-pg-subtitle {
  font-family: 'Montserrat', sans-serif;
  font-size: 19px;
  font-weight: 400;
  color: #000000;
  margin: 0 0 24px 0;
  line-height: 25px;
}
.eto-pg-btn {
  background: #C7C1B9;
  color: #ffffff;
  font-family: 'Hanken Grotesk', sans-serif;
  font-size: 13px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  padding: 12px 28px;
  text-decoration: none;
  border: none;
  display: inline-block;
  transition: all 0.4s ease;
}
.eto-pg-btn:hover {
  background: var(--eto-dark-charcoal);
  color: #ffffff;
  transform: translateY(-2px);
}


</style>


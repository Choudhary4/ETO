{% comment %}
ETO – COLLECTION HERO (TEXT ONLY, SEO STYLE)
{% endcomment %}

<style>
.eto-collection-hero {
  max-width: var(--eto-container-max);
  margin: 0 auto;
  padding: 20px 16px 10px;
}

.eto-collection-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
}

.eto-collection-title {
  font-size: 32px;
  font-weight: 600;
  margin: 0;
  padding-bottom: 8px;
  border-bottom: 3px solid #3a8b2b;
  display: inline-block;
}

.eto-collection-right {
  text-align: right;
  font-size: 14px;
  line-height: 1.4;
}

.eto-collection-right strong {
  font-weight: 700;
}

.eto-collection-desc {
  margin-top: 14px;
  font-size: 15px;
  line-height: 1.7;
  color: #111;
  max-width: 1100px;
}

@media (max-width: 768px) {
  .eto-collection-top {
    flex-direction: column;
  }
  .eto-collection-right {
    text-align: left;
    margin-top: 6px;
  }
}
</style>

<section class="eto-collection-hero">
  <div class="eto-collection-header-row">
    <div class="eto-collection-callout">
      <div class="help-choosing-banner" style="box-sizing: border-box; width: 100%; height: 85px; border: 1.5px solid #C5BEB3; border-radius: 4px; padding: 12px 15px; display: flex; align-items: center; margin-bottom: 15px; background: #fff;">
        <div style="flex-shrink: 0; margin-right: 15px; display: flex; align-items: center;">
          <svg width="38" height="36" viewBox="0 0 38 36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <g clip-path="url(#clip0_62_662)">
              <path d="M34.8021 13.7171C34.0555 7.64678 29.4019 2.34609 23.529 0.645399C20.5054 -0.248394 17.2081 -0.211153 14.2094 0.744709C8.44844 2.51988 3.94419 7.73368 3.22251 13.7047C0.0620642 15.6288 -0.759154 20.0233 0.696642 23.2509C1.29389 24.5792 2.30175 25.8702 3.7451 26.2923C4.72808 26.5778 6.07189 25.9323 6.00967 24.7902C6.02212 21.4633 6.00967 18.1364 6.00967 14.8219C6.02212 14.0523 5.21334 13.7047 4.59121 13.5061C5.27555 9.06195 8.22447 5.06471 12.2061 2.97919C16.897 0.471606 22.994 0.806778 27.3365 3.8854C30.5467 6.09505 32.8983 9.63299 33.4209 13.5185C32.7739 13.6799 32.0149 14.0895 32.0025 14.8344C31.9651 18.2357 32.0025 21.6495 31.99 25.0633C31.9403 25.6716 32.5251 26.0192 32.9854 26.2923C32.3633 27.7695 31.2683 29.8178 29.5761 31.1213C28.0955 32.2633 26.2166 32.8219 24.9101 33.0951C24.176 33.244 23.5165 33.3185 23.0686 33.3682C22.8571 32.3875 21.9861 31.6426 20.9285 31.6426H19.0621C17.8551 31.6426 16.8721 32.6109 16.8721 33.8151C16.8721 35.0192 17.8551 35.9875 19.0621 35.9875H20.9285C21.8866 35.9875 22.6953 35.3792 22.994 34.5351C23.4917 34.4978 24.2382 34.4109 25.1217 34.2371C27.7222 33.7033 29.3646 32.7475 30.2854 32.0399C31.6292 31.0095 32.7864 29.4702 33.732 27.484C33.9186 27.0868 34.0804 26.7144 34.2173 26.3792C34.3915 26.3544 34.4661 26.3171 34.4661 26.3171C36.4321 25.4482 37.5519 23.3626 37.8879 21.3268C38.4353 18.5088 37.3404 15.2813 34.8394 13.7171" fill="#C6BEB5"/>
            </g>
            <defs>
              <clipPath id="clip0_62_662">
                <rect width="38" height="36" fill="white"/>
              </clipPath>
            </defs>
          </svg>
        </div>
        <div style="display: flex; flex-direction: column; justify-content: center; text-align: left;">

          <p style="margin: 0 0 2px 0; font-size: 15px; font-weight: 800; color: #000; letter-spacing: 0; white-space: nowrap;">CALL (213) 622-2003</p>
          <p style="margin: 0; font-size: 14px; font-weight: 300; color: #000; letter-spacing: 0; white-space: nowrap;">Speak with a Door Specialist</p>
        </div>
      </div>

      <div class="door-type-banner" style="box-sizing: border-box; width: 100%; height: 85px; border: 1.5px solid #C5BEB3; border-radius: 4px; padding: 12px 10px; display: flex; flex-direction: column; align-items: center; justify-content: center; margin-bottom: 25px; background: #fff;">
        <p style="margin: 0 0 8px 0; font-size: 16px; font-weight: 300; color: #000; letter-spacing: 0; white-space: nowrap;">All eto doors can be ordered as</p>
        <div style="display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; white-space: nowrap;">
          <span style="display: inline-flex; align-items: center; gap: 6px; font-size: 15px; font-weight: 800; color: #000;">
                <!-- Prehung SVG -->
                <img src="{{ 'prehung-icon.jpeg' | asset_url }}" alt="Prehung" style="height: 32px; width: auto; object-fit: contain; mix-blend-mode: multiply; filter: grayscale(100%) contrast(1.5) brightness(1.2);">
                PREHUNG
              </span>
              <span style="font-size: 15px; color: #000; font-weight: 300;">or</span>
              <span style="display: inline-flex; align-items: center; gap: 6px; font-size: 15px; font-weight: 800; color: #000;">
                <!-- Slab SVG -->
                <img src="{{ 'slab-icon.jpeg' | asset_url }}" alt="Slab" style="height: 32px; width: auto; object-fit: contain; mix-blend-mode: multiply; filter: grayscale(100%) contrast(1.5) brightness(1.2);">
            SLAB
          </span>
        </div>
      </div>
    </div>
    <div class="eto-collection-title-wrap">
      <h1 class="eto-collection-title">{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <div class="eto-collection-desc">{{ collection.description }}</div>
      {% endif %}
    </div>
    <div class="eto-collection-right">
      Can't Find What You're Looking For?
      <strong>We have it!!!</strong><br>
      Call Our Door Professionals
      <strong>(213) 622-2003</strong>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ETO Collection Hero",
  "settings": [],
  "presets": [
    {
      "name": "ETO Collection Hero"
    }
  ]
}
{% endschema %}

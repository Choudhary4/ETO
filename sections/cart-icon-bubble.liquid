{%- liquid
  assign real_count = 0
  for item in cart.items
    if item.properties._is_addon == 'true'
      continue
    endif
    assign real_count = real_count | plus: item.quantity
  endfor
-%}

{% if cart == empty %}
  <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
{% else %}
  <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
{% endif %}

<span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
{%- if real_count > 0 -%}
  <div class="cart-count-bubble">
    {%- if real_count < 100 -%}
      <span aria-hidden="true">{{ real_count }}</span>
    {%- else -%}
      <span aria-hidden="true">99+</span>
    {%- endif -%}
    <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: real_count }}</span>
  </div>
{%- endif -%}


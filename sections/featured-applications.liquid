{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: 60px;
    padding-bottom: 60px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: 80px;
      padding-bottom: 80px;
    }
  }

  .eto-apps-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 24px;
    max-width: var(--eto-container-max);
    margin: 0 auto;
    padding: 0 var(--eto-margin-edge);
  }

  @media screen and (min-width: 750px) {
    .eto-apps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (min-width: 1200px) {
    .eto-apps-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    }
  }

  .eto-app-card {
    background: var(--eto-soft-white);
    overflow: hidden;
    transition: transform 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
    border: none;
    border-radius: 0;
  }

  .eto-app-card:hover {
    transform: translateY(-4px);
  }

  .eto-app-image-wrapper {
    position: relative;
    padding-bottom: 80%;
    overflow: hidden;
    background: var(--eto-light-beige);
    display: block;
    margin-bottom: 16px;
    border-radius: 0;
  }

  .eto-app-image {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .eto-app-card:hover .eto-app-image {
    transform: scale(1.05);
  }

  .eto-app-content {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    text-align: left;
    padding: 0 4px;
  }

  .eto-app-title {
    font-family: 'EB Garamond', serif;
    font-size: 20px;
    font-weight: 400;
    color: var(--eto-dark-charcoal);
    margin: 0 0 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--eto-light-border);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1.3;
  }

  .eto-app-title a {
    color: inherit;
    text-decoration: none;
  }

  .eto-app-text {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 14px;
    color: var(--eto-soft-gray);
    margin-bottom: 20px;
    line-height: 1.6;
    flex-grow: 1;
    font-weight: 400;
  }

  .eto-app-button {
    display: inline-block;
    background: var(--eto-beige-btn);
    color: var(--eto-dark-charcoal);
    padding: 12px 28px;
    text-decoration: none;
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 600;
    font-size: 12px;
    border-radius: 0;
    text-align: center;
    transition: background 0.2s;
    width: fit-content;
    margin: 0 auto;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .eto-app-button:hover {
    background: var(--eto-beige-hover);
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- comment -%} Title removed {%- endcomment -%}

    <div class="eto-apps-grid">
      {%- for block in section.blocks -%}
        <div class="eto-app-card" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link }}" class="eto-app-image-wrapper">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: class: 'eto-app-image', loading: 'lazy' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'eto-app-image' }}
            {%- endif -%}
          </a>
          <div class="eto-app-content">
              <h3 class="eto-app-title">
                  <a href="{{ block.settings.link }}">
                      {{ block.settings.title }}
                  </a>
              </h3>
              <div class="eto-app-text">{{ block.settings.text }}</div>
              <a href="{{ block.settings.link }}" class="eto-app-button">{{ block.settings.link_label }}</a>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>


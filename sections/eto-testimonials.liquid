<script>
  document.addEventListener('DOMContentLoaded', function() {
    const fallbackSrc = 'data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0iI2NjYyI+PHBhdGggZD0iTTEyIDEyYzIuMjEgMCA0LTEuNzkgNC00cy0xLjc5LTQtNC00LTQgMS43OS00IDQgMS43OSA0IDQgNHptMCAyYy0yLjY3IDAtOCAxLjM0LTggNHYyaDE2di0yYzAtMi42Ni01LjMzLTQtOC00eiIvPjwvc3ZnPg==';
    const avatars = document.querySelectorAll('.eto-review-avatar');
    avatars.forEach(img => {
      // Apply background styling to make the SVG look better
      img.style.backgroundColor = '#f0f0f0';
      img.style.objectFit = 'contain';
      
      // If image fails to load
      img.addEventListener('error', function() {
        this.src = fallbackSrc;
      });
      
      // If it already failed before script executed
      if (img.complete && img.naturalHeight === 0) {
        img.src = fallbackSrc;
      }
    });
  });
</script>

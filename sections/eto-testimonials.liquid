<style>
  .eto-testimonials-page {
    font-family: Verdana, Geneva, sans-serif;
    color: #333;
  }
  
  .eto-testimonials-breadcrumb {
    font-size: 12px;
    padding: 15px 20px;
    max-width: var(--eto-container-max);
    margin: 0 auto;
  }
  
  .eto-testimonials-breadcrumb a {
    color: #333;
    text-decoration: none;
  }
  
  .eto-testimonials-wrapper {
    display: flex;
    max-width: var(--eto-container-max);
    margin: 0 auto;
    padding: 0 20px 40px;
    gap: 30px;
  }
  
  .eto-testimonials-main {
    flex: 1;
  }
  
  .eto-testimonials-title {
    font-size: 24px;
    font-weight: normal;
    margin: 0 0 20px;
  }
  
  .eto-testimonials-videos {
    display: flex;
    gap: 20px;
    margin-bottom: 30px;
  }
  
  .eto-testimonials-video {
    flex: 1;
    position: relative;
    padding-bottom: 28%;
    height: 0;
  }
  
  .eto-testimonials-video iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  
  .eto-testimonials-intro {
    margin-bottom: 30px;
  }
  
  .eto-testimonials-intro h2 {
    font-size: 16px;
    font-weight: normal;
    text-align: center;
    margin: 0 0 10px;
  }
  
  .eto-testimonials-intro p {
    font-size: 12px;
    line-height: 1.6;
    margin-bottom: 15px;
  }
  
  .eto-reviews-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  
  .eto-review-card {
    background: #f2f9ff;
    padding: 15px;

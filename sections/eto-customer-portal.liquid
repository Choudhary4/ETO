        {%- comment -%} Expose customer metafield as JS var for dynamic rendering {%- endcomment -%}
        <script>
          var _shopifyCustomerNote = {% if customer and customer.metafields.custom.zoho_estimates_json.value != blank %}{{ customer.metafields.custom.zoho_estimates_json.value | json }}{% else %}null{% endif %};
          {%- assign shopify_order_names = '' -%}

          <a href="/pages/contact?customer_id={{ customer.id }}&customer_email={{ customer.email | url_encode }}&source=b2b_portal" class="eto-action-btn eto-btn-primary eto-fast-quote-link" style="text-decoration: none; display: inline-flex; align-items: center;">
            + Request Custom Quote

          {%- if customer and customer.metafields.custom.zoho_invoices_json != blank -%}
            <!-- Will be dynamically populated by real JSON metafield if present -->
          {%- else -%}
            <div class="eto-empty-state">
              <div class="eto-empty-icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" style="color: var(--eto-text-muted)"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"></path><path d="M16 14h-6"></path><path d="M16 18h-6"></path><path d="M16 10h-2"></path></svg></div>
              <div class="eto-empty-title">No Outstanding Invoices</div>

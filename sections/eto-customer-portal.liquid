<!-- Interactive Toast Notification Element -->
<div id="eto-toast">
  <span>🔔</span>
  <span id="eto-toast-msg">Notification message</span>
</div>

<script>
  function getZohoIdFromUrl(url) {
    if (!url) return '';
    var match = url.match(/\/v3\/[^\/]+\/(\d+)/);
    return match ? match[1] : '';
  }
  function switchEtoTab(evt, tabId) {
    var panes = document.getElementsByClassName("eto-tab-pane");
    for (var i = 0; i < panes.length; i++) {
      panes[i].classList.remove("active");
    }

    var btns = document.getElementsByClassName("eto-tab-btn");
    for (var i = 0; i < btns.length; i++) {
      btns[i].classList.remove("active");
    }

    document.getElementById(tabId).classList.add("active");
    evt.currentTarget.classList.add("active");
  }

  function showEtoToast(message) {
    var toast = document.getElementById("eto-toast");
    var msgSpan = document.getElementById("eto-toast-msg");
    msgSpan.textContent = message;
    toast.classList.add("show");
    setTimeout(function(){
      toast.classList.remove("show");
    }, 4000);
  }

  // Dynamic API Fetcher for real Zoho Books data via Zoho Flow Middleware
  function fetchZohoData(type) {
    showEtoToast("⏳ Querying live Zoho Books API for " + (type || "account data") + "...");
    
    var customerId = "{{ customer.id }}";
    var customerEmail = "{{ customer.email }}";
    
    if (!customerId || customerId == "") {
      console.warn("No logged-in Shopify customer. Zoho API sync aborted.");
      return;
    }
    
    // Hardcoded permanent live Zoho Flow Webhook URL (Bypassing theme settings cache)
    var webhookUrl = "https://flow.zoho.com/711957929/flow/webhook/incoming?zapikey=1001.38b0a36526c213a9c23c4a4db65d43d4.867243e72856498b644b4b7b1b55edc2&isdebug=false";
    
    var fullUrl = webhookUrl + (webhookUrl.indexOf("?") !== -1 ? "&" : "?") + "customerId=" + customerId + "&email=" + encodeURIComponent(customerEmail);
    
    // Using mode: 'no-cors' so browser doesn't block the background webhook call
    fetch(fullUrl, { mode: 'no-cors' })
      .then(function(res) {
        // no-cors mode gives an opaque response (status 0), which is fine for triggering
        return "Webhook triggered in background";
      })
      .then(function(text) {
        console.log("Zoho Books API Raw Response:", text);
        
        var data = {};
        try {
          if (text && text.trim() !== "") {
            var parsed = JSON.parse(text);
            // If Zoho Flow returns direct array, wrap it
            if (Array.isArray(parsed)) {
              data = { estimates: parsed, invoices: [] };
            } else {
              data = parsed;
            }
          }
        } catch(e) {
          console.warn("Could not parse webhook response JSON:", e);
        }
        
        // Always read from secure customer Metafield (Zoho Flow pushes here asynchronously)
        var noteRaw = {% if customer and customer.metafields.custom.zoho_estimates_json.value != blank %}{{ customer.metafields.custom.zoho_estimates_json.value | json }}{% else %}null{% endif %};
        if (noteRaw) {
          try {
            var noteObj = (typeof noteRaw === 'string') ? JSON.parse(noteRaw) : noteRaw;
            // Note can be: array of estimates, or {estimates:[...], invoices:[...]}
            if (Array.isArray(noteObj)) {
              // Array means it's estimates list directly
              if (!data.estimates || data.estimates.length === 0) {
                data.estimates = noteObj;
              }
            } else if (typeof noteObj === 'object') {
              if ((!data.estimates || data.estimates.length === 0) && noteObj.estimates) {
                data.estimates = noteObj.estimates;
              }
              if ((!data.invoices || data.invoices.length === 0) && noteObj.invoices) {
                data.invoices = noteObj.invoices;
              }
              if ((!data.salesorders || data.salesorders.length === 0) && noteObj.salesorders) {
                data.salesorders = noteObj.salesorders;
              }
              if ((!data.payments || data.payments.length === 0) && noteObj.payments) {
                data.payments = noteObj.payments;
              }
            }
          } catch(err) { console.warn("Note parse error:", err); }
        }
        
        if (data.estimates && data.estimates.length > 0) {
          showEtoToast("✅ Zoho Books data synced! " + data.estimates.length + " estimate(s) found.");
        } else {
          showEtoToast("🔄 Sync triggered! Refresh in 5 seconds for latest data.");
        }
        
        // 1. Populate Estimates Table
        var estContainer = document.getElementById("estimates-table-container");
        if (estContainer && data.estimates) {
          if (data.estimates.length > 0) {
            var estHtml = '<div class="eto-table-responsive"><table class="eto-table"><thead><tr>' +
              '<th>Estimate #</th><th>Date</th><th>Total Amount</th><th>Status</th><th>Actions</th></tr></thead><tbody>';
            data.estimates.forEach(function(est) {
              estHtml += '<tr>' +
                '<td><strong>' + (est.estimate_number || 'EST-N/A') + '</strong></td>' +
                '<td>' + (est.date || 'N/A') + '</td>' +
                '<td><strong>$' + parseFloat(est.total || 0).toFixed(2) + '</strong></td>' +
                '<td><span class="eto-badge ' + (est.status == 'accepted' ? 'paid' : 'pending') + '">' + (est.status || 'pending').toUpperCase() + '</span></td>' +
                '<td><a href="' + (getZohoIdFromUrl(est.pdf_url) ? 'https://eto-pdf-proxy.aaron-3b7.workers.dev/?type=estimates&id=' + getZohoIdFromUrl(est.pdf_url) : '#') + '" target="_blank" class="eto-action-btn eto-btn-outline" style="padding:4px 8px; font-size:12px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px; vertical-align: text-bottom;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg> Download PDF</a></td>' +
                '</tr>';
            });
            estHtml += '</tbody></table></div>';
            estContainer.innerHTML = estHtml;
            var badgeEst = document.getElementById("tab-badge-estimates");
            if(badgeEst) badgeEst.textContent = data.estimates.length;
            var kpiQuotes = document.getElementById("kpi-quotes-count");
            if(kpiQuotes) kpiQuotes.textContent = data.estimates.length + " Quotes";
          } else {
            estContainer.innerHTML = '<div class="eto-empty-state"><div class="eto-empty-icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" style="color: var(--eto-text-muted)"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg></div><div class="eto-empty-title">No Active Estimates</div><div class="eto-empty-text">There are currently no open architectural estimates or custom quotes in Zoho Books.</div><button class="eto-action-btn eto-btn-outline" onclick="fetchZohoData(\'estimates\')"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px; vertical-align:text-bottom;"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg> Check Live Zoho API</button></div>';
          }
        }

        // Clean Numbering for Top Table (Shopify Orders)
        if (data.salesorders && data.salesorders.length > 0) {
          var badges = document.querySelectorAll(".zoho-so-badge");
          badges.forEach(function(badge) {
            var soId = badge.getAttribute("data-zoho-so-id");
            if (soId) {
              var matched = data.salesorders.find(function(so) {
                var extractedId = getZohoIdFromUrl(so.pdf_url) || so.salesorder_id || so.id || '';
                return (extractedId && extractedId.toString() === soId.toString()) ||
                       (so.salesorder_number && so.salesorder_number.toString() === soId.toString());
              });
              if (matched && matched.salesorder_number) {
                var cleanNum = matched.salesorder_number.toString();
                if (!cleanNum.toUpperCase().startsWith("SO-")) {
                  cleanNum = "SO-" + cleanNum;
                }
                badge.textContent = cleanNum;
              }
            }
          });
        }

        // 1.5 Populate Sales Orders Table
        var soContainer = document.getElementById("salesorders-table-container");
        if (soContainer && data.salesorders) {
          var customSalesOrders = data.salesorders.filter(function(so) {
            var cleanZohoNum = (so.salesorder_number || '').toString().replace(/^#/, '');
            var isShopify = _existingShopifyOrders.some(function(shopOrder) {
              return shopOrder.toString().replace(/^#/, '') === cleanZohoNum;
            });
            return !isShopify;
          });
          if (customSalesOrders.length > 0) {
            var soHtml = '<div class="eto-table-responsive"><table class="eto-table"><thead><tr>' +
              '<th>Sales Order #</th><th>Date</th><th>Total Amount</th><th>Status</th><th>Actions</th></tr></thead><tbody>';
            customSalesOrders.forEach(function(so) {
              soHtml += '<tr>' +
                '<td><strong>' + (so.salesorder_number || 'SO-N/A') + '</strong></td>' +
                '<td>' + (so.date || 'N/A') + '</td>' +
                '<td><strong>$' + parseFloat(so.total || 0).toFixed(2) + '</strong></td>' +
                '<td><span class="eto-badge pending">' + (so.status || 'open').toUpperCase() + '</span></td>' +
                '<td><a href="' + (getZohoIdFromUrl(so.pdf_url) ? 'https://eto-pdf-proxy.aaron-3b7.workers.dev/?type=salesorders&id=' + getZohoIdFromUrl(so.pdf_url) : '#') + '" target="_blank" class="eto-action-btn eto-btn-outline" style="padding:4px 8px; font-size:12px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px; vertical-align: text-bottom;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg> Download PDF</a></td>' +
                '</tr>';
            });
            soHtml += '</tbody></table></div>';
            soContainer.innerHTML = soHtml;
            
            var soCount = customSalesOrders.length;
            var tabOrders = document.getElementById("tab-badge-orders");
            if (tabOrders) {
                var sCount = parseInt(tabOrders.getAttribute("data-shopify-count") || "0");
                tabOrders.textContent = sCount + soCount;
            }
            var kpiOrders = document.getElementById("kpi-orders-count");
            if (kpiOrders) {
                var sCount = parseInt(kpiOrders.getAttribute("data-shopify-count") || "0");
                kpiOrders.textContent = (sCount + soCount) + " Orders";
            }
            
            var sCard = document.getElementById("shopify-orders-card");
            if (sCard && sCard.getAttribute("data-empty") === "true") {
                sCard.style.display = "none";
            }
            
          } else {
            soContainer.innerHTML = '<div class="eto-empty-state" style="padding:30px;"><div class="eto-empty-text">No custom Sales Orders found in Zoho Books.</div></div>';
          }
        }

        // 2. Populate Invoices Table
        var invContainer = document.getElementById("invoices-table-container");
        if (invContainer && data.invoices) {
          if (data.invoices.length > 0) {
            var invHtml = '<div class="eto-table-responsive"><table class="eto-table"><thead><tr>' +
              '<th>Invoice #</th><th>Date</th><th>Total Amount</th><th>Balance Due</th><th>Status</th><th>Actions</th></tr></thead><tbody>';
            data.invoices.forEach(function(inv) {
              invHtml += '<tr>' +
                '<td><strong>' + (inv.invoice_number || 'INV-N/A') + '</strong></td>' +
                '<td>' + (inv.date || 'N/A') + '</td>' +
                '<td><strong>$' + parseFloat(inv.total || 0).toFixed(2) + '</strong></td>' +
                '<td style="color:var(--eto-primary); font-weight:700;">$' + parseFloat(inv.balance || 0).toFixed(2) + '</td>' +
                '<td><span class="eto-badge ' + (inv.status == 'paid' ? 'paid' : 'overdue') + '">' + (inv.status || 'unpaid').toUpperCase() + '</span></td>' +
                '<td><a href="' + (getZohoIdFromUrl(inv.pdf_url) ? 'https://eto-pdf-proxy.aaron-3b7.workers.dev/?type=invoices&id=' + getZohoIdFromUrl(inv.pdf_url) : '#') + '" target="_blank" class="eto-action-btn eto-btn-outline" style="padding:4px 8px; font-size:12px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px; vertical-align: text-bottom;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg> Download PDF</a></td>' +
                '</tr>';
            });
            invHtml += '</tbody></table></div>';
            invContainer.innerHTML = invHtml;
            var badgeInv = document.getElementById("tab-badge-invoices");
            if(badgeInv) badgeInv.textContent = data.invoices.length;
          } else {
            invContainer.innerHTML = '<div class="eto-empty-state"><div class="eto-empty-icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" style="color: var(--eto-text-muted)"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"></path><path d="M16 14h-6"></path><path d="M16 18h-6"></path><path d="M16 10h-2"></path></svg></div><div class="eto-empty-title">No Outstanding Invoices</div><div class="eto-empty-text">Your financial ledger is clean! You have no unpaid invoices in Zoho Books.</div><button class="eto-action-btn eto-btn-outline" onclick="fetchZohoData(\'invoices\')"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px; vertical-align:text-bottom;"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg> Check Live Zoho API</button></div>';
          }
        }

        // 3. Populate Payments Table
        var payContainer = document.getElementById("payments-table-container");
        if (payContainer && data.payments) {
          if (data.payments.length > 0) {
            var payHtml = '<div class="eto-table-responsive"><table class="eto-table"><thead><tr>' +
              '<th>Payment #</th><th>Date</th><th>Amount</th><th>Mode</th><th>Receipt</th></tr></thead><tbody>';
            data.payments.forEach(function(pay) {
              payHtml += '<tr>' +
                '<td><strong>' + (pay.payment_number || 'PAY-N/A') + '</strong></td>' +
                '<td>' + (pay.date || 'N/A') + '</td>' +
                '<td><strong>$' + parseFloat(pay.amount || 0).toFixed(2) + '</strong></td>' +
                '<td><span class="eto-badge paid">' + (pay.payment_mode || 'Cash').toUpperCase() + '</span></td>' +
                '<td><a href="' + (getZohoIdFromUrl(pay.pdf_url) ? 'https://eto-pdf-proxy.aaron-3b7.workers.dev/?type=customerpayments&id=' + getZohoIdFromUrl(pay.pdf_url) : '#') + '" target="_blank" class="eto-action-btn eto-btn-outline" style="padding:4px 8px; font-size:12px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px; vertical-align: text-bottom;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg> Download Receipt</a></td>' +
                '</tr>';
            });
            payHtml += '</tbody></table></div>';
            payContainer.innerHTML = payHtml;
          } else {
            payContainer.innerHTML = '<div class="eto-empty-state" style="padding:30px;"><div class="eto-empty-text">No previous payments found in Zoho Books.</div></div>';
          }
        }
      })
      .catch(function(err) {
        console.log("Webhook async mode - reading from Shopify customer note.");
        // Zoho Flow webhook is async - read from customer.note instead
        var noteRaw = {% if customer and customer.note != blank %}{{ customer.note | json }}{% else %}null{% endif %};
        if (noteRaw) {
          try {
            var noteObj = (typeof noteRaw === 'string') ? JSON.parse(noteRaw) : noteRaw;
            var estimates = Array.isArray(noteObj) ? noteObj : (noteObj.estimates || []);
            if (estimates.length > 0) {
              var estContainer = document.getElementById('estimates-table-container');
              if (estContainer) {
                var estHtml = '<div class="eto-table-responsive"><table class="eto-table"><thead><tr><th>Estimate #</th><th>Date</th><th>Total Amount</th><th>Status</th><th>Actions</th></tr></thead><tbody>';
                estimates.forEach(function(est) {
                  estHtml += '<tr><td><strong>' + (est.estimate_number||'N/A') + '</strong></td><td>' + (est.date||'N/A') + '</td><td><strong>$' + parseFloat(est.total||0).toFixed(2) + '</strong></td><td><span class="eto-badge ' + (est.status==='accepted'?'paid':'pending') + '">' + (est.status||'pending').toUpperCase() + '</span></td><td><a href="' + (getZohoIdFromUrl(est.pdf_url) ? 'https://eto-pdf-proxy.aaron-3b7.workers.dev/?type=estimates&id=' + getZohoIdFromUrl(est.pdf_url) : '#') + '" target="_blank" class="eto-action-btn eto-btn-outline" style="padding:4px 8px;font-size:12px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px; vertical-align: text-bottom;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg> Download PDF</a></td></tr>';
                });
                estHtml += '</tbody></table></div>';
                estContainer.innerHTML = estHtml;
                var badge = document.getElementById('tab-badge-estimates');
                if(badge) badge.textContent = estimates.length;
                var kpi = document.getElementById('kpi-quotes-count');
                if(kpi) kpi.textContent = estimates.length + ' Quotes';
                showEtoToast('✅ ' + estimates.length + ' estimate(s) loaded from Zoho Books!');
              }
            } else {
              showEtoToast('🔄 Sync in progress. Please refresh in a few seconds.');
            }
          } catch(e) { showEtoToast('🔄 Sync triggered. Please refresh in a few seconds.'); }
        } else {
          showEtoToast('🔄 Syncing with Zoho Books... Please refresh page in 5 seconds.');
        }
      });
  }

  // Render from customer.note immediately on page load (no webhook call needed!)
  function renderFromNote() {
    if (!_shopifyCustomerNote) return false;
    try {
      var noteObj = (typeof _shopifyCustomerNote === 'string') ? JSON.parse(_shopifyCustomerNote) : _shopifyCustomerNote;
      var estimates = Array.isArray(noteObj) ? noteObj : (noteObj.estimates || []);
      var invoices = Array.isArray(noteObj) ? [] : (noteObj.invoices || []);
      
      if (estimates.length > 0) {
        var estContainer = document.getElementById('estimates-table-container');
        if (estContainer) {
          var estHtml = '<div class="eto-table-responsive"><table class="eto-table"><thead><tr><th>Estimate #</th><th>Date</th><th>Total Amount</th><th>Status</th><th>Actions</th></tr></thead><tbody>';
          estimates.forEach(function(est) {
            var statusClass = est.status === 'accepted' ? 'paid' : (est.status === 'sent' ? 'pending' : 'overdue');
            estHtml += '<tr><td><strong>' + (est.estimate_number||'N/A') + '</strong></td>' +
              '<td>' + (est.date||'N/A') + '</td>' +
              '<td><strong>$' + parseFloat(est.total||0).toFixed(2) + '</strong></td>' +
              '<td><span class="eto-badge ' + statusClass + '">' + (est.status||'pending').toUpperCase() + '</span></td>' +
              '<td><a href="' + (getZohoIdFromUrl(est.pdf_url) ? 'https://eto-pdf-proxy.aaron-3b7.workers.dev/?type=estimates&id=' + getZohoIdFromUrl(est.pdf_url) : '#') + '" target="_blank" class="eto-action-btn eto-btn-outline" style="padding:4px 8px;font-size:12px;">📄 PDF</a></td></tr>';
          });
          estHtml += '</tbody></table></div>';
          estContainer.innerHTML = estHtml;
          var badge = document.getElementById('tab-badge-estimates');
          if(badge) badge.textContent = estimates.length;
          var kpi = document.getElementById('kpi-quotes-count');
          if(kpi) kpi.textContent = estimates.length + ' Quote' + (estimates.length > 1 ? 's' : '');
        }
        
        if (invoices.length > 0) {
          var totalBalance = 0;
          var invContainer = document.getElementById('invoices-table-container');
          if (invContainer) {
            var invHtml = '<div class="eto-table-responsive"><table class="eto-table"><thead><tr><th>Invoice #</th><th>Date</th><th>Total Amount</th><th>Balance Due</th><th>Status</th><th>Actions</th></tr></thead><tbody>';
            invoices.forEach(function(inv) {
              var bal = parseFloat(inv.balance||0);
              totalBalance += bal;
              var statusClass = inv.status === 'paid' ? 'paid' : (inv.status === 'sent' ? 'pending' : 'overdue');
              invHtml += '<tr><td><strong>' + (inv.invoice_number||'N/A') + '</strong></td>' +
                '<td>' + (inv.date||'N/A') + '</td>' +
                '<td><strong>$' + parseFloat(inv.total||0).toFixed(2) + '</strong></td>' +
                '<td style="color:var(--eto-primary); font-weight:700;">$' + bal.toFixed(2) + '</td>' +
                '<td><span class="eto-badge ' + statusClass + '">' + (inv.status||'unpaid').toUpperCase() + '</span></td>' +
                '<td><a href="' + (getZohoIdFromUrl(inv.pdf_url) ? 'https://eto-pdf-proxy.aaron-3b7.workers.dev/?type=invoices&id=' + getZohoIdFromUrl(inv.pdf_url) : '#') + '" target="_blank" class="eto-action-btn eto-btn-outline" style="padding:4px 8px;font-size:12px;">📄 PDF</a></td></tr>';
            });
            invHtml += '</tbody></table></div>';
            invContainer.innerHTML = invHtml;
            var badge = document.getElementById('tab-badge-invoices');
            if(badge) badge.textContent = invoices.length;
          }
          
          // Update KPI and tab balances
          var formattedBal = '$' + totalBalance.toFixed(2);
          var kpiBal = document.getElementById('kpi-outstanding-balance');
          if (kpiBal) kpiBal.textContent = formattedBal;
          var kpiBadge = document.getElementById('kpi-outstanding-badge');
          if (kpiBadge) {
            kpiBadge.textContent = totalBalance > 0 ? 'Payment Due in Books' : 'No Overdue Balance';
            kpiBadge.className = 'eto-badge ' + (totalBalance > 0 ? 'overdue' : 'accepted');
          }
          var tabBal = document.getElementById('tab-invoices-balance');
          if (tabBal) tabBal.textContent = 'Balance Due: ' + formattedBal;
          
          var payBtn = document.getElementById('btn-pay-outstanding');
          if (payBtn) {
            if (totalBalance > 0) {
              payBtn.setAttribute('onclick', "showEtoToast('Redirecting to secure B2B payment gateway for invoice settlement...')");
            } else {
              payBtn.setAttribute('onclick', "showEtoToast('No outstanding invoices pending payment.')");
            }
          }
        }
        
        return true;
      }
    } catch(e) { console.warn('Note render error:', e); }
    return false;
  }

  // Auto-fetch when page loads
  document.addEventListener("DOMContentLoaded", function() {
    // First: render immediately from customer.note (instant, no API call)
    var rendered = renderFromNote();
    // Then: background sync with Zoho Flow webhook (updates data for next load)
    fetchZohoData();
  });
</script>


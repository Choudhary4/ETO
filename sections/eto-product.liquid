/* Collapse empty &nbsp; paragraphs and excessive gaps from Magento HTML */
.eto-tab-pane p:empty,
.eto-tab-pane div:empty {
  display: none;
}
.eto-tab-pane p br:only-child {
  display: none;
}
.eto-tab-pane > div > p,
.eto-tab-pane > div > div {
  margin-top: 2px;
  margin-bottom: 4px;
}
.eto-tab-pane > div {
  /* Inherit fonts from .eto-tab-pane */
}
/* Tighten spacing on br-heavy Magento content */
.eto-tab-pane br + br {
  display: none;
}

/* Lead Time tab specific fixes */
#tab-leadtime .product-specs,
#tab-leadtime .product_tabs_custom4_contents,
#tab-leadtime > div {
  /* Inherit fonts from .eto-tab-pane */
}
#tab-leadtime p {
  margin: 0 0 8px 0 !important;
}
/* Hide &nbsp;-only paragraphs via max-height trick */
#tab-leadtime p:not(:has(strong)):not(:has(span)):not(:has(a)):not(:has(em)) {
  max-height: 0;
  overflow: hidden;
  margin: 0 !important;
  padding: 0 !important;
}
/* Ensure paragraphs with real content show */
#tab-leadtime p:has(strong),
#tab-leadtime p:has(span),
#tab-leadtime p:has(a),
#tab-leadtime p:has(em) {
  max-height: none;
  margin: 0 0 6px 0 !important;
}

/* Shipping info text improvement */
#tab-leadtime span[style*="text-decoration: underline"],
#tab-leadtime p:first-of-type {
  font-size: 14px;
}
#tab-leadtime span[style*="background-color"] {
  padding: 3px 8px !important;
  border-radius: 3px;
  display: inline-block;
  margin-bottom: 4px;
}
#tab-leadtime a:not(.eto-btn-green):not(.eto-fast-quote-link) {
  text-decoration: none !important;
  color: #000 !important;
  font-weight: bold;
}

/* Overview tab — collapse &nbsp;-only paragraphs */
#tab-overview p {
  margin: 0 0 12px 0;
}
#tab-overview p:empty {
  display: none;
}
#tab-overview div:empty {
  display: none;
}


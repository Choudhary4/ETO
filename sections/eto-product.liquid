<script>
var etoCurrentUnitPriceCents = {{ product.selected_or_first_available_variant.price }};

function etoUpdateTotalPrice() {
  var qtyInput = document.getElementById('eto-quantity');
  var qty = parseInt(qtyInput.value);
  if (isNaN(qty) || qty < 1) qty = 1;

  var totalCents = etoCurrentUnitPriceCents * qty;
  var dollars = (totalCents / 100).toFixed(2);
  // Using $ hardcoded as per site style, or could use Shopify.formatMoney if available
  var formattedPrice = '$' + dollars; 
  
  var priceEl = document.getElementById('eto-current-price');
  if (priceEl) priceEl.textContent = formattedPrice;
}

// Change main image on thumbnail click
function etoChangeImage(src, thumb) {
  document.getElementById('eto-featured-img').src = src;
  document.querySelectorAll('.eto-gallery-thumb').forEach(t => t.classList.remove('active'));
  thumb.classList.add('active');
}


// ============================
// DYNAMIC DOOR CONFIGURATOR
// Reads all options from product.metafields.custom.door_options JSON
// ============================

// Parse JSON data
let doorOptionsData = [];
let variantsData = [];
const doorJsonEl = document.getElementById('door-options-json');
const variantJsonEl = document.getElementById('variant-data-json');

try {
  if (doorJsonEl) {
    const raw = JSON.parse(doorJsonEl.textContent);
    doorOptionsData = typeof raw === 'string' ? JSON.parse(raw) : raw;
  }
  if (variantJsonEl) {
    variantsData = JSON.parse(variantJsonEl.textContent);
  }
} catch(e) {
  console.error('Door Configurator: JSON parse error', e);
}

// State tracking for all options
const etoConfigState = {};
let etoDoorConfig = ''; // 'single' or 'double'

// ── De-duplicate options (same title = context-dependent) ──
const etoOptionGroups = [];
const etoSeenTitles = {};

if (Array.isArray(doorOptionsData)) {
  doorOptionsData.forEach(opt => {
    if (!opt.title || opt.title === 'Your product is now configured') return;
    if (opt.type === 'field') return;
    
    const normalizedTitle = opt.title.trim().toLowerCase();
    
    if (etoSeenTitles[normalizedTitle] !== undefined) {
      const idx = etoSeenTitles[normalizedTitle];
      if (normalizedTitle === 'handing' || normalizedTitle === 'size') {
        etoOptionGroups[idx].doubleValues = opt.values || [];
      }
    } else {
      etoSeenTitles[normalizedTitle] = etoOptionGroups.length;
      etoOptionGroups.push({
        title: opt.title,
        normalizedTitle: normalizedTitle,
        type: opt.type,
        required: opt.required,
        order: opt.order,
        singleValues: opt.values || [],
        doubleValues: null
      });
    }
  });
  etoOptionGroups.sort((a, b) => a.order - b.order);
}

// (etoPopulateSizeGrid and etoMatchVariant removed - Size is now handled natively via Liquid variant loop)

// ── Build dynamic option rows (everything EXCEPT Size) ──
function etoBuildDynamicOptions() {
  const container = document.getElementById('eto-dynamic-options-container');
  if (!container) return;
  container.innerHTML = '';

  etoOptionGroups.forEach((group, index) => {
    if (group.title === 'Size') return; // Size is already in the grid above

    const rowDiv = document.createElement('div');
    rowDiv.className = 'eto-dynamic-option-row';
    rowDiv.id = 'eto-dynopt-' + index;
    rowDiv.style.display = 'none'; // Hidden until previous step is done

    // Label row
    const labelRow = document.createElement('div');
    labelRow.className = 'eto-config-row';

    const iconPlaceholder = document.createElement('div');
    iconPlaceholder.className = 'eto-config-icon-placeholder';
    
    let iconFilename = '';
    const groupTitleLow = group.title.toLowerCase();
    if (groupTitleLow.includes('door config') || groupTitleLow.includes('door type') || groupTitleLow.includes('configuration')) iconFilename = 'icon-1-door-configuration.png';
    else if (groupTitleLow.includes('pre hanging') || groupTitleLow.includes('pre-hanging')) iconFilename = 'icon-2-pre-hanging.png';
    else if (groupTitleLow.includes('jamb species')) iconFilename = 'icon-3-jamb-species.png';
    else if (groupTitleLow.includes('handing')) iconFilename = 'icon-4-handing.png';
    else if (groupTitleLow.includes('jamb width')) iconFilename = 'icon-5-jamb-width.png';
    else if (groupTitleLow.includes('hinge') || groupTitleLow.includes('hinges')) iconFilename = 'icon-6-hinge-finish.png';
    else if (groupTitleLow.includes('handle')) iconFilename = 'icon-7-handle-prep.png';
    
    if (iconFilename) {
      const baseAssetUrl = "{{ 'PLACEHOLDER' | asset_url }}";

/* ===== Product Image Lightbox ===== */
.eto-lightbox-overlay {
  display: none;
  position: fixed;
  z-index: 99999;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0, 0, 0, 0.7);
  align-items: center;
  justify-content: center;
}
.eto-lightbox-overlay.active {
  display: flex;
}
.eto-lightbox-modal {
  background: #fff;
  border-radius: 6px;
  width: 90%;
  max-width: 850px;
  max-height: 85vh;
  position: relative;
  display: flex;
  overflow: hidden;
  box-shadow: 0 8px 40px rgba(0,0,0,0.3);
}
.eto-lightbox-close {
  position: absolute;
  top: 10px;
  right: 15px;
  font-size: 13px;
  color: #555;
  cursor: pointer;
  z-index: 10;
  font-family: Arial, sans-serif;
  background: none;
  border: none;
  display: flex;
  align-items: center;
  gap: 4px;
}
.eto-lightbox-close:hover {
  color: #000;
}
.eto-lightbox-close svg {
  width: 14px;
  height: 14px;
}
.eto-lightbox-main-img {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30px;
  min-height: 400px;
  background: #fafafa;
}
.eto-lightbox-main-img img {
  max-width: 100%;
  max-height: 70vh;
  object-fit: contain;
}
.eto-lightbox-sidebar {
  width: 200px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 15px 20px;
  border-left: 1px solid #eee;
  overflow-y: auto;
}
.eto-lightbox-title {
  font-family: Arial, Helvetica, sans-serif;
  font-size: 13px;
  font-weight: 700;
  text-align: center;
  color: #333;
  margin-bottom: 15px;
  line-height: 1.4;
}
.eto-lightbox-thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  justify-content: center;
}
.eto-lightbox-thumb {
  width: 55px;
  height: 55px;
  border: 2px solid #ddd;
  cursor: pointer;
  overflow: hidden;
  border-radius: 2px;
}
.eto-lightbox-thumb.active {
  border-color: #e67e22;
}
.eto-lightbox-thumb img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
@media (max-width: 768px) {
  .eto-lightbox-modal {
    flex-direction: column;
    max-height: 90vh;
  }
  .eto-lightbox-sidebar {
    width: 100%;
    border-left: none;
    border-top: 1px solid #eee;
    padding: 15px;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }
  .eto-lightbox-title {
    width: 100%;
    margin-bottom: 8px;
  }
  .eto-lightbox-main-img {
    min-height: 250px;
    padding: 20px;
  }
  .eto-lightbox-main-img img {
    max-height: 40vh;
  }
}

/* Responsive */
@media (max-width: 1100px) {
  .eto-product-layout {
    grid-template-columns: 1fr 1fr;
  }
  .eto-gallery {
    grid-column: 1;
    grid-row: 1 / 3;
  }
  .eto-product-title {
    grid-column: 2;
    grid-row: 1;
  }
  .eto-size-section {
    grid-column: 2;
    grid-row: 2;
  }
  .eto-sidebar {
    grid-column: 1 / -1;
    grid-row: 3;
    position: static;
    max-width: 400px;
    margin: 0 auto;
  }
}

@media (max-width: 768px) {
  .eto-product-layout {
    display: flex;
    flex-direction: column;
  }
  .eto-product-title {
    order: 1;
    text-align: center;
  }
  .eto-gallery {
    order: 2;
  }
  .eto-size-section {
    order: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .eto-size-header {
    width: 100%;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
    text-align: center;
  }
  .eto-sidebar {
    order: 4;
    width: 100%;
    max-width: 320px;
    margin: 0 auto;
  }
  
  .eto-size-grid {
    grid-template-columns: repeat(2, 1fr);
    width: 100%;
    max-width: 350px;
    margin: 0 auto;
  }
  
  .eto-tabs-nav {
    flex-wrap: wrap;
  }
  
  .eto-tab-btn {
    flex: 1 1 50%;
    text-align: center;
  }
}


// ── Select a dynamic option ──
function etoSelectDynamicOption(groupIndex, value, el) {
  const group = etoOptionGroups.filter(g => g.title !== 'Size')[groupIndex - etoOptionGroups.findIndex(g => g.title !== 'Size')];
  
  // Find actual index in etoOptionGroups
  let actualIndex = -1;
  let nonSizeCount = 0;
  for (let i = 0; i < etoOptionGroups.length; i++) {
    if (etoOptionGroups[i].title === 'Size') continue;
    if (i === groupIndex) { actualIndex = i; break; }
  }

  const groupObj = etoOptionGroups[groupIndex];
  if (!groupObj) return;

  // Remove selection from siblings
  const listEl = document.getElementById('eto-dynopt-list-' + groupIndex);
  if (listEl) listEl.querySelectorAll('.eto-size-option').forEach(o => o.classList.remove('selected'));
  if (el) el.classList.add('selected');

  // Update label
  const label = document.getElementById('eto-dynopt-label-' + groupIndex);
  if (label) label.textContent = value;

  // Store state
  etoConfigState[groupObj.title] = value;

  // If this is "Door Configuration", update context-dependent options
  if (groupObj.title === 'Door Configuration') {
    etoDoorConfig = value === 'Double Door' ? 'double' : 'single';
    etoUpdateContextDependentOptions();
  }

  // Hide this option list, show EDIT button
  if (listEl) listEl.style.display = 'none';
  const editBtn = document.getElementById('eto-dynopt-edit-' + groupIndex);
  if (editBtn) editBtn.style.display = 'inline-block';

  // Show next option or show configured section
  etoShowNextOption(groupIndex);
  
  // Update price
  etoRecalculatePrice();
}

// ── Update context-dependent options when Door Config changes ──
function etoUpdateContextDependentOptions() {
  const isDouble = etoDoorConfig === 'double';
  etoOptionGroups.forEach((group, index) => {
    if (group.title === 'Size') return;
    if (group.doubleValues) {
      const values = isDouble ? group.doubleValues : group.singleValues;
      const listEl = document.getElementById('eto-dynopt-list-' + index);
      if (listEl) {
        etoPopulateDynamicOptionValues(listEl, values, index, group.title);
      }
      // Reset this option's state
      delete etoConfigState[group.title];
      const label = document.getElementById('eto-dynopt-label-' + index);
      if (label) label.textContent = 'Not Selected';
    }
  });
}

// ── Show next available option step ──
function etoShowNextOption(currentGroupIndex) {
  // Check if Pre-hanging was declined
  let prehangDeclined = false;
  let prehangIndex = -1;
  const prehangKey = Object.keys(etoConfigState).find(k => k.toLowerCase() === 'pre hanging');
  if (prehangKey && etoConfigState[prehangKey] && etoConfigState[prehangKey].includes('No (Door Only)')) {
    prehangDeclined = true;
  }
  
  // Find the exact index of the Pre-hanging option so we only skip options AFTER it
  for (let i = 0; i < etoOptionGroups.length; i++) {
     if (etoOptionGroups[i].title.toLowerCase() === 'pre hanging') {
         prehangIndex = i;
         break;
     }
  }

  // Find next valid option index after current
  let found = false;
  for (let i = 0; i < etoOptionGroups.length; i++) {
    const groupTitle = etoOptionGroups[i].title;
    if (groupTitle === 'Size') continue;
    if (i <= currentGroupIndex) continue;
    
    // If pre-hanging is NO, skip ALL options that come after Pre-hanging
    if (prehangDeclined && prehangIndex !== -1 && i > prehangIndex) {
      // Ensure it stays hidden and state is cleared
      const rowEl = document.getElementById('eto-dynopt-' + i);
      if (rowEl) rowEl.style.display = 'none';
      delete etoConfigState[groupTitle];
      continue;
    }
    
    // If we land here, this is a valid option that SHOULD be shown
    const rowEl = document.getElementById('eto-dynopt-' + i);
    if (rowEl) {
      rowEl.style.display = 'block';
      
      // Also ensure its corresponding list is visible so the user can interact
      const listEl = document.getElementById('eto-dynopt-list-' + i);
      if (listEl) listEl.style.display = '';
      
      // Ensure the EDIT button is hidden initially
      const editBtn = document.getElementById('eto-dynopt-edit-' + i);
      if (editBtn) editBtn.style.display = 'none';
      
      found = true;
      break;
    }
  }

  // Hide the configured section by default until we prove everything is done
  const configuredSection = document.getElementById('eto-configured-section');
  const notesContainer = document.getElementById('eto-notes-container');
  if (configuredSection) {
      if (!found) {
        // All non-skipped options are done, show configured section
        configuredSection.style.display = 'block';
        if (notesContainer) notesContainer.style.display = 'block';
      } else {
        configuredSection.style.display = 'none';
        if (notesContainer) notesContainer.style.display = 'none';
      }
  }
}

// ── Edit a dynamic option ──
function etoEditDynamicOption(groupIndex) {
  const listEl = document.getElementById('eto-dynopt-list-' + groupIndex);
  const editBtn = document.getElementById('eto-dynopt-edit-' + groupIndex);
  if (listEl) listEl.style.display = '';
  if (editBtn) editBtn.style.display = 'none';

  // Reset state for THIS option too (so its cost is removed from price)
  delete etoConfigState[etoOptionGroups[groupIndex].title];
  const thisLabel = document.getElementById('eto-dynopt-label-' + groupIndex);
  if (thisLabel) thisLabel.textContent = 'Not Selected';

  // Also deselect any visually selected item in this list
  if (listEl) listEl.querySelectorAll('.eto-config-option.selected, .eto-size-option.selected').forEach(el => el.classList.remove('selected'));

  // Hide all options after this one and reset their state too
  for (let i = groupIndex + 1; i < etoOptionGroups.length; i++) {
    if (etoOptionGroups[i].title === 'Size') continue;
    const rowEl = document.getElementById('eto-dynopt-' + i);
    if (rowEl) rowEl.style.display = 'none';
    // Reset state
    delete etoConfigState[etoOptionGroups[i].title];
    const label = document.getElementById('eto-dynopt-label-' + i);
    if (label) label.textContent = 'Not Selected';
    const eb = document.getElementById('eto-dynopt-edit-' + i);
    if (eb) eb.style.display = 'none';
    const list = document.getElementById('eto-dynopt-list-' + i);
    if (list) list.style.display = '';
  }

  // Hide configured section
  const configuredSection = document.getElementById('eto-configured-section');
  if (configuredSection) configuredSection.style.display = 'none';
  const notesContainer = document.getElementById('eto-notes-container');
  if (notesContainer) notesContainer.style.display = 'none';

  // ← IMPORTANT: recalculate price after clearing selections
  etoRecalculatePrice();
}

// ── Recalculate total price ──
var etoAddonCents = 0; // Track add-on cost separately for cart submit

function etoRecalculatePrice() {
  let addons = 0;
  
  // Check if Pre-hanging was declined
  let prehangDeclined = false;
  let prehangIndex = -1;
  const prehangKey = Object.keys(etoConfigState).find(k => k.toLowerCase() === 'pre hanging');
  if (prehangKey && etoConfigState[prehangKey] && etoConfigState[prehangKey].includes('No (Door Only)')) {
    prehangDeclined = true;
  }
  
  // Find the exact index of the Pre-hanging option so we only skip options AFTER it
  for (let i = 0; i < etoOptionGroups.length; i++) {
     if (etoOptionGroups[i].title.toLowerCase() === 'pre hanging') {
         prehangIndex = i;
         break;
     }
  }

  etoOptionGroups.forEach((group, index) => {
    if (group.title === 'Size') return; // Size is handled by variant selection
    
    // Skip price addition for any option that comes AFTER Pre-hanging if declined
    if (prehangDeclined && prehangIndex !== -1 && index > prehangIndex) {
        return;
    }
    
    const selectedValue = etoConfigState[group.title];
    if (!selectedValue) return;

    const isDouble = etoDoorConfig === 'double';
    const values = (group.doubleValues && isDouble) ? group.doubleValues : group.singleValues;
    const matched = values.find(v => v.title === selectedValue);
    if (matched && parseFloat(matched.price) > 0) {
      addons += parseFloat(matched.price);
    }
  });

  // Store add-on cents globally so etoAddToCart can use it
  etoAddonCents = Math.round(addons * 100);

  // etoCurrentUnitPriceCents is the base size price (set by etoSelectVariant)
  const totalCents = etoCurrentUnitPriceCents + etoAddonCents;
  const totalFormatted = '$' + (totalCents / 100).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});
  
  const priceEl = document.getElementById('eto-current-price');
  if (priceEl) priceEl.textContent = totalFormatted;
}

// ── Select Variant (Size) ──
function etoSelectVariant(el) {
  const variantId = el.dataset.variantId;
  const price = el.dataset.price;
  const priceCents = parseInt(el.dataset.priceCents);
  const title = el.dataset.title;

  document.querySelectorAll('.eto-size-option').forEach(opt => opt.classList.remove('selected'));
  el.classList.add('selected');
  document.getElementById('eto-selected-size').textContent = title + ' = ' + price;
  
  const boxSelected = document.getElementById('boxSelected');
  if(boxSelected) {
    boxSelected.textContent = title + ' selected';
  }
  
  if(!isNaN(priceCents)) {
    etoCurrentUnitPriceCents = priceCents;
    etoUpdateTotalPrice();
  } else {
    document.getElementById('eto-current-price').textContent = price;
  }
  
  if (variantId) {
    document.getElementById('eto-variant-id').value = variantId;
  }

  // Hide size grid, show EDIT button for size
  const sizeGrid = document.getElementById('eto-size-grid');
  const sizeEditBtn = document.getElementById('eto-size-edit-btn');
  if (sizeGrid) sizeGrid.style.display = 'none';
  if (sizeEditBtn) sizeEditBtn.style.display = 'inline-block';

  // Show config container and first dynamic option
  const configContainer = document.getElementById('eto-config-container');
  if (configContainer) {
    configContainer.style.display = 'block';
  }

  // Show the first non-Size option
  for (let i = 0; i < etoOptionGroups.length; i++) {
    if (etoOptionGroups[i].title === 'Size') continue;
    const rowEl = document.getElementById('eto-dynopt-' + i);
    if (rowEl) {
      rowEl.style.display = 'block';
      break;
    }
  }
}

// Edit size - show size grid again
function etoEditSize() {

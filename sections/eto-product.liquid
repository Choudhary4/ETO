// Image Zoom Script
document.addEventListener('DOMContentLoaded', function() {
  var img = document.getElementById('eto-featured-img');
  var result = document.getElementById('eto-zoom-result');
  var lens = document.getElementById('eto-zoom-lens');
  var container = document.getElementById('eto-main-image-container');

  if (!img || !result || !lens || !container) return; // Exit if elements missing

  // Show zoom on hover
  container.addEventListener('mouseenter', function() {
    lens.style.display = 'block';
    result.style.display = 'block';
    updateZoomBackground();
  });

  // Hide zoom on leave
  container.addEventListener('mouseleave', function() {
    lens.style.display = 'none';
    result.style.display = 'none';
  });

  // Calculate and move lens
  function moveLens(e) {
    e.preventDefault();
    
    // Ensure ratios are calculated
    var cx = result.offsetWidth / lens.offsetWidth;
    var cy = result.offsetHeight / lens.offsetHeight;
    
    var pos = getCursorPos(e);
    var x = pos.x - (lens.offsetWidth / 2);
    var y = pos.y - (lens.offsetHeight / 2);
    
    // Boundary checks
    if (x > img.width - lens.offsetWidth) { x = img.width - lens.offsetWidth; }
    if (x < 0) { x = 0; }
    if (y > img.height - lens.offsetHeight) { y = img.height - lens.offsetHeight; }
    if (y < 0) { y = 0; }
    
    lens.style.left = (x + img.offsetLeft) + "px";
    lens.style.top = (y + img.offsetTop) + "px";
    
    result.style.backgroundPosition = "-" + (x * cx) + "px -" + (y * cy) + "px";
    result.style.backgroundSize = (img.width * cx) + "px " + (img.height * cy) + "px";
  }

  // Get cursor position relative to image
  function getCursorPos(e) {
    var a, x = 0, y = 0;
    e = e || window.event;
    a = img.getBoundingClientRect();
    x = e.pageX - a.left;
    y = e.pageY - a.top;
    x = x - window.pageXOffset;
    y = y - window.pageYOffset;
    return {x : x, y : y};
  }
  
  function updateZoomBackground() {
     if(!img.src) return;
     // Calculate ratio
     var cx = result.offsetWidth / lens.offsetWidth;
     var cy = result.offsetHeight / lens.offsetHeight;
     
     result.style.backgroundImage = "url('" + img.src + "')";
     result.style.backgroundSize = (img.width * cx) + "px " + (img.height * cy) + "px";
  }

  container.addEventListener('mousemove', moveLens);
  lens.addEventListener('mousemove', moveLens);
  img.addEventListener('mousemove', moveLens);
  
  // Hook into thumbnail change
  var originalChangeImage = window.etoChangeImage;
  window.etoChangeImage = function(newSrc, thumb) {
     // Call original if it exists
     if(typeof originalChangeImage === 'function') originalChangeImage(newSrc, thumb);
     // Or just do our update logic here if original is simple
     document.getElementById('eto-featured-img').src = newSrc;
     document.querySelectorAll('.eto-gallery-thumb').forEach(t => t.classList.remove('active'));
     thumb.classList.add('active');
     
     // Update background immediately
     result.style.backgroundImage = "url('" + newSrc + "')";
  };
});

// === Lightbox Functions ===
function etoOpenLightbox(imgSrc) {
  var overlay = document.getElementById('eto-lightbox');
  var mainImg = document.getElementById('eto-lightbox-img');
  if (!overlay || !mainImg) return;
  mainImg.src = imgSrc;
  overlay.classList.add('active');
  document.body.style.overflow = 'hidden';
  // Mark the right thumbnail as active
  document.querySelectorAll('.eto-lightbox-thumb').forEach(function(t) {
    t.classList.remove('active');
    var tImg = t.querySelector('img');
    if (tImg && tImg.src === imgSrc) t.classList.add('active');
  });
}
function etoCloseLightbox() {
  var overlay = document.getElementById('eto-lightbox');
  if (overlay) overlay.classList.remove('active');
  document.body.style.overflow = '';
}
function etoLightboxSelect(imgSrc, thumb) {
  var mainImg = document.getElementById('eto-lightbox-img');
  if (mainImg) mainImg.src = imgSrc;
  document.querySelectorAll('.eto-lightbox-thumb').forEach(function(t) { t.classList.remove('active'); });
  if (thumb) thumb.classList.add('active');
}
// Close lightbox on Escape key
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') etoCloseLightbox();
});
// Open lightbox when clicking on featured image
document.addEventListener('DOMContentLoaded', function() {
  var featuredImg = document.getElementById('eto-featured-img');
  if (featuredImg) {
    featuredImg.style.cursor = 'pointer';
    featuredImg.addEventListener('click', function() {
      etoOpenLightbox(this.src);
    });
  }
  // Also open lightbox when clicking on gallery thumbnails
  document.querySelectorAll('.eto-gallery-thumb').forEach(function(t) {
    t.addEventListener('click', function() {
      var img = this.querySelector('img');
      if (img) {
        var src = document.getElementById('eto-featured-img').src;
        etoOpenLightbox(src);
      }
    });
  });
});

  var defaultPriceCents = {{ product.selected_or_first_available_variant.price }};
  etoCurrentUnitPriceCents = defaultPriceCents;
  etoUpdateTotalPrice();
  
  const defaultVariantId = '{{ product.selected_or_first_available_variant.id }}';

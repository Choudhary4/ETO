  .buybox .qty-val{font-size:15px;font-weight:500;width:32px !important;min-width:32px;text-align:center;color:#1F1D1A;border:none !important;background:transparent !important;box-shadow:none !important;padding:0 !important;outline:none !important;}

  .buybox .btn{width:100% !important;border-radius:9px !important;padding:13px !important;font-size:14px !important;font-weight:600 !important;display:flex !important;align-items:center !important;justify-content:center !important;gap:8px !important;cursor:pointer;text-decoration:none !important;line-height:1.2 !important;border:none !important;box-shadow:none !important;}
  .buybox .btn-primary{background:#D87732 !important;color:#fff !important;margin-top:20px !important; border:none !important;}
  .buybox .btn-primary:hover{background:#c26a2c !important;}
  .buybox .btn-outline{border:1px solid #E0D9CC !important;background:#fff !important;color:#1F1D1A !important;margin-top:10px !important;}
  .buybox .btn-outline:hover{border-color:#B98E54 !important;}
  .buybox .btn-outline .icon{width:16px;height:16px;color:#B98E54 !important;fill:currentColor !important;stroke:none !important;flex-shrink:0;overflow:visible;}
  .buybox .btn-outline:hover .icon{color:#B98E54 !important;}

  .buybox .callout{text-align:center;margin-top:20px;}
  .buybox .callout .num{display:flex;align-items:center;justify-content:center;gap:8px;font-size:19px;font-weight:600;color:#1F1D1A;}
  .buybox .callout .num .icon{width:18px;height:18px;color:#B98E54 !important;fill:currentColor !important;stroke:none !important;flex-shrink:0;overflow:visible;}
  .buybox .callout .hours{font-size:12px;color:#8A8378;margin-top:4px;}

  .buybox .assurance{display:flex;align-items:center;gap:14px;border:1px solid #E7E2D8;border-radius:12px;padding:15px 16px;margin-top:16px;}
  .buybox .assurance .icon{width:40px;height:40px;padding:7px;border:2px dashed #000000 !important;border-radius:50%;color:#000000 !important;stroke:currentColor;stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;}
  .buybox .assurance p{font-size:13px;color:#4A453E;line-height:1.4;margin:0;font-weight:500;}
  
  /* NEW UI CSS */
  :root{
    --page:#FFFFFF; --bar:#EFEBE3; --banner:#E9E4DB; --card:#F3F0EA; --tile:#FFFFFF;
    --line:#E7E2D8; --tile-line:#E0D9CC; --ink:#1F1D1A; --body:#4A453E; --muted:#8A8378;
    --oak:#9A6B2F; --oak-soft:#B98E54; --oak-tint:#FBF6EE; --green:#3F7D4F;
    --serif:'Lora', Georgia, 'Times New Roman', serif; --sans:'Inter', system-ui, -apple-system, sans-serif;
  }
  .wrap{max-width:1180px;margin:0 auto;padding:0 28px;font-family:var(--sans);color:var(--body);line-height:1.5;}
  .crumb{display:flex;align-items:center;gap:9px;font-size:13px;color:var(--muted);padding:20px 0;flex-wrap:wrap;}
  .crumb a{color:inherit;text-decoration:none;}
  .crumb a:hover{color:var(--oak);}
  .crumb .sep{color:#C7BFB1;}
  .crumb .current{color:var(--body);}

  main.wrap .eto-new-product-grid{display:grid !important;grid-template-columns:minmax(0,0.9fr) minmax(0,1.35fr) 275px !important;gap:24px !important;align-items:start !important;padding-bottom:48px !important;}
  main.wrap .eto-new-product-grid > .gallery { grid-column: 1 !important; grid-row: 1 !important; position: sticky !important; top: 170px !important; align-self: start !important; z-index: 2 !important; }
  main.wrap .eto-new-product-grid > .details { grid-column: 2 !important; grid-row: 1 !important; min-width: 0 !important; }
  main.wrap .eto-new-product-grid > .buybox { grid-column: 3 !important; grid-row: 1 !important; position: sticky !important; top: 170px !important; align-self: start !important; z-index: 2 !important; }

  .gallery .hero{aspect-ratio:4/5;border-radius:12px;overflow:hidden;background:#ECE5DA;position:relative;display:flex;align-items:center;justify-content:center;padding:24px;}
  .thumbs{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:12px;}
  .thumb{aspect-ratio:1/1;border-radius:8px;border:1px solid var(--tile-line);background:#EAE1D2;overflow:hidden;cursor:pointer;}
  .thumb.active{border-color:var(--oak);box-shadow:0 0 0 1px var(--oak);}
  .thumb.more{background:#EFE9DF;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--ink);font-size:13px;font-weight:600;gap:1px;cursor:pointer;}
  .thumb.more span{font-weight:400;font-size:12px;color:var(--muted);}
  .zoomhint{display:flex;align-items:center;justify-content:center;gap:7px;font-size:14px;color:#7A7264;margin-top:18px;font-weight:500;}
  .zoomhint .icon{width:16px;height:16px;stroke:currentColor;stroke-width:1.6;fill:none;color:#7A7264;}

  .eyebrow{display:inline-block;background:var(--banner);color:#6B6357;font-size:11px;font-weight:600;letter-spacing:.1em;padding:5px 10px;border-radius:5px;margin-bottom:14px;text-transform:uppercase;}
  .title{font-family:var(--serif);font-weight:600;font-size:30px;line-height:1.25;color:var(--ink);margin-bottom:12px;margin-top:0;}
  .lede{font-size:15px;color:var(--body);max-width:46ch;margin-bottom:26px;}

  /* sizes-head styling moved */

  .size-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;}
  .size-tile{position:relative;text-align:left;background:var(--tile);border:1px solid var(--tile-line);border-radius:9px;padding:11px 11px;display:flex;flex-direction:column;gap:2px;transition:border-color .12s ease, box-shadow .12s ease;cursor:pointer;min-width:0;}
  .size-tile:hover{border-color:var(--oak-soft);}
  .size-tile.selected{border-color:var(--oak);box-shadow:0 0 0 1px var(--oak);background:var(--oak-tint);}
  .size-tile .dim{font-size:14px;font-weight:500;color:var(--ink);white-space:nowrap;}
  .size-tile .price{font-size:13px;font-weight:500;color:var(--oak);}
  .size-tile .check{position:absolute;top:-7px;right:-7px;width:20px;height:20px;border-radius:50%;background:var(--oak);color:#fff;display:none;align-items:center;justify-content:center;}
  .size-tile.selected .check{display:flex;}
  .size-tile .check .icon{width:12px;height:12px;stroke:#fff;stroke-width:2.4;fill:none;stroke-linecap:round;stroke-linejoin:round;}

  .helper{display:flex;align-items:center;gap:18px;background:#EAE1D2 !important;border:1px solid #D8CDBA !important;border-radius:12px;padding:18px 20px;margin-top:20px;}
  .helper .badge{width:56px;height:56px;border-radius:50%;background:#fff !important;color:#9A6B2F;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 2px 6px rgba(0,0,0,0.05);}
  .helper .badge .icon{width:22px;height:22px;stroke:currentColor;stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round;}
  .helper .copy{flex:1;}
  .helper .copy strong{display:block;font-size:16px;color:#1F1D1A;font-weight:700;margin-bottom:4px;}
  .helper .copy span{display:block;font-size:14px;color:#4A453E;line-height:1.45;max-width:none;}
  .helper .check-btn{border:1px solid #D8CDBA;background:#fff;border-radius:8px;padding:12px 18px;font-size:14px;font-weight:600;color:#1F1D1A;white-space:nowrap;cursor:default;text-decoration:none;box-shadow:0 2px 6px rgba(0,0,0,0.05);pointer-events:none;}
  .helper .check-btn:hover{border-color:#D8CDBA;}

  .features{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:20px;background:#F3F0EA !important;border:1px solid #E7E2D8;border-radius:12px;padding:32px 16px;}
  .feature{display:flex;flex-direction:column;align-items:center;text-align:center;gap:12px;padding:0;}
  .feature .ficon{width:40px;height:40px;display:flex;align-items:center;justify-content:center;}
  .feature .ficon img{max-width:100%;max-height:100%;object-fit:contain;}
  .feature .ficon .icon{width:28px;height:28px;stroke:currentColor;stroke-width:1.5;fill:none;stroke-linecap:round;stroke-linejoin:round;}
  .feature p{font-size:13px;color:#4A453E;line-height:1.4;white-space:nowrap;margin:0;font-weight:500;}

  /* Tabs */
  .tabs{background:#F3F0EA !important;border:1px solid #E7E2D8;border-radius:12px;padding:24px 32px;margin-top:20px;}
  .tablist{display:flex;width:100%;border-bottom:1px solid #E7E2D8;overflow-x:auto;}
  .tab{flex:1;display:flex;justify-content:center;align-items:center;gap:8px;padding:20px 10px;font-size:14px;font-weight:500;color:#8A8378;background:none;border:none;border-bottom:2px solid transparent;white-space:nowrap;cursor:pointer;margin:0;transition:color 0.2s, border-color 0.2s;}
  .tab .icon{width:16px;height:16px;stroke:currentColor;stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round;}
  .tab.active{color:#1F1D1A;border-bottom-color:#9A6B2F;}
  .tabpanel{display:none;padding:28px 0 56px;}
  .tabpanel.active{display:block;}
  .tabpanel.grid-layout{display:none;}
  .tabpanel.grid-layout.active{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:40px;}
  .product-description-container { max-width: 100%; font-size: 13px; color: #7A7264; line-height: 1.6; }
  .product-description-container [style], .eto-clean-tab [style] { font-family: inherit !important; color: inherit !important; font-size: inherit !important; background: transparent !important; box-shadow: none !important; text-shadow: none !important; }
  .product-description-container strong, .product-description-container b { font-size: 14px !important; font-weight: 700 !important; color: #1F1D1A !important; display: inline; margin-bottom: 0; }
  .product-description-container h3, .product-description-container h4 { font-size: 14px !important; font-weight: 700 !important; color: #1F1D1A !important; display: block; margin-bottom: 12px; }
  .eto-clean-tab { font-family: var(--sans), sans-serif !important; font-size: 14px; color: #4A453E; line-height: 1.6; }
  .eto-clean-tab *, .eto-clean-tab [style] { font-family: inherit !important; }
  .eto-clean-tab [style] { color: inherit !important; font-size: inherit !important; background: transparent !important; box-shadow: none !important; text-shadow: none !important; }
  .eto-clean-tab strong, .eto-clean-tab b, .eto-clean-tab strong *, .eto-clean-tab b * { font-weight: 600 !important; color: #1F1D1A !important; font-style: normal !important; text-decoration: none !important; }
  .eto-clean-tab span[style*="yellow"] { background: #EFEBE3 !important; color: #1F1D1A !important; padding: 4px 8px !important; border-radius: 4px !important; display: inline-block; font-size: 12px !important; font-weight: 600 !important; letter-spacing: 0.05em; margin-bottom: 8px; }
  .eto-clean-tab a.eto-fast-quote-link { background: #1F1D1A !important; color: #fff !important; font-size: 14px !important; font-weight: 600 !important; padding: 13px !important; border-radius: 9px !important; text-decoration: none !important; display: inline-flex !important; align-items: center; justify-content: center; margin-top: 20px; }
  .eto-clean-tab a.eto-fast-quote-link:hover { background: #33302B !important; }
  .eto-clean-tab li p, .eto-clean-tab li div { margin: 0 !important; padding: 0 !important; }
  .product-description-container > div, .product-description-container > p, .product-description-container .product-description > div, .product-description-container .product-description > p { margin-bottom: 16px; max-width: 100%; }
  .product-description-container .eto-please-note, .product-description-container .eto-please-note * { font-weight: 700 !important; font-size: 14px !important; color: #1F1D1A !important; line-height: 1.5 !important; margin-bottom: 24px; }
  .tabpanel p{font-size:14px;color:var(--body);max-width:100%;line-height:1.5;}
  .tabpanel ul{list-style:none;display:flex;flex-direction:column;gap:10px;padding:0;margin:0;}
  .tabpanel li{font-size:14px;color:var(--body);display:flex;gap:9px;}
  .tabpanel li::before{content:"";width:5px;height:5px;border-radius:50%;background:var(--oak);margin-top:8px;flex-shrink:0;}

  /* Responsive */
  @media (max-width:960px){
    main.wrap .eto-new-product-grid{grid-template-columns:1fr 1fr !important;}
    main.wrap .eto-new-product-grid > .gallery { grid-column: 1 !important; grid-row: 1 !important; }
    main.wrap .eto-new-product-grid > .details { grid-column: 2 !important; grid-row: 1 !important; }
    main.wrap .eto-new-product-grid > .buybox { grid-column: 1 / -1 !important; grid-row: 2 !important; position:static !important; margin-top: 20px; }
    .buybox .card{max-width:420px;margin:0 auto;}
    .tabpanel.grid-layout.active{grid-template-columns:1fr;}
  }
  @media (max-width:768px){
    .wrap { padding: 0 16px; }
    main.wrap .eto-new-product-grid{grid-template-columns:1fr !important; gap: 24px !important;}
    main.wrap .eto-new-product-grid > .gallery { grid-column: 1 !important; grid-row: 1 !important; }
    main.wrap .eto-new-product-grid > .details { grid-column: 1 !important; grid-row: 2 !important; }
    main.wrap .eto-new-product-grid > .buybox { grid-column: 1 !important; grid-row: 3 !important; margin-top: 0; }
    .buybox .card{max-width:100%;}
    .size-grid{grid-template-columns:repeat(2,1fr);}
    .features{grid-template-columns:repeat(2,1fr); padding: 20px 12px; gap: 12px;}
    .feature p{white-space:normal; font-size:12px;}
    .title{font-size:24px; line-height: 1.3;}
    .helper { flex-direction: column; text-align: center; padding: 16px; align-items: center; }
    .helper .copy span { max-width: 100%; }
    .tabs { padding: 16px; }
    .tablist { justify-content: flex-start; scrollbar-width: none; -webkit-overflow-scrolling: touch; padding-bottom: 2px; }
    .tablist::-webkit-scrollbar { display: none; }
    .tab { flex: 0 0 auto; padding: 15px 16px; font-size: 13px; }
    .thumbs { gap: 6px; }
    .gallery .hero{padding:12px; border-radius: 8px;}
  }
</style>

<!-- Cart Popup -->
<div class="eto-cart-popup-overlay" id="eto-cart-overlay" onclick="etoCloseCartPopup()"></div>
<div class="eto-cart-popup" id="eto-cart-popup">
  <button class="eto-cart-popup-close" onclick="etoCloseCartPopup()" aria-label="Close cart popup">&#10005;</button>
  <div class="eto-cart-popup-header">
    <div class="cart-subtotal-row">
      <span class="cart-subtotal-label">Cart Subtotal:</span> <span class="cart-subtotal-price" id="eto-popup-subtotal">$0.00</span>
    </div>
    <div class="cart-title">Recently added item(s)</div>
  </div>
  <div class="eto-cart-popup-items" id="eto-cart-items">
    <!-- Items will be populated by JavaScript -->
  </div>
  <div class="eto-cart-popup-footer">
    <form action="{{ routes.cart_url }}" method="post">
      <button type="submit" name="checkout" class="eto-cart-checkout-btn">CHECKOUT</button>
    </form>
  </div>
</div>

<main class="wrap">
  <!-- Breadcrumb -->
  <nav class="crumb" id="eto-dynamic-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span class="sep">&rsaquo;</span>
    {% assign bc_shown = false %}
    {% assign first_category = blank %}
    {% assign breadcrumb_category = "" %}
    
    {% if product.metafields.custom.product_category.value %}
      {% assign first_category = product.metafields.custom.product_category.value | first %}
    {% elsif product.metafields.custom.product_category != blank %}
      {% assign first_category = product.metafields.custom.product_category | remove: '[' | remove: ']' | remove: '"' | split: ',' | first %}
    {% endif %}

    {% if first_category != blank %}
      <a href="/collections/all?filter.p.m.custom.product_category={{ first_category | url_encode }}">{{ first_category }} Home</a>
      {% assign bc_shown = true %}
      {% assign breadcrumb_category = first_category %}
    {% elsif collection %}
      <a href="{{ collection.url }}">{{ collection.title }} Home</a>
      {% assign bc_shown = true %}
      {% assign breadcrumb_category = collection.title %}
    {% else %}
      {% for col in product.collections %}
        {% unless col.handle == 'all' or col.handle == 'frontpage' %}
          {% if bc_shown == false %}
            <a href="{{ col.url }}">{{ col.title }} Home</a>
            {% assign bc_shown = true %}
            {% assign breadcrumb_category = col.title %}
          {% endif %}
        {% endunless %}
      {% endfor %}
    {% endif %}
    {% if bc_shown == false and product.type != blank %}
      <a href="/collections/all">{{ product.type }} Home</a>
      {% assign bc_shown = true %}
      {% assign breadcrumb_category = product.type %}
    {% endif %}
    {% if bc_shown %}
      <span class="sep">&rsaquo;</span>
    {% endif %}
    <span class="current">{{ product.title }}</span>
  </nav>

  <script>
    window.etoCategoryDescriptions = {};
    {% for collection in product.collections %}
      {% assign temp_cat = collection.title | replace: " Home", "" | replace: " home", "" | replace: " HOME", "" %}
      {% assign temp_cat_down = temp_cat | downcase %}
      {% if temp_cat_down contains "door" %}
        {% assign temp_cat = temp_cat | replace: " Doors", "" | replace: " doors", "" | replace: " Door", "" | replace: " door", "" | replace: "Doors", "" | replace: "doors", "" | replace: "Door", "" | replace: "door", "" %}
      {% endif %}
      
      {% assign category_name = temp_cat %}
      {% capture cat_desc %}{% include 'category-description-mapping' %}{% endcapture %}
      {% assign cat_desc = cat_desc | strip %}
      {% if cat_desc == blank %}
        {% capture cat_desc %}<p><strong>Find the Perfect {{ temp_cat }} Door for Your Space.</strong> Explore our premium selection of {{ temp_cat | downcase }} doors, designed to combine style, durability, and exceptional craftsmanship to elevate any home or office.</p>{% endcapture %}
      {% endif %}
      
      {% assign temp_title = temp_cat | upcase %}
      {% unless temp_title contains "DOOR" %}
        {% assign temp_title = temp_title | append: " DOORS" %}
      {% endunless %}
      
      window.etoCategoryDescriptions[{{ temp_cat | json }}] = { title: {{ temp_title | json }}, desc: {{ cat_desc | json }} };
      window.etoCategoryDescriptions[{{ collection.title | json }}] = { title: {{ temp_title | json }}, desc: {{ cat_desc | json }} };
    {% endfor %}
    
    {% if product.metafields.custom.product_category.value %}
      {% for cat in product.metafields.custom.product_category.value %}
        {% assign temp_cat = cat %}
        {% assign category_name = temp_cat %}
        {% capture cat_desc %}{% include 'category-description-mapping' %}{% endcapture %}
        {% assign cat_desc = cat_desc | strip %}
        {% if cat_desc == blank %}
          {% capture cat_desc %}<p><strong>Find the Perfect {{ temp_cat }} Door for Your Space.</strong> Explore our premium selection of {{ temp_cat | downcase }} doors, designed to combine style, durability, and exceptional craftsmanship to elevate any home or office.</p>{% endcapture %}
        {% endif %}
        
        {% assign temp_title = temp_cat | upcase %}
        {% unless temp_title contains "DOOR" %}
          {% assign temp_title = temp_title | append: " DOORS" %}
        {% endunless %}
        
        window.etoCategoryDescriptions[{{ temp_cat | json }}] = { title: {{ temp_title | json }}, desc: {{ cat_desc | json }} };
      {% endfor %}
    {% elsif product.metafields.custom.product_category != blank %}
      {% assign cat_list = product.metafields.custom.product_category | remove: '[' | remove: ']' | remove: '"' | split: ',' %}
      {% for cat in cat_list %}
        {% assign temp_cat = cat | strip %}
        {% assign category_name = temp_cat %}
        {% capture cat_desc %}{% include 'category-description-mapping' %}{% endcapture %}
        {% assign cat_desc = cat_desc | strip %}
        {% if cat_desc == blank %}
          {% capture cat_desc %}<p><strong>Find the Perfect {{ temp_cat }} Door for Your Space.</strong> Explore our premium selection of {{ temp_cat | downcase }} doors, designed to combine style, durability, and exceptional craftsmanship to elevate any home or office.</p>{% endcapture %}
        {% endif %}
        
        {% assign temp_title = temp_cat | upcase %}
        {% unless temp_title contains "DOOR" %}
          {% assign temp_title = temp_title | append: " DOORS" %}
        {% endunless %}
        
        window.etoCategoryDescriptions[{{ temp_cat | json }}] = { title: {{ temp_title | json }}, desc: {{ cat_desc | json }} };
      {% endfor %}
    {% endif %}

    document.addEventListener("DOMContentLoaded", function() {
      try {
        const referrer = document.referrer;
        if (referrer && referrer.includes("filter.p.m.custom.product_category=")) {
          const url = new URL(referrer);
          const category = url.searchParams.get("filter.p.m.custom.product_category");
          if (category) {
            const breadcrumb = document.getElementById("eto-dynamic-breadcrumb");
            if (breadcrumb) {
              const links = breadcrumb.querySelectorAll("a");
              if (links.length >= 2) {
                // Update the category link
                links[1].textContent = category + " Home";
                links[1].href = "/collections/all?filter.p.m.custom.product_category=" + encodeURIComponent(category);
              }
            }
            
            // Sync bottom category description with the JS breadcrumb
            if (window.etoCategoryDescriptions && window.etoCategoryDescriptions[category]) {
              const descTitle = document.querySelector(".eto-product-category-desc h3");
              const descContent = document.querySelector(".eto-product-category-desc .eto-category-desc-content");
              if (descTitle && descContent) {
                descTitle.textContent = window.etoCategoryDescriptions[category].title;
                descContent.innerHTML = window.etoCategoryDescriptions[category].desc;
              }
            }
          }
        }
      } catch (e) {
        console.error("Error updating breadcrumb:", e);
      }
    });
  </script>

  <!-- Product Title Moved to Center Column -->

  <!-- Image Lightbox Modal -->
  <div class="eto-lightbox-overlay" id="eto-lightbox" onclick="if(event.target===this) etoCloseLightbox()">
    <div class="eto-lightbox-modal">
      <button class="eto-lightbox-close" onclick="etoCloseLightbox()">
        Close <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
      </button>
      <div class="eto-lightbox-main-img">
        <img id="eto-lightbox-img" src="" alt="{{ product.title }}">
      </div>
      <div class="eto-lightbox-sidebar">
        <div class="eto-lightbox-title">{{ product.title }}</div>
        <div class="eto-lightbox-thumbs" id="eto-lightbox-thumbs">
          {% if product.metafields.custom.product_image_url != blank %}
            <div class="eto-lightbox-thumb active" onclick="etoLightboxSelect('{{ product.metafields.custom.product_image_url }}', this)">
              <img src="{{ product.metafields.custom.product_image_url }}" alt="{{ product.title }}">

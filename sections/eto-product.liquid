// Clear configurator (reset everything)
function etoClearConfigurator() {
  // Reset size
  document.querySelectorAll('.eto-size-option').forEach(opt => opt.classList.remove('selected'));
  const selectedSpan = document.getElementById('eto-selected-size');
  if (selectedSpan) selectedSpan.textContent = 'No Size Selected';
  
  // Show size grid, hide edit button
  const sizeGrid = document.getElementById('eto-size-grid');
  const sizeEditBtn = document.getElementById('eto-size-edit-btn');
  if (sizeGrid) sizeGrid.style.display = 'grid';
  if (sizeEditBtn) sizeEditBtn.style.display = 'none';
  
  // Hide config container
  const configContainer = document.getElementById('eto-config-container');
  if (configContainer) configContainer.style.display = 'none';
  
  // Reset all dynamic options
  etoOptionGroups.forEach((group, index) => {
    if (group.title === 'Size') return;
    delete etoConfigState[group.title];
    const rowEl = document.getElementById('eto-dynopt-' + index);
    if (rowEl) rowEl.style.display = 'none';
    const label = document.getElementById('eto-dynopt-label-' + index);

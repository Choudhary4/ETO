// Star rating input for Write a Review form
document.addEventListener('DOMContentLoaded', function() {
  var stars = document.querySelectorAll('.eto-star-input');
  var ratingInput = document.getElementById('eto-rating-input');
  var selectedRating = 0;

  stars.forEach(function(star) {
    // Hover effect
    star.addEventListener('mouseenter', function() {
      var val = parseInt(star.getAttribute('data-value'));
      stars.forEach(function(s) {
        var sVal = parseInt(s.getAttribute('data-value'));
        s.classList.toggle('hovered', sVal <= val);
      });
    });

    // Mouse leave - revert to selected
    star.addEventListener('mouseleave', function() {
      stars.forEach(function(s) {
        var sVal = parseInt(s.getAttribute('data-value'));
        s.classList.remove('hovered');
        s.classList.toggle('selected', sVal <= selectedRating);
      });
    });

    // Click to select rating
    star.addEventListener('click', function() {
      selectedRating = parseInt(star.getAttribute('data-value'));
      if (ratingInput) ratingInput.value = selectedRating;
      stars.forEach(function(s) {
        var sVal = parseInt(s.getAttribute('data-value'));
        s.classList.toggle('selected', sVal <= selectedRating);
      });
    });
  });
});


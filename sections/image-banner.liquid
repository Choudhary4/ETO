{% comment %}
ETO – SOCIAL PROOF STRIP (Redesigned for Stitch)
{% endcomment %}

<style>
.eto-social-proof {
  width: 100%;
  background: #ffffff;
  padding: 40px var(--eto-margin-edge);
  text-align: center;
}
.eto-social-proof-inner {
  max-width: var(--eto-container-max);
  margin: 0 auto;
  position: relative;
  display: inline-block;
  padding: 0 48px;
}
/* Horizontal lines removed as requested */

@font-face {
  font-family: 'MADE Mirage';
  src: url('{{ "made-mirage-regular.otf" | asset_url }}') format('opentype');
  font-weight: normal;
  font-style: normal;
}
@font-face {
  font-family: 'MADE Mirage';
  src: url('{{ "made-mirage-thin.otf" | asset_url }}') format('opentype');
  font-weight: 300;
  font-style: normal;
}

.eto-social-proof h2 {
  margin: 0;
  font-family: 'MADE Mirage', serif;
  font-size: 48px;
  font-weight: normal;
  color: var(--eto-dark-charcoal);
  text-transform: uppercase;
  letter-spacing: normal;
  line-height: 48px;
}
.eto-social-proof p {
  margin: 0;
  font-family: 'MADE Mirage', serif;
  font-size: 48px;
  font-weight: 300;
  color: var(--eto-dark-charcoal);
  text-transform: uppercase;
  letter-spacing: normal;
  line-height: 48px;
}

@media (max-width: 768px) {
  .eto-social-proof { padding: 24px 16px; overflow: hidden; }
  .eto-social-proof h2 { font-size: 22px; letter-spacing: 0.15em; }
  .eto-social-proof p { font-size: 15px; }
}
</style>

<section class="eto-social-proof">
  <div style="overflow: hidden; text-align: center;">
    <div class="eto-social-proof-inner">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subtext }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ETO Social Proof",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Main Text",
      "default": "OVER 1 MILLION ETO DOORS SOLD!"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Sub Text",
      "default": "100,000+ SATISFIED CUSTOMERS"
    }
  ],
  "presets": [
    {
      "name": "ETO Social Proof"
    }
  ]
}
{% endschema %}

<style>
  .eto-portfolios-page {
    font-family: sans-serif;
    color: #333;
  }
  
  .eto-portfolio-breadcrumb {
    font-size: 12px;
    padding: 15px 20px;
    max-width: var(--eto-container-max);
    margin: 0 auto;
  }
  
  .eto-portfolio-breadcrumb a {
    color: #333;
    text-decoration: none;
  }
  
  .eto-portfolio-wrapper {
    display: flex;
    max-width: var(--eto-container-max);
    margin: 0 auto;
    padding: 0 20px 40px;
    gap: 30px;
  }
  
  .eto-portfolio-main {
    flex: 1;
  }
  
  .eto-portfolio-columns {
    display: flex;
    gap: 20px;
  }
  
  .eto-portfolio-column {
    flex: 1;
    background: #eeeeee;
    padding: 15px;
  }
  
  .eto-portfolio-section {
    margin-bottom: 20px;
  }
  
  .eto-portfolio-section h3 {
    font-size: 13px;
    font-weight: bold;
    margin: 0 0 5px;
    color: #333;
  }
  
  .eto-portfolio-section hr {
    border: none;
    border-top: 1px solid #ccc;
    margin: 0 0 10px;
  }
  
  .eto-portfolio-section ul {
    list-style: circle;
    padding-left: 20px;
    margin: 0;
    font-size: 11px;
    line-height: 1.6;
  }
  
  .eto-portfolio-section li {
    margin-bottom: 2px;
  }
  
  .eto-portfolio-footer {
    text-align: center;
    margin-top: 30px;
  }
  
  .eto-portfolio-footer p {
    font-size: 12px;
    margin-bottom: 15px;
  }
  
  .eto-portfolio-footer img {
    max-width: 100%;
  }
  
  @media (max-width: 768px) {
    .eto-portfolio-wrapper {
      flex-direction: column;
    }
    
    .eto-portfolio-columns {
      flex-direction: column;
    }
  }

  @media screen and (min-width: 1921px) {
    .eto-portfolio-wrapper, .eto-portfolio-breadcrumb { max-width: 85vw !important; padding-left: 2vw !important; padding-right: 2vw !important; }
    .eto-portfolio-breadcrumb { font-size: clamp(12px, 1.2vw, 24px) !important; }
    .eto-portfolio-section h3 { font-size: clamp(13px, 1.3vw, 26px) !important; margin-bottom: clamp(5px, 0.5vw, 10px) !important; }
    .eto-portfolio-section ul { font-size: clamp(11px, 1.1vw, 22px) !important; }
    .eto-portfolio-footer p { font-size: clamp(12px, 1.2vw, 24px) !important; }
    .eto-portfolio-footer img { max-width: clamp(200px, 20vw, 400px) !important; height: auto; }
  }
</style>


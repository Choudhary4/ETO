<div class="eto-portfolios-page">
  <!-- Top section with white background -->
  <div class="eto-portfolios-top">
    <div class="eto-portfolios-header-wrap">
      <h1 class="eto-portfolios-title">Explore Projects by Industry</h1>
      <p class="eto-portfolios-subtitle">Browse our portfolio of completed projects across the industries we serve.</p>
      
      <div class="eto-portfolios-filters">
        <button class="eto-pf-btn active">All Projects</button>
        <button class="eto-pf-btn">Hospitality</button>
        <button class="eto-pf-btn">Restaurants</button>
        <button class="eto-pf-btn">Residential</button>
        <button class="eto-pf-btn">Public & Education</button>
        <button class="eto-pf-btn">Entertainment</button>
      </div>
    </div>

    <div class="eto-portfolios-grid-wrap">
      <div class="eto-portfolios-grid">
        {% for block in section.blocks %}
          {% if block.type == 'project' %}
            <div class="eto-portfolio-card" {{ block.shopify_attributes }}>
              <div class="eto-pc-img-wrap">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title }}" class="eto-pc-img">
                {% else %}
                  {% if block.settings.title == 'Hotel del Coronado' %}
                    <img src="{{ 'hotel_del_coronado.png' | asset_url }}" alt="{{ block.settings.title }}" class="eto-pc-img">
                  {% elsif block.settings.title == 'Rosewood Hotels' %}
                    <img src="{{ 'rosewood_hotels.png' | asset_url }}" alt="{{ block.settings.title }}" class="eto-pc-img">
                  {% elsif block.settings.title == 'The Charcoal Grill' %}
                    <img src="{{ 'the_charcoal_grill.png' | asset_url }}" alt="{{ block.settings.title }}" class="eto-pc-img">
                  {% else %}
                    {{ 'collection-1' | placeholder_svg_tag: 'eto-pc-img eto-placeholder' }}
                  {% endif %}
                {% endif %}
              </div>
              <div class="eto-pc-content">
                <span class="eto-pc-category">{{ block.settings.category | upcase }}</span>
                <h3 class="eto-pc-title">{{ block.settings.title }}</h3>
                <p class="eto-pc-location">{{ block.settings.location }}</p>
                <a href="{{ block.settings.link | default: '#' }}" class="eto-pc-link">View Project &rarr;</a>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- Bottom section with beige background -->
  <div class="eto-portfolios-bottom">
    <div class="eto-portfolios-accordion-wrap">
      <h2 class="eto-pa-title">Additional Clients & Projects</h2>
      
      <div class="eto-pa-grid">
        <!-- Left Column -->
        <div class="eto-pa-col">
          <!-- Accordion 1 -->
          <details class="eto-accordion" open>
            <summary class="eto-acc-summary">
              Hospitality & Hotels <span class="eto-acc-icon"></span>
            </summary>
            <div class="eto-acc-content">
              <ul class="eto-acc-list">
                <li>Marriott Vacation Club</li>
                <li>Marriott Hotel Warner Center</li>
                <li>Marriott Hartford Downtown</li>
                <li>Hotel Luca</li>
                <li>Cheeca Lodge & Spa</li>
                <li>Courtyard by Marriott</li>
              </ul>
              <a href="#" class="eto-acc-link">View all hospitality projects &rarr;</a>
            </div>
          </details>
          
          <!-- Accordion 2 -->
          <details class="eto-accordion">
            <summary class="eto-acc-summary">
              Restaurants <span class="eto-acc-icon"></span>
            </summary>
            <div class="eto-acc-content">
              <ul class="eto-acc-list">
                <li>DZ Restaurants- Clifton Park, NY</li>
                <li>The Charcoal Grill- Los Angeles, CA</li>
                <li>Apple Wood Grill-Wenatchee, WA</li>
                <li>The Rex- Mt. Vernon, IL</li>
              </ul>
            </div>
          </details>
          
          <!-- Accordion 3 -->
          <details class="eto-accordion">
            <summary class="eto-acc-summary">
              Religious Facilities <span class="eto-acc-icon"></span>
            </summary>
            <div class="eto-acc-content">
              <ul class="eto-acc-list">
                <li>Magen David- Beverly Hills, CA</li>
                <li>Acts Ministries-Houston, TX</li>
                <li>Christ Prysbyterian- Martinsville, NJ</li>
              </ul>
            </div>
          </details>
        </div>

        <!-- Right Column -->
        <div class="eto-pa-col">
          <details class="eto-accordion">
            <summary class="eto-acc-summary">
              Entertainment & Recreation <span class="eto-acc-icon"></span>
            </summary>
            <div class="eto-acc-content">
               <ul class="eto-acc-list">
                 <li>Bristlecone Pines Golf Course- Hartland, WI</li>
                 <li>Marathon Community Theater-Marathon, FL</li>
               </ul>
            </div>
          </details>
          <details class="eto-accordion">
            <summary class="eto-acc-summary">
              Home Improvement Outlets <span class="eto-acc-icon"></span>
            </summary>
            <div class="eto-acc-content">
               <ul class="eto-acc-list">
                 <li>Lowes Inc.</li>
                 <li>Home Depot</li>
               </ul>
            </div>
          </details>
          <details class="eto-accordion">
            <summary class="eto-acc-summary">
              Government & Public Buildings <span class="eto-acc-icon"></span>
            </summary>
            <div class="eto-acc-content">
               <ul class="eto-acc-list">
                 <li>USA COURTHOUSE GSA-Brownsville, TX</li>
               </ul>
            </div>
          </details>
          <details class="eto-accordion">
            <summary class="eto-acc-summary">
              Television Production <span class="eto-acc-icon"></span>
            </summary>
            <div class="eto-acc-content">
               <ul class="eto-acc-list">
                 <li>ABC's Extreme Makeover Home Edition</li>
                 <li>House Crashers</li>
               </ul>
            </div>
          </details>
          <details class="eto-accordion">
            <summary class="eto-acc-summary">
              Educational Facilities <span class="eto-acc-icon"></span>
            </summary>
            <div class="eto-acc-content">
               <ul class="eto-acc-list">
                 <li>Gilbert Hall School- Brentwood, CA</li>
                 <li>Pepperdine University- Malibu, CA</li>
               </ul>
            </div>
          </details>
          <details class="eto-accordion">
            <summary class="eto-acc-summary">
              High-Rise Residential & Commercial <span class="eto-acc-icon"></span>
            </summary>
            <div class="eto-acc-content">
               <ul class="eto-acc-list">
                 <li>The Carlyle Residences - Los Angeles, CA</li>
                 <li>The Park Wilshire - Los Angeles, CA</li>
               </ul>
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.eto-portfolios-page {
  font-family: 'Hanken Grotesk', sans-serif;
  color: #333;
}

/* TOP SECTION (White) */
.eto-portfolios-top {
  background-color: #ffffff;
  padding: 60px 20px 40px;
}
.eto-portfolios-header-wrap {
  text-align: center;
  max-width: 100%;
  padding: 0 40px;
  margin: 0 auto 40px;
}
.eto-portfolios-title {
  font-size: 42px;
  font-weight: 600;
  margin: 0 0 15px;
  color: #111;
}
.eto-portfolios-subtitle {
  font-size: 16px;
  color: #555;
  margin: 0 0 30px;
}
.eto-portfolios-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 15px;
  justify-content: center;
}
.eto-pf-btn {
  background: #ffffff;
  border: 1px solid #ccc;
  color: #333;
  padding: 8px 20px;
  border-radius: 30px;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.3s ease;
}
.eto-pf-btn:hover {
  border-color: #d86828;
}
.eto-pf-btn.active {
  background: #d86828;
  color: #fff;
  border-color: #d86828;
}

/* GRID & CARDS */
.eto-portfolios-grid-wrap {
  max-width: 100%;
  padding: 0 40px;
  margin: 0 auto;
}
.eto-portfolios-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 30px;
}
.eto-portfolio-card {
  background: #ffffff;
  border: 1px solid #eee;
  box-shadow: 0 4px 10px rgba(0,0,0,0.03);
}
.eto-pc-img-wrap {
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: #f4f4f4;
}
.eto-pc-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.eto-placeholder {
  fill: #ccc;
}
.eto-pc-content {
  padding: 25px;
}
.eto-pc-category {
  color: #d86828;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.1em;
  display: block;
  margin-bottom: 10px;
}
.eto-pc-title {
  font-size: 20px;
  font-weight: 600;
  margin: 0 0 5px;
  color: #111;
}
.eto-pc-location {
  font-size: 14px;
  color: #777;
  margin: 0 0 15px;
}
.eto-pc-link {
  color: #d86828;
  font-size: 14px;
  text-decoration: none;
  font-weight: 600;
}
.eto-pc-link:hover {
  text-decoration: underline;
}

/* BOTTOM SECTION (Beige) */
.eto-portfolios-bottom {
  background-color: #f3f1eb;
  padding: 60px 20px;
}
.eto-portfolios-accordion-wrap {
  max-width: 100%;
  padding: 0 40px;
  margin: 0 auto;
}
.eto-pa-title {
  text-align: center;
  font-size: 28px;
  font-weight: 600;
  margin: 0 0 40px;
  color: #111;
}
.eto-pa-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30px;
}
@media (max-width: 768px) {
  .eto-pa-grid {
    grid-template-columns: 1fr;
  }
}

/* ACCORDIONS */
.eto-accordion {
  background: #ffffff;
  border-radius: 6px;
  margin-bottom: 15px;
  box-shadow: 0 2px 5px rgba(0,0,0,0.02);
  overflow: hidden;
}
.eto-acc-summary {
  padding: 18px 20px;
  font-size: 15px;
  font-weight: 600;
  color: #333;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  list-style: none; /* Hide default triangle */
}
.eto-acc-summary::-webkit-details-marker {
  display: none;
}
.eto-acc-icon {
  width: 16px;
  height: 16px;
  position: relative;
}
.eto-acc-icon::before,
.eto-acc-icon::after {
  content: "";
  position: absolute;
  background: #333;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
.eto-acc-icon::before {
  width: 12px;
  height: 2px;
}
.eto-acc-icon::after {
  width: 2px;
  height: 12px;
  transition: transform 0.3s;
}
details[open] .eto-acc-icon::after {
  transform: translate(-50%, -50%) rotate(90deg);
}
.eto-acc-content {
  padding: 0 20px 20px;
}
.eto-acc-list {
  list-style: disc;
  padding-left: 20px;
  margin: 0 0 15px;
  font-size: 13px;
  color: #555;
  line-height: 1.6;
}
.eto-acc-list li {
  margin-bottom: 6px;
}
.eto-acc-link {
  color: #d86828;
  font-size: 13px;
  text-decoration: none;
}
.eto-acc-link:hover {
  text-decoration: underline;
}

@media screen and (min-width: 1921px) {
  .eto-portfolios-title { font-size: clamp(42px, 3vw, 84px); margin-bottom: clamp(15px, 1vw, 30px); }
  .eto-portfolios-subtitle { font-size: clamp(16px, 1.2vw, 32px); margin-bottom: clamp(30px, 2vw, 60px); }
  .eto-pf-btn { font-size: clamp(14px, 1vw, 28px); padding: clamp(8px, 0.6vw, 16px) clamp(20px, 1.5vw, 40px); }
  .eto-pa-title { font-size: clamp(28px, 2vw, 56px); margin-bottom: clamp(40px, 3vw, 80px); }
  .eto-acc-summary { font-size: clamp(15px, 1.1vw, 30px); padding: clamp(18px, 1.3vw, 36px) clamp(20px, 1.5vw, 40px); }
  .eto-acc-list { font-size: clamp(13px, 1vw, 26px); }
  .eto-acc-link, .eto-pc-link { font-size: clamp(14px, 1vw, 28px); }
  .eto-pc-category { font-size: clamp(12px, 0.9vw, 24px); }
  .eto-pc-title { font-size: clamp(20px, 1.5vw, 40px); }
  .eto-pc-location { font-size: clamp(14px, 1vw, 28px); }
}
</style>

{% schema %}
{
  "name": "Portfolios",
  "settings": [],
  "blocks": [
    {
      "type": "project",
      "name": "Project Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "category", "label": "Category", "default": "HOSPITALITY" },
        { "type": "text", "id": "title", "label": "Project Title", "default": "Project Name" },
        { "type": "text", "id": "location", "label": "Location", "default": "City, ST" },
        { "type": "url", "id": "link", "label": "Project Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Portfolios",
      "blocks": [
        { "type": "project", "settings": { "category": "HOSPITALITY", "title": "Hotel del Coronado", "location": "San Diego, CA" } },
        { "type": "project", "settings": { "category": "HOSPITALITY", "title": "Rosewood Hotels", "location": "Hospitality Portfolio" } },
        { "type": "project", "settings": { "category": "RESTAURANT", "title": "The Charcoal Grill", "location": "Los Angeles, CA" } }
      ]
    }
  ]
}
{% endschema %}

    window.scrollTo(0, 0);
  }

  document.addEventListener("DOMContentLoaded", function() {
    var urlParams = new URLSearchParams(window.location.search);
    var section = urlParams.get('section');
    
    if (section) {
        switch(section) {
            case 'impact':
                showEtoImpact();
                break;
            case 'fire':
            case 'certifications':
                showEtoFire();
                break;
            case 'green':
                showEtoGreen();
                break;
            case 'why-buy':
                showWhyBuy();
                break;
            case 'warranty':
                showEtoWarranty();
                break;
            case 'diy':
                showEtoDIY();
                break;
            case 'diy-videos':
                showEtoDIYVideos();
                break;
            case 'forms':
            case 'resources':
                showEtoForms();
                break;
            case 'brand':
            case 'history':
                showEtoBrand();
                break;
            case 'energy':
            case 'nfrc':
                showEtoEnergy();
                break;
            case 'fsc':
                showEtoFSC();
                break;
            case 'stc':
                showEtoSTC();
                break;
            case 'price-guarantee':
                showEtoPrice();
                break;
            case 'press':
                showEtoPress();
                break;
            case 'affiliations':
                showEtoAffiliations();
                break;
            case '3d-modeling':
                showEto3DModeling();
                break;
            case 'glass-options':
                showGlassOptions();
                break;
            default:
                break;
        }
    }

    var dateTrigger = document.getElementById('eto-date-picker-trigger');
    if (dateTrigger) {
      dateTrigger.addEventListener('change', function(e) {
        var dateVal = e.target.value; 
        if (dateVal) {
          var parts = dateVal.split('-'); // YYYY-MM-DD
          var yInput = document.querySelector('input[name="contact[date_yyyy]"]');
          var mInput = document.querySelector('input[name="contact[date_mm]"]');
          var dInput = document.querySelector('input[name="contact[date_dd]"]');
          
          if(yInput) yInput.value = parts[0];
          if(mInput) mInput.value = parts[1];
          if(dInput) dInput.value = parts[2];
        }
      });
    }
  });
</script>


{% comment %}
  ETO Doors - About Us Page Section
  Layout: 2 Columns (Sidebar | Main Content)
{% endcomment %}

{{ 'component-door-categories.css' | asset_url | stylesheet_tag }}

<style>
.eto-about-container {
  display: flex;
  flex-wrap: wrap;
  max-width: 1170px;
  margin: 0 auto;
  padding: 20px;
  gap: 30px;
}

/* Sidebar (Reused) */
.eto-about-sidebar {
  flex: 0 0 280px;
  max-width: 280px;
  display: none;
}

@media (min-width: 990px) {
  .eto-about-sidebar {
    display: block;
  }
}

/* Main Content */
.eto-about-main {
  flex: 1;
  min-width: 0;
}

/* Breadcrumbs */
.eto-breadcrumb-container {
  max-width: var(--eto-container-max);
  margin: 0 auto;
  padding: 15px 20px 0;
}
.eto-breadcrumb {
  font-size: 13px;
  color: #333;
  font-weight: 700;
}
.eto-breadcrumb a { text-decoration: none; color: #333; }
.eto-breadcrumb span { margin: 0 5px; color: #999; }

/* About Page Specific Styles */

/* Hero Section */
.eto-about-hero {
  position: relative;
  width: 100%;
  height: 380px;
  margin-bottom: 20px;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
}
.eto-about-hero-text {
  text-align: right;
  padding: 40px;
  color: #fff;
  text-shadow: 2px 2px 5px rgba(0,0,0,0.8);
}
.eto-about-hero-text h2 {
  font-size: 34px;
  font-weight: 800;
  margin: 0;
  text-transform: uppercase;
  color: #fff;
  line-height: 1.1;
  letter-spacing: 1px;
}

/* 3 Column Grid */
.eto-about-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  margin-bottom: 40px;
}
.eto-about-col {
  flex: 1;
  min-width: 250px;
}
.eto-about-img {
  width: 100%;
  height: 180px;
  object-fit: cover;
  margin-bottom: 12px;
}
.eto-about-title {
  color: #000000;
  font-size: 15px;
  font-weight: 800; /* Extra bold */
  text-transform: uppercase;
  margin-bottom: 8px;
}
.eto-about-desc {
  font-size: 13px;
  color: #333;
  line-height: 1.5;
  margin-bottom: 8px;
}
.eto-read-more {
  font-size: 16px; /* Increased from 13px */
  color: #222;
  font-weight: 800; /* Bold link */
  text-decoration: underline;
  display: inline-block;
  margin-top: 5px;
}

/* Text Content */
.eto-text-section {
  margin-bottom: 40px;
}
.eto-section-title {
  color: #000000;
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 15px;
}
.eto-text-p {
  font-size: 13px;
  color: #555;
  line-height: 1.6;
  margin-bottom: 15px;
}

/* Testimonial Form */
.eto-testimonial-form {
  border-top: 1px dashed #ccc;
  padding-top: 30px;
}
.eto-form-label {
  display: block;
  font-weight: 700;
  font-size: 13px;
  margin-bottom: 5px;
  color: #333;
}
.eto-form-label span { color: red; }
.eto-form-input {
  width: 100%;
  padding: 8px;
  border: 1px solid #ccc;
  margin-bottom: 15px;
  font-size: 14px;
}
.eto-form-textarea {
  width: 100%;
  height: 100px;
  padding: 8px;
  border: 1px solid #ccc;
  margin-bottom: 15px;
  font-size: 14px;
}
.eto-date-group {
  display: flex;
  align-items: flex-start;
  gap: 5px;
  margin-bottom: 15px;
}
.eto-date-block {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.eto-date-input {
  width: 35px;
  padding: 4px;
  border: 1px solid #ccc;
  font-size: 13px;
  text-align: center;
}
.eto-date-sub {
  font-size: 10px;
  color: #444;
  margin-top: 2px;
}
.eto-date-slash {
  padding-top: 5px;
  color: #444;
  font-weight: bold;
}
.eto-date-icon {
  padding-top: 3px;
  margin-left: 3px;
}
.eto-rating-group {
  margin-bottom: 20px;
}
.eto-radio-label {
  display: block;
  font-size: 13px;
  margin-bottom: 6px;
  cursor: pointer;
}
.eto-radio-label input { margin-right: 8px; }

.eto-submit-btn {
  background: #000000;
  border: 1px solid #000000;
  padding: 10px 25px;
  font-size: 14px;
  color: #fff;
  cursor: pointer;
  border-radius: 2px;
  font-weight: 700;
  text-transform: uppercase;
  transition: all 0.3s ease;
  appearance: none;
  -webkit-appearance: none;
}
.eto-submit-btn:hover {
  background: #333333;
  border-color: #333333;
}

@media screen and (min-width: 1921px) {
  .eto-about-container { max-width: 85vw !important; padding: clamp(20px, 2vw, 40px) !important; }
  .eto-breadcrumb-container { max-width: 85vw !important; padding: clamp(15px, 1.5vw, 30px) 2vw 0 !important; }
  .eto-breadcrumb { font-size: clamp(13px, 1.2vw, 26px); }
  
  .eto-about-hero { height: clamp(380px, 30vw, 1200px) !important; }
  .eto-about-hero-text h2 { font-size: clamp(34px, 3vw, 68px); }
  
  .eto-about-img { height: clamp(180px, 15vw, 600px) !important; }
  .eto-about-title { font-size: clamp(15px, 1.4vw, 30px); }
  .eto-about-desc { font-size: clamp(13px, 1.2vw, 26px); }
  .eto-read-more { font-size: clamp(16px, 1.5vw, 32px); }
  
  .eto-section-title { font-size: clamp(20px, 1.8vw, 40px); }
  .eto-text-p { font-size: clamp(13px, 1.2vw, 26px); }
  
  .eto-form-label { font-size: clamp(13px, 1.2vw, 26px); margin-bottom: clamp(5px, 0.5vw, 10px); }
  .eto-form-input, .eto-form-textarea { 
    padding: clamp(8px, 0.8vw, 16px) !important; 
    font-size: clamp(14px, 1.3vw, 28px) !important; 
  }
  .eto-date-input { width: clamp(35px, 3.5vw, 70px) !important; padding: clamp(4px, 0.4vw, 8px) !important; font-size: clamp(13px, 1.2vw, 26px) !important; }
  .eto-date-sub { font-size: clamp(10px, 0.9vw, 20px); }
  
  .eto-radio-label { font-size: clamp(13px, 1.2vw, 26px); }
  
  .eto-submit-btn { 
    padding: clamp(10px, 1vw, 20px) clamp(25px, 2.5vw, 50px) !important; 
    font-size: clamp(14px, 1.3vw, 28px) !important; 
  }

  /* Scale text for hidden tabs (Impact, Brand, Price Guarantee, etc) */
  #eto-about-default-content h2, #eto-about-default-content h3, #eto-impact-content h2, #eto-impact-content h3, #eto-brand-content h3, #eto-price-guarantee-content h2, #eto-price-guarantee-content h3, #eto-press-content h3, #eto-forms-content h3, #eto-warranty-content h3, #eto-diy-videos-content h2, #eto-diy-videos-content h3, #eto-3d-modeling-content h2, #eto-3d-modeling-content h3 { font-size: clamp(16px, 1.6vw, 32px) !important; margin-bottom: clamp(5px, 0.5vw, 10px) !important; }
  
  #eto-impact-content div, #eto-impact-content strong, #eto-forms-content ul, #eto-warranty-content div, #eto-3d-modeling-content p, #eto-3d-modeling-content div, #eto-3d-modeling-content a { font-size: clamp(13px, 1.3vw, 26px) !important; line-height: 1.6; }
}
</style>


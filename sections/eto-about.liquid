{% comment %}
  ETO Doors - About Us Page Section
  Layout: 2 Columns (Sidebar | Main Content)
{% endcomment %}

{{ 'component-door-categories.css' | asset_url | stylesheet_tag }}

<style>
.eto-about-container {
  display: flex;
  flex-wrap: wrap;
  max-width: 1170px;
  margin: 0 auto;
  padding: 20px;
  gap: 30px;
}

/* Sidebar (Reused) */
.eto-about-sidebar {
  flex: 0 0 280px;
  max-width: 280px;
  display: none;
}

@media (min-width: 990px) {
  .eto-about-sidebar {
    display: block;
  }
}

/* Main Content */
.eto-about-main {
  flex: 1;
  min-width: 0;
}

/* Breadcrumbs */
.eto-breadcrumb-container {
  max-width: var(--eto-container-max);
  margin: 0 auto;
  padding: 15px 20px 0;
}
.eto-breadcrumb {
  font-size: 13px;
  color: #333;
  font-weight: 700;
}
.eto-breadcrumb a { text-decoration: none; color: #333; }
.eto-breadcrumb span { margin: 0 5px; color: #999; }

/* About Page Specific Styles */

/* Hero Section */
.eto-about-hero {
  position: relative;
  width: 100%;
  height: 380px;
  margin-bottom: 20px;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
}
.eto-about-hero-text {
  text-align: right;
  padding: 40px;
  color: #fff;
  text-shadow: 2px 2px 5px rgba(0,0,0,0.8);
}
.eto-about-hero-text h2 {
  font-size: 34px;
  font-weight: 800;
  margin: 0;
  text-transform: uppercase;
  color: #fff;
  line-height: 1.1;
  letter-spacing: 1px;
}

/* 3 Column Grid */
.eto-about-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  margin-bottom: 40px;
}
.eto-about-col {
  flex: 1;
  min-width: 250px;
}
.eto-about-img {
  width: 100%;
  height: 180px;
  object-fit: cover;
  margin-bottom: 12px;
}
.eto-about-title {
  color: #000000;
  font-size: 15px;
  font-weight: 800; /* Extra bold */
  text-transform: uppercase;
  margin-bottom: 8px;
}
.eto-about-desc {
  font-size: 13px;
  color: #333;
  line-height: 1.5;
  margin-bottom: 8px;
}
.eto-read-more {
  font-size: 16px; /* Increased from 13px */
  color: #222;
  font-weight: 800; /* Bold link */
  text-decoration: underline;
  display: inline-block;
  margin-top: 5px;
}
.eto-col-highlight {
  font-size: 13px;
  color: #DAA520; /* Goldenrod color */
  font-weight: 600;
  margin-top: 5px;
}

/* Text Content */
.eto-text-section {
  margin-bottom: 40px;
}
.eto-section-title {
  color: #000000;
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 15px;
}
.eto-text-p {
  font-size: 13px;
  color: #555;
  line-height: 1.6;
  margin-bottom: 15px;
}

/* Testimonial Form */
.eto-testimonial-form {
  border-top: 1px dashed #ccc;
  padding-top: 30px;
}
.eto-form-label {
  display: block;
  font-weight: 700;
  font-size: 13px;
  margin-bottom: 5px;
  color: #333;
}
.eto-form-label span { color: red; }
.eto-form-input {
  width: 100%;
  padding: 8px;
  border: 1px solid #ccc;
  margin-bottom: 15px;
  font-size: 14px;
}
.eto-form-textarea {
  width: 100%;
  height: 100px;
  padding: 8px;
  border: 1px solid #ccc;
  margin-bottom: 15px;
  font-size: 14px;
}
.eto-date-group {
  display: flex;
  align-items: flex-start;
  gap: 5px;
  margin-bottom: 15px;
}
.eto-date-block {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.eto-date-input {
  width: 35px;
  padding: 4px;
  border: 1px solid #ccc;
  font-size: 13px;
  text-align: center;
}
.eto-date-sub {
  font-size: 10px;
  color: #444;
  margin-top: 2px;
}
.eto-date-slash {
  padding-top: 5px;
  color: #444;
  font-weight: bold;
}
.eto-date-icon {
  padding-top: 3px;
  margin-left: 3px;
}
.eto-rating-group {
  margin-bottom: 20px;
}
.eto-radio-label {
  display: block;
  font-size: 13px;
  margin-bottom: 6px;
  cursor: pointer;
}
.eto-radio-label input { margin-right: 8px; }

.eto-submit-btn {
  background: #000000;
  border: 1px solid #000000;
  padding: 10px 25px;
  font-size: 14px;
  color: #fff;
  cursor: pointer;
  border-radius: 2px;
  font-weight: 700;
  text-transform: uppercase;
  transition: all 0.3s ease;
  appearance: none;
  -webkit-appearance: none;
}
.eto-submit-btn:hover {
  background: #333333;
  border-color: #333333;
}

</style>


    <script>
      (function() {
        // Elements
        var btnOpenCats = document.getElementById('BtnDoorCatsMobile');
        var btnCloseCats = document.getElementById('BtnCloseDoorCats');
        var drawerCats = document.getElementById('DrawerDoorCatsMobile');
        
        var btnOpenShop = document.getElementById('BtnShopByMobile');
        var btnCloseShop = document.getElementById('BtnCloseShopBy');
        var drawerShop = document.getElementById('DrawerShopByMobile');
        
        function openDrawer(drawer) {
          if(!drawer) return;
          var panel = drawer.querySelector('.custom-drawer-panel');
          drawer.style.display = 'block';
          drawer.offsetHeight; // reflow
          panel.style.transform = 'translateY(0)';
          document.body.classList.add('overflow-hidden-mobile');
        }
        
        function closeDrawer(drawer) {
          if(!drawer) return;
          var panel = drawer.querySelector('.custom-drawer-panel');
          panel.style.transform = 'translateY(100%)';
          setTimeout(function() {
            drawer.style.display = 'none';
            // Only remove overflow-hidden if NO drawers are open
            // but for simplicity we assume one at a time.
            document.body.classList.remove('overflow-hidden-mobile');
          }, 300);
        }
        
        // Listeners for Cats
        if(btnOpenCats && drawerCats) {
          btnOpenCats.addEventListener('click', function(e) { e.preventDefault(); e.stopPropagation(); openDrawer(drawerCats); });
          btnCloseCats.addEventListener('click', function(e) { e.preventDefault(); e.stopPropagation(); closeDrawer(drawerCats); });
          drawerCats.addEventListener('click', function(e) { if(e.target === drawerCats) closeDrawer(drawerCats); });
        }
        
        // Listeners for Shop By
        if(btnOpenShop && drawerShop) {
          btnOpenShop.addEventListener('click', function(e) { e.preventDefault(); e.stopPropagation(); openDrawer(drawerShop); });
          btnCloseShop.addEventListener('click', function(e) { e.preventDefault(); e.stopPropagation(); closeDrawer(drawerShop); });
          drawerShop.addEventListener('click', function(e) { if(e.target === drawerShop) closeDrawer(drawerShop); });
        }
      })();
    </script>


{% comment %}
  Renders a product card in List View
  Usage: {% render 'card-product-list', card_product: product %}
{% endcomment %}

<div class="product-list-view-item">
    <div class="product-list-image">
      <a href="{{ card_product.url }}" style="display: block;">
        <img
          src="{{ card_product.featured_media | image_url: width: 80 }}"
          alt="{{ card_product.featured_media.alt | escape }}"
          loading="lazy"
          width="80"
          height="{{ 80 | divided_by: card_product.featured_media.aspect_ratio | ceil }}"
        >
      </a>
    </div>
    <div class="product-list-details">
        <a href="{{ card_product.url }}" class="product-list-title">
            {{ card_product.title | append: ' (1-3/4")' | strip }} <!-- Appending random dimension stub to match image or use metafield if available later -->
        </a>

        <div class="product-list-price-box">
            {%- if card_product.compare_at_price > card_product.price -%}
              <span class="list-price">
                List Price: {{ card_product.compare_at_price | money }}
              </span>
            {%- else -%}
              <!-- Stub logic to simulate a "List Price" if none exists, purely for visual matching if requested, otherwise standard -->
              <span class="list-price">
                  List Price: {{ card_product.price | times: 1.2 | money }}
              </span>
            {%- endif -%}
            
            <div style="margin-top: 2px;">
                Price For Door Only: 
                <span class="special-price">
                  {{ card_product.price | money }}
                </span>
            </div>
        </div>

        <a href="{{ card_product.url }}" class="product-list-learn-more">
            Learn More
        </a>
    </div>
</div>
